{{#section 'head'}}
<title>Edit Profile | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/profileEdit.css">
{{/section}}


<div class="container" style="margin-top:20px;">
    <div class="profile-header">

    </div>

    <div class="profile-container">
        <div class="profile-sidebar">
            <ul>
                <li onclick="location.href='/user/profile'">
                    <i class="fas fa-user"></i> Profile
                </li>
                <li onclick="location.href='/user/security'">
                    <i class="fas fa-lock"></i> Security & Password
                </li>
                <li onclick="location.href='/user/wallet'">
                    <i class="fas fa-wallet"></i> Wallet
                </li>
                <li onclick="location.href='/user/orders'">
                    <i class="fas fa-shopping-bag"></i> Orders
                </li>
                <li onclick="location.href='/user/orders?retryPendingOrder=true'">
                    <i class="fas fa-shopping-bag"></i> Pending Orders
                </li>
                <li onclick="location.href='/user/address'">
                    <i class="fas fa-map-marker-alt"></i> Addresses
                </li>
                <li onclick="location.href='/user/deleteuser'">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </li>

            </ul>
        </div>

        <div class="profile-content">
            <h2 class="profile-section-title">Personal Information</h2>

            <!-- Profile Picture Upload -->
            {{!-- <div class="profile-picture-upload">
                <div class="profile-picture-container">
                    <img src="{{#if userData.profileImage}}{{userData.profileImage}}{{else}}https://via.placeholder.com/100{{/if}}"
                        alt="Profile Picture" class="profile-picture" id="profilePicturePreview">
                    <div class="profile-picture-edit" id="uploadTrigger">
                        <i class="fas fa-camera"></i>
                    </div>
                    <input type="file" id="profileImageUpload" accept="image/*" style="display: none;">
                </div>
                <div class="upload-instructions">
                    <p>Upload a clear photo of yourself for your profile.</p>
                    <p>Max file size: 2MB (JPG, PNG)</p>
                </div>
            </div> --}}

            <!-- Edit Form -->
            <form class="profile-edit-form" action="/user/profileedit" method="POST" id="profileEditForm">
                <div class="form-group">
                    <label for="full-name">Full Name</label>
                    <input type="text" class="form-control" id="full-name" name="name" value="{{userData.name}}"
                        required>
                    <div class="error-message" id="nameError"></div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email" value="{{userData.email}}"
                        readonly>
                    <div class="error-message" id="emailError"></div>
                </div>

                <div class="form-group">
                    <label for="mobile-number">Mobile Number</label>
                    <input type="tel" class="form-control" id="mobile-number" name="phone" value="{{userData.phone}}">
                    <div class="error-message" id="phoneError"></div>
                </div>

                <div class="form-group">
                    <label for="gender">Gender</label>
                    <select class="form-control form-select" id="gender" name="gender">
                        <option value="" disabled>Select Gender</option>
                        <option value="MALE" {{#ifCond userData.gender '===' 'MALE' }}selected{{/ifCond}}>Male
                        </option>
                        <option value="FEMALE" {{#ifCond userData.gender '===' 'FEMALE' }}selected{{/ifCond}}>Female
                        </option>
                        <option value="OTHER" {{#ifCond userData.gender '===' 'OTHER' }}selected{{/ifCond}}>Other
                        </option>
                    </select>
                    <div class="error-message" id="genderError"></div>
                </div>

                <div class="form-group">
                    <label for="dob">Date of Birth</label>
                    <input type="date" class="form-control" id="dob" name="dateOfBirth"
                        value="{{formatDate userData.dateOfBirth 'YYYY-MM-DD'}}">
                    <div class="error-message" id="dobError"></div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <button type="button" class="btn btn-outline" onclick="location.href='/user/profile'">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


{{#section 'scripts'}}
<script src="/javascripts/user/profileEdit.js" defer></script>
{{/section}}