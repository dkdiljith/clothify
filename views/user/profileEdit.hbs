<!-- Edit Form -->
<form class="profile-edit-form" action="/user/profileedit" method="POST" id="profileEditForm">
    <div class="form-group">
        <label for="full-name">Full Name</label>
        <input type="text" class="form-control" id="full-name" name="name" value="{{userData.name}}" required>
        <div class="error-message" id="nameError"></div>
    </div>

    <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" class="form-control" id="email" name="email" value="{{userData.email}}" readonly>
        <div class="error-message" id="emailError"></div>
    </div>

    <div class="form-group">
        <label for="mobile-number">Mobile Number</label>
        <input type="tel" class="form-control" id="mobile-number" name="phone" value="{{userData.phone}}">
        <div class="error-message" id="phoneError"></div>
    </div>

    <div class="form-group">
        <label for="gender">Gender</label>
        <select class="form-control form-select" id="gender" name="gender">
            <option value="" disabled>Select Gender</option>
            <option value="MALE" {{#ifCond userData.gender '===' 'MALE' }}selected{{/ifCond}}>Male
            </option>
            <option value="FEMALE" {{#ifCond userData.gender '===' 'FEMALE' }}selected{{/ifCond}}>Female
            </option>
            <option value="OTHER" {{#ifCond userData.gender '===' 'OTHER' }}selected{{/ifCond}}>Other
            </option>
        </select>
        <div class="error-message" id="genderError"></div>
    </div>

    <div class="form-group">
        <label for="dob">Date of Birth</label>
        <input type="date" class="form-control" id="dob" name="dateOfBirth"
            value="{{formatDate userData.dateOfBirth 'YYYY-MM-DD'}}">
        <div class="error-message" id="dobError"></div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <button type="button" class="btn btn-outline" onclick="location.href='/user/profile'">
            <i class="fas fa-times"></i> Cancel
        </button>
    </div>
</form>


{{#section 'scripts'}}
<script src="/javascripts/user/profileEdit.js" defer></script>
{{/section}}