{{#section 'head'}}
<title>Order Details | Clothify</title>
<link rel="stylesheet" href="/stylesheets/user/orderDetails.css">
{{/section}}
<div class="order-details-page">
    <!-- ========================= -->
    <!-- PAGE HEADER -->
    <!-- ========================= -->
    <div class="page-header">
        <a href="/user/orders" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Back to Orders
        </a>
        <div class="header-main">
            <div>
                <h2 class="page-title">
                    Order #{{order.orderId}}
                </h2>
                <p class="order-date">
                    Ordered on
                    {{formatDate order.createdAt "MMMM D, YYYY • hh:mm A"}}
                </p>
            </div>
            <div class="header-status">
                <span class="delivery-status status-{{toLowerCase order.deliveryStatus}}">
                    <svg xmlns="http://w3.org" viewBox="0 0 16 16" width="16" height="16">
                        <!-- Small-scale fast delivery truck -->
                        <path d="M1 4h7v6H1V4zm7 2h3.5L14 8.5V10H8V6z" fill="none" stroke="#0F172A" stroke-width="1.25"
                            stroke-linejoin="round" />
                        <path d="M10 6.5H12.5L13.5 8H10V6.5z" fill="#38BDF8" opacity="0.3" />
                        <circle cx="3.5" cy="12.5" r="1.25" fill="#0F172A" />
                        <circle cx="10.5" cy="12.5" r="1.25" fill="#0F172A" />
                        <path d="M1 11h1M13 11h2" stroke="#0F172A" stroke-width="1.25" stroke-linecap="round" />
                    </svg>
                    Delivery
                    {{order.deliveryStatus}}
                </span>
                <span class="payment-status payment-{{toLowerCase order.paymentStatus}}">
                    <svg xmlns="http://w3.org" viewBox="0 0 16 16" width="16" height="16">
                        <!-- Small-scale cash banknote with success check -->
                        <rect x="1" y="3.5" width="14" height="9" rx="1.5" fill="none" stroke="#0F172A"
                            stroke-width="1.25" />
                        <circle cx="8" cy="8" r="2" fill="none" stroke="#10B981" stroke-width="1.25" />
                        <circle cx="3.5" cy="8" r="0.75" fill="#0F172A" />
                        <circle cx="12.5" cy="8" r="0.75" fill="#0F172A" />
                        <!-- Status indicator badge -->
                        <circle cx="12.5" cy="3.5" r="2.25" fill="#10B981" />
                        <path d="M11.5 3.5l.5.5 1-1" fill="none" stroke="#FFFFFF" stroke-width="0.75"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Payment
                    {{order.paymentStatus}}
                </span>
                <div class="header-actions">
                    {{#ifeq order.paymentStatus "Failed"}}
                    <button class="btn btn-primary btn-retry-payment" data-order-id="{{order.orderId}}"
                        data-expires-at="{{order.paymentRetryExpiresAt}}"
                        data-attempts-count="{{order.paymentAttemptsCount}}">
                        <i class="fas fa-lock"></i>
                        Retry Payment
                    </button>
                    {{else}}
                    <button id="download-invoice-button" class="btn btn-secondary" data-order-id="{{order._id}}"
                        {{#ifEquals order.totalAmount 0}}disabled{{/ifEquals}}>
                        <i class="fas fa-file-download"></i>
                        Download Invoice
                    </button>
                    {{/ifeq}}
                </div>
            </div>
        </div>
    </div>
    <!-- ========================= -->
    <!-- QUICK OVERVIEW -->
    <!-- ========================= -->
    <div class="overview-grid">
        <div class="overview-card">
            <div class="overview-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <div>
                <small>Payment Method</small>
                <h4 style="text-transform:capitalize;">
                    {{paymentMethod order.paymentMethod}}
                </h4>
            </div>
        </div>
        <div class="overview-card">
            <div class="overview-icon">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <div>
                <small>Total Amount</small>
                <h4>
                    ₹{{order.totalAmount}}
                </h4>
            </div>
        </div>
        <div class="overview-card">
            <div class="overview-icon">
                <i class="fas fa-box"></i>
            </div>
            <div>
                <small>Total Items</small>
                <h4>
                    {{order.items.length}}
                </h4>
            </div>
        </div>
        <div class="overview-card">
            <div class="overview-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <small>Payment Status</small>
                <h4>
                    {{order.paymentStatus}}
                </h4>
            </div>
        </div>
    </div>
    <!-- ========================= -->
    <!-- ORDER ITEMS -->
    <!-- ========================= -->
    <div class="card-section">
        <div class="section-title">
            <i class="fas fa-box-open"></i>
            Ordered Items
        </div>
        <div class="ordered-items">
            {{#each order.items}}
            <div class="ordered-item">
                <div class="item-image">
                    <img src="{{this.productImg}}" alt="{{this.productName}}">
                </div>
                <div class="item-content">
                    <h4>
                        {{this.productName}}
                    </h4>
                    <div class="item-meta">
                        <span>
                            <strong>Size</strong>
                            {{this.productSize}}
                        </span>
                        <span>
                            <strong>Qty</strong>
                            {{this.quantity}}
                        </span>
                    </div>
                    <div class="item-price">
                        ₹{{this.productPrice}}
                        ×
                        {{this.quantity}}
                    </div>
                </div>
                <div class="item-right">
                    <span class="status-badge status-{{toLowerCase this.status}}">
                        {{this.status}}
                    </span>
                    <div class="item-total">
                       ₹{{formatPrice (multiply this.productPrice this.quantity)}}
                    </div>
                    <div class="item-actions">
                        {{!-- Pending --}}
                        {{#ifeq this.status "Pending"}}
                        <button class="btn btn-outline-danger cancel-item-btn" data-order-id="{{../order._id}}"
                            data-item-id="{{this._id}}" data-variation-index="{{this.variationIndex}}">
                            Cancel
                        </button>
                        {{/ifeq}}
                        {{!-- Completed --}}
                        {{#ifeq this.status "Completed"}}
                        <button class="btn btn-outline-primary return-item-btn" data-order-id="{{../order._id}}"
                            data-item-id="{{this._id}}">
                            Return
                        </button>
                        {{/ifeq}}
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    <!-- ========================= -->
    <!-- SHIPPING ADDRESS -->
    <!-- ========================= -->
    <div class="card-section">
        <div class="section-title">
            <i class="fas fa-map-marker-alt"></i>
            Shipping Address
        </div>
        <div class="address-card">
            <h4>
                {{order.deliveryAddress.name}}
            </h4>
            <p>
                {{order.deliveryAddress.streetAddress}}
            </p>
            {{#if order.deliveryAddress.landmark}}
            <p>
                Landmark :
                {{order.deliveryAddress.landmark}}
            </p>
            {{/if}}
            <p>
                {{order.deliveryAddress.city}},
                {{order.deliveryAddress.state}}
                -
                {{order.deliveryAddress.zip}}
            </p>
            <p>
                {{order.deliveryAddress.country}}
            </p>
            <p>
                <strong>
                    Phone
                </strong>
                :
                {{order.deliveryAddress.phone}}
            </p>
        </div>
    </div>
    <!-- ========================= -->
    <!-- PAYMENT SUMMARY -->
    <!-- ========================= -->
    <div class="card-section">
        <div class="section-title">
            <i class="fas fa-file-invoice-dollar"></i>
            Payment Summary
        </div>
        <div class="summary-table">
            <div class="summary-row">
                <span>Subtotal</span>
                <strong>₹{{order.subtotal}}</strong>
            </div>
            <div class="summary-row">
                <span>Shipping Fee</span>
                {{#ifEquals order.shippingFee 0}}
                <strong class="text-success">
                    FREE
                </strong>
                {{else}}
                <strong>
                    ₹{{order.shippingFee}}
                </strong>
                {{/ifEquals}}
            </div>
            <div class="summary-row">
                <span>Tax</span>
                <strong>
                    ₹{{order.tax}}
                </strong>
            </div>
            {{#if order.couponDiscount}}
            <div class="summary-row discount">
                <span>
                    Coupon Discount
                </span>
                <strong>
                    - ₹{{order.couponDiscount}}
                </strong>
            </div>
            {{/if}}
            {{#if order.offerDiscount}}
            <div class="summary-row discount">
                <span>
                    Offer Discount
                </span>
                <strong>
                    - ₹{{order.offerDiscount}}
                </strong>
            </div>
            {{/if}}
            <hr>
            <div class="summary-row">
                <span>
                    Checkout Total
                </span>
                <strong>
                    ₹{{order.checkoutTotal}}
                </strong>
            </div>
            {{#if order.totalRefundAmount}}
            <div class="summary-row refund">
                <span>
                    Total Refund
                </span>
                <strong>
                    - ₹{{order.totalRefundAmount}}
                </strong>
            </div>
            {{/if}}
            <hr>
            <div class="summary-row grand-total">
                <span>
                    Final Amount
                </span>
                <strong>
                    ₹{{order.totalAmount}}
                </strong>
            </div>
        </div>
    </div>
    <!-- ========================= -->
    <!-- REFUND DETAILS -->
    <!-- ========================= -->
    {{#if order.totalRefundAmount}}
    <div class="card-section">
        <div class="section-title refund-toggle">
            <div class="refund-title">
                <i class="fas fa-wallet"></i>
                <span>Refund Details</span>
            </div>
            <div class="refund-summary">
                ₹{{order.totalRefundAmount}} Refunded
                <i class="fas fa-chevron-down refund-arrow"></i>
            </div>
        </div>
        <div class="refund-content">
            <div class="refund-list">
                {{#each order.items}}
                {{#if this.refundDetails.refundType}}
                <div class="refund-card">
                    <div class="refund-product-info">
                        <h5 class="refund-product-name">
                            {{this.productName}}
                        </h5>
                        <div class="refund-product-meta">
                            <span>
                                <strong>Size:</strong>
                                {{this.productSize}}
                            </span>
                            <span>
                                <strong>Qty:</strong>
                                {{this.quantity}}
                            </span>
                        </div>
                        <small class="refund-type">
                            {{this.refundDetails.refundType}}
                        </small>
                    </div>
                    <div class="refund-amount">
                        <strong>
                            ₹{{this.refundDetails.refundAmount}}
                        </strong>
                    </div>
                </div>
                <div class="refund-grid">
                    <div>
                        <span>Status</span>
                        <strong>
                            {{this.refundDetails.refundAmountStatus}}
                        </strong>
                    </div>
                    <div>
                        <span>Reason</span>
                        <strong>
                            {{this.refundDetails.refundReason}}
                        </strong>
                    </div>
                    {{#if this.refundDetails.refundedAt}}
                    <div>
                        <span>Refunded On</span>
                        <strong>
                            {{formatDate this.refundDetails.refundedAt}}
                        </strong>
                    </div>
                    {{/if}}
                </div>
                {{#unless @last}}
                <hr>
                {{/unless}}
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}
    <!-- ========================= -->
    <!-- ORDER ACTIONS -->
    <!-- ========================= -->
    <div class="order-actions">
        <a href="/user/orders" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i>
            Back to Orders
        </a>
    </div>
    <!-- ========================= -->
    <!-- CANCEL MODAL -->
    <!-- ========================= -->
    <div id="cancel-order-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>
                    Cancel Item
                </h3>
                <button class="close-modal">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <textarea id="cancellation-reason" placeholder="Tell us why you're cancelling this item..."></textarea>
            </div>
            <div class="modal-footer">
                <button id="cancel-modal-button" class="btn btn-outline">
                    Close
                </button>
                <button id="submit-cancellation" class="btn btn-danger">
                    Submit
                </button>
            </div>
        </div>
    </div>
    <!-- ========================= -->
    <!-- RETURN MODAL -->
    <!-- ========================= -->
    <div id="return-order-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>
                    Return Item
                </h3>
                <button class="close-modal">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <textarea id="return-reason" placeholder="Tell us why you're returning this item..."></textarea>
                <div id="return-reason-error" class="validation-error">
                    Please enter a return reason.
                </div>
            </div>
            <div class="modal-footer">
                <button id="cancel-return-modal-button" class="btn btn-outline">
                    Close
                </button>
                <button id="submit-return" class="btn btn-primary">
                    Submit
                </button>
            </div>
        </div>
    </div>
    <!-- ========================= -->
    <!-- SUCCESS POPUP -->
    <!-- ========================= -->
    <div id="success-message" class="success-message">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="success-text">
            Success
        </div>
        <button id="close-success-message" class="btn btn-primary">
            OK
        </button>
    </div>
</div>
{{#section 'scripts'}}
<script src="/javascripts/user/orderDetails.js" defer></script>
{{/section}}