<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | Clothify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --success-color: #2ecc71;
            --light-gray: #f8f9fa;
            --medium-gray: #e0e0e0;
            --dark-gray: #333;
            --white: #ffffff;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            color: var(--dark-gray);
            background-color: var(--light-gray);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .profile-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
        }

        .profile-container {
            display: flex;
            gap: 30px;
            background-color: var(--white);
            border-radius: 8px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .profile-sidebar {
            width: 250px;
            background-color: #f8f9fa;
            padding: 25px 0;
        }

        .profile-sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .profile-sidebar li {
            padding: 12px 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
        }

        .profile-sidebar li:hover {
            background-color: rgba(52, 152, 219, 0.1);
            color: var(--secondary-color);
        }

        .profile-sidebar li.active {
            background-color: rgba(52, 152, 219, 0.1);
            border-left: 3px solid var(--secondary-color);
            color: var(--secondary-color);
            font-weight: 500;
        }

        .profile-sidebar li i {
            width: 20px;
            text-align: center;
        }

        .profile-content {
            flex: 1;
            padding: 30px;
        }

        /* Order Details Styles */
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .order-title {
            font-size: 22px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .order-number {
            font-size: 16px;
            color: #666;
        }

        .order-status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
        }

        .status-completed {
            background-color: rgba(46, 204, 113, 0.1);
            color: var(--success-color);
        }

        .status-pending {
            background-color: rgba(241, 196, 15, 0.1);
            color: #f1c40f;
        }

        .status-cancelled {
            background-color: rgba(231, 76, 60, 0.1);
            color: var(--accent-color);
        }

        .status-returned {
            background-color: rgba(155, 89, 182, 0.1);
            color: #9b59b6;
        }

        .status-shipped {
            background-color: rgba(52, 152, 219, 0.1);
            color: var(--secondary-color);
        }

        .order-card {
            background-color: var(--white);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .order-card-header {
            padding: 15px 20px;
            background-color: var(--light-gray);
            border-bottom: 1px solid var(--medium-gray);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-card-title {
            font-weight: 600;
            color: var(--primary-color);
        }

        .order-item {
            display: flex;
            padding: 20px;
            border-bottom: 1px solid var(--light-gray);
        }

        .order-item:last-child {
            border-bottom: none;
        }

        .order-item-image {
            width: 100px;
            height: 100px;
            border-radius: 6px;
            overflow: hidden;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .order-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .order-item-details {
            flex: 1;
        }

        .order-item-name {
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--primary-color);
        }

        .order-item-attributes {
            display: flex;
            gap: 15px;
            margin-bottom: 8px;
            font-size: 14px;
            color: #666;
        }

        .order-item-price {
            font-weight: 500;
            color: var(--dark-gray);
        }

        .order-item-status {
            margin-top: 10px;
            font-size: 14px;
        }

        .status-text {
            font-weight: 500;
        }

        .delivery-address-card {
            margin-top: 20px;
        }

        .address-details {
            padding: 20px;
        }

        .address-details p {
            margin: 5px 0;
            line-height: 1.6;
        }

        .price-details-card {
            margin-top: 20px;
        }

        .price-summary {
            padding: 20px;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .price-label {
            color: #666;
        }

        .price-value {
            font-weight: 500;
        }

        .total-price {
            border-top: 1px solid var(--medium-gray);
            padding-top: 15px;
            margin-top: 15px;
            font-weight: 600;
        }

        .payment-method {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid var(--medium-gray);
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            gap: 8px;
            font-size: 15px;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #2980b9;
        }

        .btn-danger {
            background-color: var(--accent-color);
            color: white;
        }

        .btn-danger:hover {
            background-color: #c0392b;
        }

        .btn-secondary {
            background-color: var(--medium-gray);
            color: var(--dark-gray);
        }

        .btn-secondary:hover {
            background-color: #bdc3c7;
        }

        .btn:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
            opacity: 0.7;
        }

        .other-items-card {
            margin-top: 20px;
        }

        .other-item {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            border-bottom: 1px solid var(--light-gray);
            text-decoration: none;
            color: inherit;
            transition: background-color 0.2s;
        }

        .other-item:hover {
            background-color: rgba(52, 152, 219, 0.05);
        }

        .other-item:last-child {
            border-bottom: none;
        }

        .other-item-image {
            width: 60px;
            height: 60px;
            border-radius: 4px;
            overflow: hidden;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .other-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .other-item-name {
            flex: 1;
            font-size: 15px;
        }

        .other-item-arrow {
            color: var(--secondary-color);
            font-size: 18px;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 500px;
            padding: 25px;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: #666;
        }

        .modal-body {
            margin-bottom: 20px;
        }

        .modal-textarea {
            width: 100%;
            height: 120px;
            padding: 12px;
            border: 1px solid var(--medium-gray);
            border-radius: 6px;
            resize: none;
            font-family: inherit;
            font-size: 14px;
        }

        .modal-textarea:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Success Message */
        .success-message {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            z-index: 1001;
            text-align: center;
            max-width: 400px;
        }

        .success-icon {
            color: var(--success-color);
            font-size: 40px;
            margin-bottom: 15px;
        }

        .success-text {
            font-size: 16px;
            margin-bottom: 20px;
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .profile-container {
                flex-direction: column;
            }

            .profile-sidebar {
                width: 100%;
                padding: 15px 0;
            }

            .profile-sidebar ul {
                display: flex;
                overflow-x: auto;
                padding: 0 15px;
            }

            .profile-sidebar li {
                white-space: nowrap;
                border-left: none;
                border-bottom: 3px solid transparent;
                padding: 10px 15px;
            }

            .profile-sidebar li.active {
                border-left: none;
                border-bottom: 3px solid var(--secondary-color);
            }

            .order-item {
                flex-direction: column;
            }

            .order-item-image {
                margin-bottom: 15px;
            }

            .action-buttons {
                flex-direction: column;
            }
        }

        @media (max-width: 768px) {
            .order-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .order-item-attributes {
                flex-direction: column;
                gap: 5px;
            }

            .modal-content {
                margin: 0 15px;
            }
        }
    </style>
</head>

<body class="body">
    <div class="container" style="margin-top:20px;">
        <div class="profile-header">
        </div>

        <div class="profile-container">
            <div class="profile-sidebar">
                <ul>
                    <li onclick="location.href='/user/profile'">
                        <i class="fas fa-user"></i> Profile
                    </li>
                    <li onclick="location.href='/user/security'">
                        <i class="fas fa-lock"></i> Security & Password
                    </li>
                    <li onclick="location.href='/user/wallet'">
                        <i class="fas fa-wallet"></i> Wallet
                    </li>
                    <li class="active" onclick="location.href='/user/orders'">
                        <i class="fas fa-shopping-bag"></i> Orders
                    </li>
                    <li onclick="location.href='/user/address'">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </li>
                    <li onclick="location.href='/user/deleteuser'">
                        <i class="fas fa-trash-alt"></i> Delete Account
                    </li>
                </ul>
            </div>

            <div class="profile-content">
                <div class="order-header">
                    <div>
                        <h2 class="order-title">
                            <i class="fas fa-clipboard-list"></i> Order Details
                        </h2>
                        <div class="order-number">Order #{{order.orderId}}</div>
                    </div>

                    <div>
                        <a class="btn btn-secondary" href="/user/order-invoice/{{order._id}}">
                            Order-Invoice
                        </a>
                    </div>
                    <div>
                        <h15>
                            <i class="fas fa-money-bill-wave"></i> Payment Status
                        </h15>
                        <div style="display:flex; justify-content:center;"
                            class="order-status-badge status-{{toLowerCase order.paymentStatus}}">
                            {{order.paymentStatus}}
                        </div>
                    </div>
                </div>

                <!-- Order Item Card -->
                <div class="order-card">
                    <div class="order-card-header">
                        <div class="order-card-title">Item Details</div>
                        <div class="order-item-status">
                            <div>
                                <h10>
                                    <i class="fas fa-box"></i> Shipment Status
                                </h10>
                                <span class="status-text"
                                    style="color: {{#if (eq item.status 'Completed')}}var(--success-color){{else if (eq item.status 'Cancelled')}}var(--accent-color){{else if (eq item.status 'Returned')}}var(--accent-color){{else}}var(--secondary-color){{/if}};">
                                    {{item.status}}
                                </span>
                            </div>

                        </div>
                    </div>
                    <div class="order-item">
                        <div class="order-item-image">
                            <img src="{{item.productImg}}" alt="{{item.productName}}">
                        </div>
                        <div class="order-item-details">
                            <div class="order-item-name">{{item.productName}}</div>
                            <div class="order-item-attributes">
                                <span>Size: {{item.productSize}}</span>
                                <span>Quantity: {{item.quantity}}</span>
                                <span>Price: ₹{{ item.productPrice}}</span>
                            </div>
                            <div class="order-item-price">
                                Total: ₹{{multiply item.productPrice item.quantity}}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Address Card -->
                <div class="order-card delivery-address-card">
                    <div class="order-card-header">
                        <div class="order-card-title">Delivery Address</div>
                    </div>
                    <div class="address-details">
                        <p><strong>{{order.deliveryAddress.name}}</strong></p>
                        <p>{{order.deliveryAddress.streetAddress}}</p>
                        <p>Landmark: {{order.deliveryAddress.landmark}}</p>
                        <p>{{order.deliveryAddress.house}}, {{order.deliveryAddress.city}},</p>
                        <p>{{order.deliveryAddress.state}} - {{order.deliveryAddress.zip}}</p>
                        <p>{{order.deliveryAddress.country}}</p>
                        <p>Phone: {{order.deliveryAddress.phone}}</p>
                    </div>
                </div>


                <!-- Price Details Card -->
                <div class="order-card price-details-card">
                    <div class="order-card-header">
                        <div class="order-card-title">Payment Details</div>
                    </div>
                    <div class="price-summary">

                        <div class="price-row">
                            <span class="price-label">Subtotal ({{order.totalItems}} items)</span>
                            <span class="price-value">₹{{order.subtotal}}</span>
                        </div>

                        <div class="price-row">
                            <span class="price-label">Shipping</span>
                            {{#ifEquals order.shippingFee 0}}
                            <span class="price-value" style="color: var(--success-color);">Free</span>
                            {{else}}
                            <span class="price-value">₹{{order.shippingFee}}</span>
                            {{/ifEquals}}
                        </div>

                        <div class="price-row">
                            <span class="price-label">Tax</span>
                            <span class="price-value">₹{{order.tax}}</span>
                        </div>

                        {{#if order.couponId}}
                        <div class="price-row">
                            <span class="price-label">Coupon Discount</span>
                            <span class="price-value"
                                style="color: var(--success-color);">-₹{{order.couponDiscount}}</span>
                        </div>
                        {{/if}}

                        {{#if order.offerDiscount}}
                        <div class="price-row">
                            <span class="price-label">Discount</span>
                            <span class="price-value"
                                style="color: var(--success-color);">-₹{{order.offerDiscount}}</span>
                        </div>
                        {{/if}}

                        {{#if (or (eq order.paymentMethod "razorpay") (eq order.paymentMethod "Wallet"))}}
                        <div class="price-row">
                            <span class="price-label">Wallet Amount Used</span>
                            <span class="price-value"
                                style="color: var(--success-color);">-₹{{order.walletAmountUsed}}</span>
                        </div>
                        {{/if}}

                        <div class="price-row total-price">
                            <span class="price-label"><strong>Amount {{#if (or (eq order.paymentMethod "razorpay") (eq
                                    order.paymentMethod "Wallet"))}}Paid{{else}}To Pay{{/if}}</strong></span>
                            <span class="price-value"><strong>₹{{order.totalAmount}}</strong></span>
                        </div>

                        <div class="payment-method">
                            <span class="price-label">Payment Method:</span>
                            <span class="price-value">{{order.paymentMethod}}</span>
                        </div>
                    </div>
                </div>


                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button id="return-order-button" class="btn btn-danger" data-order-status="{{item.status}}"
                        data-completion-date="{{order.completionDate}}">
                        <i class="fas fa-undo"></i> Return Item
                    </button>
                    <button id="cancel-order-button" class="btn btn-secondary" data-order-status="{{item.status}}">
                        <i class="fas fa-times"></i> Cancel Item
                    </button>
                    <button class="btn btn-primary" onclick="location.href='/user/orders'">
                        <i class="fas fa-arrow-left"></i> Back to Orders
                    </button>
                </div>


                {{#if (gt order.items.length 1)}}
                <!-- Other Items in Order -->
                <div class="order-card other-items-card">
                    <div class="order-card-header">
                        <div class="order-card-title">Other Items in This Order</div>
                    </div>
                    {{#each order.items}}
                    {{#if (neq this._id ../item._id)}}
                    <a href="/user/orderDetails/{{../order._id}}/{{this._id}}" class="other-item">
                        <div class="other-item-image">
                            <img src="{{this.productImg}}" alt="{{this.productName}}">
                        </div>
                        <div class="other-item-name">
                            {{this.productName}} (Size: {{this.productSize}}, Qty: {{this.quantity}})
                        </div>
                        <div class="other-item-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </a>
                    {{/if}}
                    {{/each}}
                </div>

                {{/if}}
            </div>
        </div>
    </div>

    <!-- Cancel Order Modal -->
    <div id="cancel-order-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Cancel Order Item</h3>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Please provide a reason for cancellation:</p>
                <textarea id="cancellation-reason" class="modal-textarea"
                    placeholder="Enter reason for cancellation..."></textarea>
            </div>
            <div class="modal-footer">
                <button id="cancel-modal-button" class="btn btn-secondary">Close</button>
                <button id="submit-cancellation" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>

    <!-- Return Order Modal -->
    <div id="return-order-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Return Order Item</h3>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Please provide a reason for return:</p>
                <textarea id="return-reason" class="modal-textarea" placeholder="Enter reason for return..."></textarea>
                <div id="return-reason-error" style="color: var(--accent-color); margin-top: 10px; display: none;">
                    Please provide a reason for return.
                </div>
            </div>
            <div class="modal-footer">
                <button id="cancel-return-modal-button" class="btn btn-secondary">Close</button>
                <button id="submit-return" class="btn btn-primary">Submit</button>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    <div id="success-message" class="success-message">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="success-text">
            Your request has been submitted successfully!
        </div>
        <button id="close-success-message" class="btn btn-primary">OK</button>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Elements
            const cancelButton = document.getElementById("cancel-order-button");
            const returnButton = document.getElementById("return-order-button");
            const cancelModal = document.getElementById("cancel-order-modal");
            const returnModal = document.getElementById("return-order-modal");
            const successMessage = document.getElementById("success-message");
            const orderStatus = cancelButton.dataset.orderStatus;
            const completionDate = new Date(returnButton.dataset.completionDate);

            // Cancel Button Logic
            if (orderStatus !== "Pending") {
                cancelButton.disabled = true;
            } else {
                cancelButton.addEventListener("click", function () {
                    cancelModal.style.display = "flex";
                });
            }

            // Close Cancel Modal
            document.querySelector("#cancel-order-modal .close-modal").addEventListener("click", function () {
                cancelModal.style.display = "none";
            });

            document.getElementById("cancel-modal-button").addEventListener("click", function () {
                cancelModal.style.display = "none";
            });

            // Submit Cancellation
            document.getElementById("submit-cancellation").addEventListener("click", async function () {
                const reason = document.getElementById("cancellation-reason").value.trim();

                if (!reason) {
                    alert("Please provide a reason for cancellation.");
                    return;
                }

                const data = {
                    orderId: "{{order.orderId}}",
                    itemId: "{{item._id}}",
                    variationIndex: "{{item.variationIndex}}",
                    reason: reason
                };

                try {
                    const response = await fetch("/user/cancel-order", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        cancelModal.style.display = "none";
                        showSuccessMessage();
                    } else {
                        const errorData = await response.json();
                        alert(errorData.message || "Failed to cancel order. Please try again.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("An error occurred. Please try again.");
                }
            });

            // Return Button Logic
            if (orderStatus === "Completed") {
                const currentDate = new Date();
                const returnEndDate = new Date(completionDate);
                returnEndDate.setDate(returnEndDate.getDate() + 7);

                if (currentDate > returnEndDate) {
                    returnButton.disabled = true;
                } else {
                    returnButton.addEventListener("click", function () {
                        returnModal.style.display = "flex";
                    });
                }
            } else {
                returnButton.disabled = true;
            }

            // Close Return Modal
            document.querySelector("#return-order-modal .close-modal").addEventListener("click", function () {
                returnModal.style.display = "none";
            });

            document.getElementById("cancel-return-modal-button").addEventListener("click", function () {
                returnModal.style.display = "none";
            });

            // Submit Return
            document.getElementById("submit-return").addEventListener("click", async function () {
                const reason = document.getElementById("return-reason").value.trim();
                const errorElement = document.getElementById("return-reason-error");

                if (!reason) {
                    errorElement.style.display = "block";
                    return;
                }

                errorElement.style.display = "none";

                const data = {
                    orderId: "{{order.orderId}}",
                    itemId: "{{item._id}}",
                    reason: reason
                };

                try {
                    const response = await fetch("/user/return-order", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    if (response.ok) {
                        returnModal.style.display = "none";
                        showSuccessMessage();
                    } else {
                        const errorData = await response.json();
                        alert(errorData.message || "Failed to return order. Please try again.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("An error occurred. Please try again.");
                }
            });

            // Close Success Message
            document.getElementById("close-success-message").addEventListener("click", function () {
                successMessage.style.display = "none";
                window.location.reload();
            });

            // Close modals when clicking outside
            window.addEventListener("click", function (event) {
                if (event.target === cancelModal) {
                    cancelModal.style.display = "none";
                }
                if (event.target === returnModal) {
                    returnModal.style.display = "none";
                }
            });

            // Helper function to show success message
            function showSuccessMessage() {
                successMessage.style.display = "block";
                setTimeout(() => {
                    if (successMessage.style.display === "block") {
                        successMessage.style.display = "none";
                        window.location.reload();
                    }
                }, 3000);
            }
        });
    </script>
</body>

</html>