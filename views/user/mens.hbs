<head>
  <link rel="stylesheet" type="text/css" href="/stylesheets/user/css/mens.css" />
  <!--===============================================================================================-->
</head>


<br><br>
<br><br>
<br><br>

<section class="product-grid">
  <div class="container">
    <div class="row">

      <h1 >Mens</h1>
      <br><br>
      <br><br>

      {{#each product}}
      <div class="col-sm-6 col-md-4 col-lg-3 p-b-35">
        <div class="product-card">
          <div class="product-image">
            <a href="/user/singleproduct/{{this._id}}">
              <img src="{{this.images.[0].path}}" alt="{{this.name}}" class="product-img">

              <div class="product-overlay"> </div>
              <div class="product-wishlist-container">
                <a href="#" class="add-to-wishlist js-addwish-b2" data-product-id="{{this._id}}">
                  <i class="fas fa-heart"></i> <span>WISHLIST</span>
                </a>
                <a href="#" class="added-to-wishlist" data-product-id="{{this._id}}" style="display: none;"> <i
                    class="fas fa-check"></i> <span>WISHLIST</span>
                </a>
              </div>
            </a>
          </div>
          <div class="product-details">
            <h3 class="product-title">
              <a href="/user/singleproduct/{{this._id}}" class="product-name">
                {{this.name}}
              </a>
            </h3>
            <span class="product-price">₹ {{this.details.[0].price}}</span>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<br><br>
<br><br>


<script>
  $(document).ready(function () {
    $('.add-to-wishlist').click(function (e) {
      e.preventDefault();
      $(this).hide(); // Hide "Add to Wishlist"
      $(this).siblings('.added-to-wishlist').show(); // Show "WISHLIST"
      // ... Your AJAX/wishlist logic here ...
    });

    $('.added-to-wishlist').click(function (e) {
      e.preventDefault();
      $(this).hide(); // Hide "WISHLIST"
      $(this).siblings('.add-to-wishlist').show(); // Show "Add to Wishlist"
      // ... Your AJAX/wishlist logic here ...
    });
  });

</script>