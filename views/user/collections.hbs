{{#section 'head'}}
<title>Shop Products - Your Store</title>
<script src="/javascripts/user/productCard.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.6.1/nouislider.min.css">
<link rel="stylesheet" type="text/css" href="/stylesheets/user/collection.css">
<link rel="stylesheet" type="text/css" href="/stylesheets/user/productCard.css">
{{/section}}


<div class="product-listing-page">

    <div class="container">

        <!-- =========================================================
             PAGE HEADER
        ========================================================= -->

        <div class="page-header">

            <h1 class="page-title">
                Shop Products
            </h1>

            <p class="page-subtitle">
                Discover our premium collection of fashion items for men and women
            </p>

        </div>



        <!-- =========================================================
             MOBILE ACTIONS
        ========================================================= -->

        <button class="mobile-filter-toggle">

            <i class="fas fa-filter"></i>

            Filter Products

        </button>


        <!-- MOBILE SEARCH -->
        <form method="GET" action="/user/collections" class="mobile-collection-search">

            <div class="mobile-search-wrapper">

                <input type="search" name="query" placeholder="Search products..." autocomplete="off" {{#if
                    query}}value="{{query}}" {{/if}}>

                {{#if sort}}

                <input type="hidden" name="sort" value="{{sort}}">

                {{/if}}

                <button type="submit">

                    <i class="fa fa-search"></i>

                </button>

            </div>

        </form>



        <!-- =========================================================
             PRODUCT LISTING CONTAINER
        ========================================================= -->

        <div class="product-listing-container">


            <!-- =========================================================
                 FILTER SIDEBAR
            ========================================================= -->

            {{#if showFilter}}

            <aside class="filter-sidebar">

                <!-- your filters here -->

            </aside>

            {{/if}}



            <!-- =========================================================
                 PRODUCT GRID SECTION
            ========================================================= -->

            <div class="product-grid-section">


                <!-- GRID HEADER -->
                <div class="product-grid-header">

                    <div class="product-count">

                        Showing
                        {{products.length}}
                        of
                        {{totalProducts}}
                        products

                        {{#if query}}

                        matching
                        "{{query}}"

                        {{/if}}

                    </div>


                    <!-- SORT -->
                    <div class="sort-dropdown">

                        <form id="sortForm" method="GET" action="/user/collections" class="d-flex align-items-end">

                            <input type="hidden" name="query" value="{{query}}">

                            <select name="sort" id="sortSelect" class="form-select" onchange="this.form.submit()">

                                <option value="">
                                    Sort By
                                </option>

                                <option value="price-low-high" {{#if (eq sort "price-low-high" )}}selected{{/if}}>
                                    Price: Low to High
                                </option>

                                <option value="price-high-low" {{#if (eq sort "price-high-low" )}}selected{{/if}}>
                                    Price: High to Low
                                </option>

                                <option value="name-a-z" {{#if (eq sort "name-a-z" )}}selected{{/if}}>
                                    Name: A-Z
                                </option>

                                <option value="newest" {{#if (eq sort "newest" )}}selected{{/if}}>
                                    Newest
                                </option>

                            </select>

                        </form>

                    </div>

                </div>



                <!-- =========================================================
                     PRODUCT GRID
                ========================================================= -->

                <div class="product-grid">

                    {{#if products.length}}

                    {{#each products}}

                    <div class="product-card-wrapper">

                        {{> user/productCard this}}

                    </div>

                    {{/each}}


                    {{else}}

                    <!-- NO PRODUCTS -->
                    <div class="no-products">

                        <h3>
                            No products found
                        </h3>

                        <p>
                            We couldn't find any products matching your criteria.
                        </p>

                        <a href="/user/collections" class="btn btn-primary">

                            Browse All Products

                        </a>

                    </div>

                    {{/if}}

                </div>



                <!-- =========================================================
                     PAGINATION
                ========================================================= -->

                <div class="pagination">

                    <div class="pagination-list">


                        {{#if (gt currentPage 1)}}

                        <a href="?page={{subtract currentPage 1}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}"
                            class="pagination-item">

                            <i class="fas fa-chevron-left"></i>

                        </a>

                        {{/if}}



                        {{#if (gt currentPage 3)}}

                        <a href="?page=1{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}"
                            class="pagination-item">

                            1

                        </a>

                        <span class="pagination-item">
                            ...
                        </span>

                        {{/if}}



                        {{#each (range (max 1 (subtract currentPage 2)) (min totalPages (add currentPage 2)))}}

                        <a href="?page={{this}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}"
                            class="pagination-item {{#if (eq this ../currentPage)}}active{{/if}}">

                            {{this}}

                        </a>

                        {{/each}}



                        {{#if (lt currentPage (subtract totalPages 2))}}

                        <span class="pagination-item">
                            ...
                        </span>

                        <a href="?page={{totalPages}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}"
                            class="pagination-item">

                            {{totalPages}}

                        </a>

                        {{/if}}



                        {{#if (lt currentPage totalPages)}}

                        <a href="?page={{add currentPage 1}}{{#if query}}&query={{query}}{{/if}}{{#if sort}}&sort={{sort}}{{/if}}"
                            class="pagination-item">

                            <i class="fas fa-chevron-right"></i>

                        </a>

                        {{/if}}

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


{{#section 'scripts'}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.6.1/nouislider.min.js" defer></script>
<script src="/javascripts/user/collection.js" defer></script>
{{/section}}