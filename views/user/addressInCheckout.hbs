{{#section 'head'}}
<title>Select Delivery Address</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/addressInCheckout.css">
{{/section}}


<div class="container">
    <div class="address-container">
        <div class="address-section">
            <div class="section-header">
                <div class="checkout-page-header">

                    <h1 class="checkout-page-title">
                        Select Delivery Address
                    </h1>

                    <p class="checkout-page-subtitle">
                        Choose where you’d like your order delivered.
                    </p>

                </div>
                <div style="margin-right: 50px;"></div>


                <div class="section-header">

                    <button style="margin-top: 10px;" class="btn-add-address" id="addAddressBtn">

                        <i class="fas fa-plus"></i>

                        Add New Address

                    </button>

                </div>

            </div>

            {{#if address.length}}
            <div class="address-list">
                {{#each address}}
                <div class="address-card" id="address-{{_id}}">
                    <input type="radio" name="selectedAddress" value="{{_id}}" id="address-{{_id}}-radio"
                        class="address-radio" {{#if isDefault}}checked{{/if}}>
                    <div class="address-details">
                        <div class="address-name">
                            {{name}}
                            <span class="address-type">{{#if isDefault}}DEFAULT{{else}}HOME{{/if}}</span>
                        </div>
                        <p class="address-text">{{streetAddress}}</p>
                        {{#if landmark}}<p class="address-text">{{landmark}}</p>{{/if}}
                        <p class="address-text">{{city}}, {{state}} - {{zip}}</p>
                        <p class="address-text">{{country}}</p>
                        <p class="address-phone"><i class="fas fa-phone"></i> {{phone}}</p>
                        <p class="address-pod"><i class="fas fa-check-circle"></i> Pay on Delivery available</p>
                    </div>
                    <div class="address-actions">
                        <button class="btn-edit" data-address-id="{{_id}}">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="btn-remove" data-address-id="{{_id}}">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-address">
                <i class="fas fa-map-marker-alt"></i>
                <h3>No Addresses Found</h3>
                <p>You haven't added any addresses yet. Please add an address to continue with your order.</p>
            </div>
            {{/if}}
        </div>

        <div class="order-summary-section">
            <div class="price-summary">
                <h2>Order Summary</h2>
                <div class="summary-item">
                    <span>Subtotal ({{cart.totalItems}} items)</span>
                    <span>₹{{cart.subtotal}}</span>
                </div>
                <div class="summary-item">
                    <span>Shipping</span>
                    {{#ifEquals cart.shippingFee 0}}
                    <span style="color: var(--success-color);">Free</span>
                    {{else}}
                    <span>₹{{cart.shippingFee}}</span>
                    {{/ifEquals}}
                </div>
                <div class="summary-item">
                    <span>Tax</span>
                    <span>₹{{cart.tax}}</span>
                </div>

                {{#if cart.couponId}}
                <div class="summary-item">
                    <span>Coupon Discount</span>
                    <span style="color: var(--success-color);">-₹{{cart.couponDiscount}}</span>
                </div>
                {{/if}}

                {{#if cart.offerDiscount}}
                <div class="summary-item">
                    <span>Discount</span>
                    <span style="color: var(--success-color);">-₹{{cart.offerDiscount}}</span>
                </div>
                {{/if}}

                <div class="summary-item total">
                    <span>Total Amount</span>
                    <span>₹{{cart.totalAmount}}</span>
                </div>
            </div>
            <button class="btn-continue" id="continueBtn" disabled>
                <i class="fas fa-lock"></i> Continue to Payment
            </button>
        </div>
    </div>
</div>

<!-- Add/Edit Address Modal -->
<div id="addressModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2 class="modal-title" id="modalTitle">Add New Address</h2>
        <form id="addressForm" class="address-form" novalidate>
            <input type="hidden" id="addressId" name="addressId" value="">

            <div class="form-group">
                <label for="name">Address Name (e.g., Home, Office)</label>
                <input type="text" id="name" name="name" required>
                <div id="nameError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="streetAddress">Street Address</label>
                <input type="text" id="streetAddress" name="streetAddress" required>
                <div id="streetAddressError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="landmark">Landmark (Optional)</label>
                <input type="text" id="landmark" name="landmark">
                <div id="landmarkError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="city">City</label>
                <select id="city" name="city" required>
                    <option value="" disabled selected>Select City</option>
                    <option value="Kasaragod">Kasaragod</option>
                    <option value="Kannur">Kannur</option>
                    <option value="Wayanad">Wayanad</option>
                    <option value="Kozhikode">Kozhikode</option>
                    <option value="Malappuram">Malappuram</option>
                    <option value="Palakkad">Palakkad</option>
                    <option value="Thrissur">Thrissur</option>
                    <option value="Ernakulam">Ernakulam</option>
                    <option value="Idukki">Idukki</option>
                    <option value="Kottayam">Kottayam</option>
                    <option value="Alappuzha">Alappuzha</option>
                    <option value="Pathanamthitta">Pathanamthitta</option>
                    <option value="Kollam">Kollam</option>
                    <option value="Thiruvananthapuram">Thiruvananthapuram</option>
                </select>
                <div id="cityError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="state">State/Province</label>
                <select id="state" name="state" required>
                    <option value="" disabled selected>Select State</option>
                    <option value="Kerala">Kerala</option>
                </select>
                <div id="stateError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="zip">Postal/Zip Code</label>
                <input type="text" id="zip" name="zip" required pattern="[0-9]{6}">
                <div id="zipError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="country">Country</label>
                <select id="country" name="country" required>
                    <option value="" disabled selected>Select Country</option>
                    <option value="India">India</option>
                </select>
                <div id="countryError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" required pattern="[0-9]{10}">
                <div id="phoneError" class="error-message"></div>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" id="isDefault" name="isDefault">
                    Set as default address
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-cancel" id="cancelBtn">Cancel</button>
                <button type="submit" class="btn-save">Save Address</button>
            </div>
        </form>
    </div>
</div>


{{#section 'scripts'}}
<script src="/javascripts/user/addressInCheckout.js" defer></script>
{{/section}}