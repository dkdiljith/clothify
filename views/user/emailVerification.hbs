{{#section 'head'}}
<link rel="stylesheet" href="/stylesheets/user/emailVerification.css">
{{/section}}
<div class="verification-background"
  style="background: url('https://i.postimg.cc/CM8Sjdw4/pexels-markus-winkler-1430818-3925956.jpg') no-repeat center center fixed; background-size: cover;">
  <!-- Logo -->
  <img src="https://i.postimg.cc/Njc59RgL/Clothify-logo-white.png" alt="Clothify Logo" class="website-logo">
  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="login-card">
            <form id="emailVerificationForm" action="/user/emailVerification" method="POST" novalidate>
              <input type="hidden" name="_csrf" value="{{csrfToken}}">
              <!-- Hidden Timer Values -->
              <input type="hidden" id="verificationTimerValue" value="{{verificationTimer}}">
              <input type="hidden" id="resendTimerValue" value="{{resendTimer}}">
              <h3 class="text-center mb-2">
                Verify Your Email
              </h3>
              <p class="text-muted text-center mb-4">
                We've sent a 6-digit verification code to your email address.
              </p>
              <!-- OTP Expiry -->
              <div class="otp-status">
                <i class="fas fa-clock me-2"></i>
                OTP expires in
                <strong id="verificationCountdown">15:00</strong>
              </div>
              <!-- OTP -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-shield-alt"></i>
                  <input type="text" id="verificationCode" name="verificationCode" class="form-control"
                    placeholder="Enter 6-digit OTP" maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                    required>
                </div>
                <small id="verificationCodeError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Verify Button -->
              <button type="submit" id="verifyButton" class="btn btn-primary-red btn-lg w-100">
                Verify Email
              </button>
              <!-- Resend -->
              <div class="text-center mt-4">
                <button type="button" id="resendButton" class="btn btn-link" disabled>
                  Resend Verification Code
                </button>
                <div id="resendTimer" class="small text-muted">
                  Available in 60s
                </div>
              </div>
              <div class="custom-links">
                <a href="/user/login">
                  <i class="fas fa-arrow-left me-2"></i>
                  Back to Login
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{{#section 'scripts'}}
<script src="/javascripts/user/emailVerification.js" defer></script>
{{/section}}