{{#section 'head'}}
<title>Product Not Found | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/singleProductPageNF.css">
<link rel="stylesheet" type="text/css" href="/stylesheets/user/singleProductPage.css">
{{/section}}

<!-- Breadcrumbs matching your main theme -->
<nav class="breadcrumb-nav">
    <div class="container">
        <a href="/user/home">Home</a> &gt;
        <span>Product Not Found</span>
    </div>
</nav>

<div class="container">
    <!-- Main Error Card Wrapper -->
    <div class="product-not-found-wrapper">
        <div class="not-found-content">
            <div class="error-icon-box">
                <i class="fas fa-search"></i>
            </div>

            <h1 class="error-title">Oops! Product Not Found</h1>
            <p class="error-message">
                The item you are looking for might have been removed, had its name changed, or is temporarily
                unavailable.
            </p>

            <!-- Interactive Actions for User -->
            <div class="error-actions">
                <a href="/user/home" class="action-btn btn-buy-now">
                    <i class="fas fa-home"></i> Back to Home
                </a>
                <a href="javascript:history.back()" class="action-btn btn-wishlist">
                    <i class="fas fa-arrow-left"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
</div>
