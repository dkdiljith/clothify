{{#section 'head'}}
<title>Secure Payment | Complete Your Order</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/paymentPage.css">
{{/section}}
<div class="container">
    <div class="payment-container">
        <div class="payment-options-section">
            <div class="payment-page-header">
                <h1 class="payment-page-title">
                    Select Payment Method
                </h1>
                <p class="payment-page-subtitle">
                    Choose your preferred payment option to securely complete your order.
                </p>
            </div>
            <div class="payment-methods">
                <div class="payment-method" data-method="cod">
                    <div class="payment-method-content">
                        <div class="payment-method-icon">
                            <img src="https://i.postimg.cc/gkCRfjS4/image.png" alt="Cash on Delivery">
                        </div>
                        <div class="payment-method-details">
                            <div class="payment-method-name">Cash on Delivery (COD)</div>
                            <div class="payment-method-description">Pay when your order is delivered</div>
                        </div>
                        <div class="payment-method-check">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <input type="radio" name="selectedPayment" value="cod" id="cod">
                </div>
                <div class="payment-method" data-method="razorpay">
                    <div class="payment-method-content">
                        <div class="payment-method-icon">
                            <img src="https://badges.razorpay.com/badge-dark.png" alt="Razorpay">
                        </div>
                        <div class="payment-method-details">
                            <div class="payment-method-name">Online Payment</div>
                            <div class="payment-method-description">Secure online payment gateway</div>
                        </div>
                        <div class="payment-method-check">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <input type="radio" name="selectedPayment" value="razorpay" id="razorpay">
                </div>
                <div class="payment-method" data-method="wallet" data-wallet-balance="{{wallet.balance}}">
                    <div class="payment-method-content">
                        <div class="payment-method-icon">
                            <img src="https://i.postimg.cc/Y0r0c4TG/image.png" alt="Wallet">
                        </div>
                        <div class="payment-method-details">
                            <div class="payment-method-name">Wallet</div>
                            <h6>Balance: ₹{{wallet.balance}}</h6>
                            <div class="payment-method-description">Pay using your wallet balance</div>
                            <div class="insufficient-balance" style="display: none;">
                                Insufficient wallet balance
                            </div>
                        </div>
                        <div class="payment-method-check">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <input type="radio" name="selectedPayment" value="wallet" id="wallet">
                </div>
            </div>
            <div class="payment-security">
                <i class="fas fa-shield-alt"></i>
                <div class="payment-security-text">
                    <strong>Secure Payment:</strong> Your payment information is processed securely. We do not store
                    your credit card details.
                </div>
            </div>
        </div>
        <div class="order-summary-section">
            <div class="price-summary">
                <h2>Order Summary</h2>
                <div class="summary-item">
                    <span>Subtotal</span>
                    <span>₹{{cart.subtotal}}</span>
                </div>
                <div class="summary-item">
                    <span>Shipping</span>
                    {{#ifEquals cart.shippingFee 0}}
                    <span style="color: var(--success-color);">Free</span>
                    {{else}}
                    <span>₹{{cart.shippingFee}}</span>
                    {{/ifEquals}}
                </div>
                <div class="summary-item">
                    <span>Tax</span>
                    <span>₹{{cart.tax}}</span>
                </div>
                {{#if cart.couponId}}
                <div class="summary-item">
                    <span>Coupon Discount</span>
                    <span style="color: var(--success-color);">-₹{{cart.couponDiscount}}</span>
                </div>
                {{/if}}
                {{#if cart.offerDiscount}}
                <div class="summary-item">
                    <span>Discount</span>
                    <span style="color: var(--success-color);">-₹{{cart.offerDiscount}}</span>
                </div>
                {{/if}}
                <div class="summary-item total">
                    <span>Total Amount</span>
                    <span id="amount" name="amount">₹{{cart.totalAmount}}</span>
                </div>
            </div>
            <form id="payment-form" action="/user/payment/process" method="POST">
                <input type="hidden" name="paymentMethod" id="paymentMethodInput">
                <input type="hidden" name="addressId" id="addressIdInput">
                <button class="btn-place-order" type="submit" disabled id="placeOrderBtn">
                    <i class="fas fa-lock"></i>
                    PLACE ORDER
                </button>
            </form>
        </div>
    </div>
</div>
{{#section 'scripts'}}
<script src="/javascripts/user/paymentPage.js" defer></script>
{{/section}}