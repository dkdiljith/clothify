<script>
document.addEventListener('DOMContentLoaded', function() {
  // Payment Method Selection
  const paymentRadios = document.querySelectorAll('input[name="selectedPayment"]');

  paymentRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      const selectedPayment = this.value;
      localStorage.setItem('selectedPayment', selectedPayment);
      console.log(`Payment method ${selectedPayment} saved to local storage.`);
    });
  });
});

function placeOrder() {
  // Get addressId from URL params
  const urlParams = new URLSearchParams(window.location.search);
  const addressId = urlParams.get('selectedAddressId');

  // Get payment method from localStorage
  const paymentMethod = localStorage.getItem('selectedPayment');

  if (addressId && paymentMethod) {
    window.location.href = `/user/placeorder?selectedAddressId=${addressId}&selectedPayment=${paymentMethod}`;
  } else {
    console.warn("Address ID or payment method not found.");
    // Handle missing data (e.g., show an error message)
  }
}
</script>

