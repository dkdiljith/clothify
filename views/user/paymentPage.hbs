<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Delivery Address</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="styles.css">
    <style>
        /* General Styles (from cart page) */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #333;
            background-color: #f9f9f9;
        }

        .cart-container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            display: flex;
        }

        /* Cart Items Section (adapted) */
        .cart-items-section {
            flex: 2;
            padding-right: 20px;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 20px;
        }

        .cart-items {
            margin-bottom: 30px;
        }

        .cart-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 15px;
            border: 1px solid #eee;
            border-radius: 5px;
            margin-bottom: 15px;
        }

        .item-image img {
            width: 100px;
            border-radius: 5px;
        }

        .item-details {
            flex: 1;
        }

        .item-details h3 {
            margin: 0 0 10px;
            font-size: 18px;
        }

        .item-details .price {
            font-size: 16px;
            color: #e74c3c;
        }

        /* Price Summary Section (from cart page) */
        .cart-summary-section {
            flex: 1;
            position: sticky;
            top: 80px;
            height: fit-content;
        }

        .price-summary {
            padding: 20px;
            border: 1px solid #eee;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .price-summary h2 {
            margin: 0 0 15px;
            font-size: 24px;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .summary-item.total {
            font-weight: bold;
            font-size: 18px;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }

        .btn-checkout {
            width: 100%;
            padding: 15px 30px;
            font-size: 16px;
            border: none;
            border-radius: 5px;
            background-color: #2ecc71;
            color: white;
            cursor: pointer;
        }

        .btn-checkout:hover {
            background-color: #27ae60;
        }

        /* Address Specific Styles */
        .address-card {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
        }

        .address-actions button {
            margin-left: 5px;
        }

        .continue-btn {
            width: 100%;
            padding: 10px;
            background-color: #f04040;
            color: white;
            border: none;
            cursor: pointer;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.4);
        }

        .modal-content {
            background-color: #fefefe;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 60%;
            position: relative;
        }

        .close {
            color: #aaa;
            position: absolute;
            right: 10px;
            top: 5px;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .modal-content input[type="text"] {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            box-sizing: border-box;
        }

        .modal-actions {
            text-align: right;
            margin-top: 20px;
        }

        .modal-actions button {
            padding: 10px 20px;
            margin-left: 10px;
            cursor: pointer;
        }

        #saveBtn {
            background-color: #f04040;
            color: white;
            border: none;
        }

        .payment-options {
            margin-bottom: 20px;
        }

        .payment-options h3 {
            margin-top: 0;
        }

        .payment-method {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 15px;
            margin-bottom: 10px;
            cursor: pointer;
        }

        .payment-method.selected {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

        .payment-method img {
            height: 24px;
            margin-right: 10px;
            vertical-align: middle;
        }

        .payment-method label {
            display: flex;
            /* Use flexbox to align items */
            justify-content: space-between;
            /* Space items evenly */
            align-items: center;
            /* Vertically align items */
            padding: 10px;
            border: 1px solid #eee;
            border-radius: 4px;
            cursor: pointer;
        }

        .payment-method input[type="radio"] {
            margin: 0;
            /* Reset default margin */
        }

        .payment-method input[type="radio"]:checked+label {
            background-color: #f0f0f0;
        }

        .payment-method label {
            display: flex;
            align-items: center;
            /* Align items vertically in the center */
            padding: 10px;
            border: 1px solid #eee;
            border-radius: 4px;
            cursor: pointer;
        }

        .payment-method label svg {
            margin-right: 10px;
            /* Add spacing between the icon and text */
        }
    </style>
</head>

<br><br>
<br><br>
<br><br>

