
<head>
  <link rel="stylesheet" type="text/css" href="/stylesheets/user/css/resetPassword.css">
</head>
  <body style="background: url('https://i.postimg.cc/bvn6PFkk/pexels-automnenoble-1008206.jpg') no-repeat center center fixed; background-size: cover;">
    <!-- Website logo in the top-left corner -->
    <img
      src="https://i.postimg.cc/Njc59RgL/Clothify-logo-white.png"
      alt="Clothify Logo"
      class="website-logo"
    />
    <section class="d-flex justify-content-center align-items-center vh-100">
      <div class="container">
        <div class="row justify-content-end">
          <div class="col-md-6 col-lg-5">
            <div class="reset-card">
              <h3 class="text-center mb-4">Reset Password</h3>
              <form id="resetForm" method="post" action="/user/resetpassword" novalidate>
                <!-- New Password Field -->
                <div class="form-group">
                  <i class="fas fa-lock"></i>
                  <input
                    type="password"
                    id="newPassword"
                    class="form-control"
                    placeholder="Enter New Password"
                  />
                  <i
                    class="fas fa-eye password-toggle"
                    id="togglePassword"
                  ></i>
                  <small class="error-message" id="newPasswordError"></small>
                </div>
                <!-- Confirm Password Field -->
                <div class="form-group">
                  <i class="fas fa-lock"></i>
                  <input
                    type="password"
                    id="confirmPassword"
                    class="form-control"
                    placeholder="Confirm New Password"
                    maxlength="20"
                  />
                  <small
                    class="error-message"
                    id="confirmPasswordError"
                  ></small>
                </div>
                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary w-100">
                  Reset Password
                </button>
                <div class="custom-links mt-3">
                  <a href="/user/login">Back to Login <i class="fas fa-sign-in-alt"></i></a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
    	<script src="/javascripts/user/js/resetPassword.js"></script>
  </body>

