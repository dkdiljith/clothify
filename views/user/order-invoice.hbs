<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice #686faffec8146aef8cc5e3a9</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --primary: #2c3e50;
            --primary-light: rgba(44, 62, 80, 0.05);
            --secondary: #7f8c8d;
            --success: #27ae60;
            --warning: #e67e22;
            --danger: #e74c3c;
            --light: #f8f9fa;
            --dark: #343a40;
            --border: #e1e1e1;
        }

        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            overflow: hidden;
        }

        .invoice-header {
            padding: 25px 30px;
            background: var(--primary);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-placeholder {
            width: 50px;
            height: 50px;
            background-color: white;
            display: grid;
            place-items: center;
            border-radius: 8px;
            font-weight: bold;
            color: var(--primary);
            font-size: 18px;
        }

        .invoice-title {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .invoice-id {
            font-size: 16px;
            opacity: 0.9;
            margin-top: 5px;
        }

        .invoice-date {
            text-align: right;
        }

        .date {
            font-size: 16px;
            font-weight: 500;
        }

        .paid-badge {
            background: white;
            color: var(--primary);
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            display: inline-block;
            margin-top: 8px;
        }

        .company-address {
            padding: 30px;
            background: var(--light);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            border-bottom: 1px solid var(--border);
        }

        .address-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .address-text {
            line-height: 1.8;
            color: var(--secondary);
        }

        .invoice-body {
            padding: 30px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 30px;
        }

        .invoice-body-summary {
            padding: 30px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
        }

        .items-table thead th {
            text-align: left;
            padding: 12px 15px;
            background: var(--light);
            font-weight: 600;
            color: var(--primary);
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border);
        }

        .items-table tbody td {
            padding: 15px;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        .items-table tbody tr:hover {
            background-color: rgba(44, 62, 80, 0.02);
        }

        .product-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid var(--border);
        }

        .product-name {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .product-sku {
            font-size: 13px;
            color: var(--secondary);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 500;
        }

        .status::before {
            content: "";
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .status-pending {
            background-color: rgba(230, 126, 34, 0.1);
            color: var(--warning);
        }

        .status-pending::before {
            background-color: var(--warning);
        }

        .status-cancelled {
            background-color: rgba(231, 76, 60, 0.1);
            color: var(--danger);
        }

        .status-cancelled::before {
            background-color: var(--danger);
        }

        .reason {
            font-size: 13px;
            color: var(--danger);
            margin-top: 5px;
        }

        .summary-section {
            background: var(--primary-light);
            border-radius: 8px;
            padding: 20px;
        }

        .summary-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .totals-table {
            width: 100%;
            border-collapse: collapse;
        }

        .totals-table td {
            padding: 8px 0;
        }

        .totals-table tr:last-child td {
            border-top: 1px solid var(--border);
            font-weight: 600;
            font-size: 16px;
            padding-top: 12px;
        }

        .text-right {
            text-align: right;
        }

        .text-success {
            color: var(--success);
        }

        .payment-method {
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid var(--border);
        }

        .payment-method p {
            margin: 5px 0;
        }

        .legal-note {
            margin-top: 15px;
            font-size: 12px;
            color: var(--secondary);
        }

        .invoice-footer {
            padding: 20px 30px;
            background: var(--light);
            text-align: center;
            font-size: 14px;
            color: var(--secondary);
            border-top: 1px solid var(--border);
        }

        .footer-note {
            margin-bottom: 10px;
        }

        .social-links {
            margin: 15px 0;
        }

        .social-links a {
            color: var(--primary);
            margin: 0 10px;
            font-size: 16px;
            transition: all 0.2s ease;
        }

        .social-links a:hover {
            color: var(--dark);
            transform: translateY(-2px);
        }

        .footer-links {
            margin-top: 15px;
            font-size: 12px;
        }

        .footer-links a {
            color: var(--primary);
            text-decoration: none;
            margin: 0 5px;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        .action-buttons {
            display: flex;
            justify-content: space-between;
            margin: 20px 100px 20px 100px;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            border: none;
            font-size: 14px;
        }

        .btn-back {
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            color: #2c3e50;
        }

        .btn-back:hover {
            background-color: #e9ecef;
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .btn-download {
            background-color: #2c3e50;
            color: white;
        }

        .btn-download:hover {
            background-color: #1a252f;
            transform: translateY(-2px);
            box-shadow: 0 2px 12px rgba(44, 62, 80, 0.3);
        }

        @media print {
            body {
                background: none;
                padding: 0;
            }

            .action-buttons {
                display: none;
            }

            .invoice-container {
                box-shadow: none;
                border-radius: 0;
            }
        }

        @media (max-width: 768px) {
            .company-address {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .invoice-body {
                grid-template-columns: 1fr;
            }

            .summary-section {
                order: -1;
            }
        }

        @media (max-width: 600px) {
            .items-table thead {
                display: none;
            }

            .items-table tr {
                display: block;
                margin-bottom: 15px;
                border-bottom: 2px solid var(--border);
            }

            .items-table td {
                display: flex;
                justify-content: space-between;
                text-align: right;
                padding: 8px 15px;
                border-bottom: 1px dotted var(--border);
            }

            .items-table td::before {
                content: attr(data-label);
                font-weight: 600;
                color: var(--primary);
                margin-right: 15px;
            }

            .product-info {
                flex-direction: column;
                align-items: flex-start;
            }


            /*invoice downloading issue solving*/
            .items-table tbody tr {
                break-inside: avoid;
                page-break-inside: avoid;
                /* For older browsers/PDF engines */
            }

            .invoice-header,
            .company-address,
            .invoice-body,
            /* The main body container */
            .invoice-body-summary,
            /* The summary section's outer wrapper */
            .summary-section,
            /* The actual summary content box */
            .invoice-footer {
                break-inside: avoid;
                page-break-inside: avoid;
                /* For older browsers/PDF engines */
            }


        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

    <br><br>
    <div class="action-buttons">
        <a href="javascript:history.back()" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
        <button onclick="downloadPDF()" class="btn btn-download">
            <i class="fas fa-download"></i> Download Invoice
        </button>
    </div>

    <div class="invoice-container" id="invoice-content">
        <div class="invoice-header">
            <div class="brand-logo">
                <div class="logo-placeholder">CLOTHIFY</div>
                <div>
                    <h1 class="invoice-title">INVOICE</h1>
                    <div class="invoice-id">Order #{{order.orderId}}</div>
                </div>
            </div>
            <div class="invoice-date">
                <div class="date">{{formatDate order.createdAt}}</div> {{!-- Assuming you have a HBS helper for date
                formatting --}}
                <div class="paid-badge">{{order.paymentStatus}}</div> {{!-- Or a condition to show 'PAID' if
                paymentStatus is Completed --}}
            </div>
        </div>

        <div class="company-address">
            <div class="company-address-section">
                <div class="address-title" style="font-weight: 600; font-size: 18px; color: #2c3e50;">Clothify</div>
                <div class="address-text" style="line-height: 1.6; color: #444;">
                    <strong>8th Floor, near Shakthan Thampuran</strong><br>
                    Thrissur, Kerala 680001<br>
                    India<br>
                    <strong>Phone:</strong> (+91) 95 1234 5678<br>
                    <strong>Email:</strong> support@clothify.com
                </div>
            </div>

            <div>
                <div class="address-title">Billed To</div>
                <div class="address-text">
                    <strong>{{order.deliveryAddress.name}}</strong><br>
                    {{order.deliveryAddress.streetAddress}}<br>
                    {{order.deliveryAddress.landmark}}<br>
                    {{order.deliveryAddress.city}}, {{order.deliveryAddress.state}} - {{order.deliveryAddress.zip}}<br>
                    {{order.deliveryAddress.country}}<br>
                    <strong>Phone:</strong> {{order.deliveryAddress.phone}}
                </div>
            </div>

        </div>

        <div class="invoice-body">
            <div>
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each order.items}}
                        <tr>
                            <td data-label="Product">
                                <div class="product-info">
                                    <img src="{{this.productImg}}" alt="{{this.productName}}" class="product-img">
                                    <div>
                                        <div class="product-name">{{this.productName}}</div>
                                        <div class="product-sku">SKU: {{this.productId}}</div> {{!-- Using productId as
                                        SKU for now --}}
                                        <div>{{this.productSize}}</div>
                                        {{#if this.cancellationReason.length}}
                                        <div class="reason">Cancelled: {{this.cancellationReason.[0].reason}}</div>
                                        {{/if}}
                                    </div>
                                </div>
                            </td>
                            <td data-label="Price">₹{{this.productPrice}}.00</td>
                            <td data-label="Qty">{{this.quantity}}</td>
                            <td data-label="Total">₹{{multiply this.productPrice this.quantity}}.00</td> {{!-- Assuming
                            you have a HBS helper for multiplication --}}
                            <td data-label="Status">
                                <span class="status status-{{toLowerCase this.status}}">{{this.status}}</span> {{!--
                                Assuming a HBS helper for toLowerCase --}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="invoice-body-summary">
            <div class="summary-section">
                <div class="summary-title">Order Summary</div>
                <table class="totals-table">
                    <tr>
                        <td>Subtotal:</td>
                        <td class="text-right">₹{{order.subtotal}}.00</td>
                    </tr>

                    <tr>
                        <td>Shipping:</td>
                        {{#ifEquals order.shippingFee 0}}
                        <td class="text-right text-success">Free</td>
                        {{else}}
                        <td class="text-right">₹{{order.shippingFee}}.00</td>
                        {{/ifEquals}}
                    </tr>

                    <tr>
                        <td>Tax:</td>
                        <td class="text-right">₹{{order.tax}}.00</td>
                    </tr>

                    {{#if order.couponDiscount}}
                    <tr>
                        <td>Coupon Discount:</td>
                        <td class="text-right text-success">-₹{{order.couponDiscount}}.00</td>
                    </tr>
                    {{/if}}

                    {{#if order.offerDiscount}}
                    <tr>
                        <td>Offer Discount:</td>
                        <td class="text-right text-success">-₹{{order.offerDiscount}}.00</td>
                    </tr>
                    {{/if}}

                    {{#if (or (eq order.paymentMethod "razorpay") (eq order.paymentMethod "Wallet"))}}
                    <tr>
                        <td>Wallet Amount Used:</td>
                        <td class="text-right text-success">-₹{{order.walletAmountUsed}}.00</td>
                    </tr>
                    {{/if}}

                    <tr>
                        <td><strong>Total Amount:</strong></td>
                        <td class="text-right"><strong>₹{{order.totalAmount}}.00</strong></td>
                    </tr>
                </table>

                <div class="payment-method">
                    <p><strong>Payment Method:</strong> {{order.paymentMethod}}</p>
                    <p><strong>Payment Status:</strong>
                        <span style="color: {{#if (eq order.paymentStatus "
                            Paid")}}var(--success){{else}}#e74c3c{{/if}}">
                            {{order.paymentStatus}}
                        </span>
                    </p>
                    <p><strong>Order Date:</strong> {{formatDate order.createdAt}}</p>
                    <div class="legal-note">
                        This is a computer-generated invoice and does not require a physical signature.
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-footer" style="margin-top: 40px; text-align: center; font-size: 14px; color: #555;">
            <div class="footer-note" style="font-size: 16px; font-weight: 600; margin-bottom: 10px;">
                Thank you for shopping with <span style="color: #000;">Clothify</span>!
            </div>

            <div class="social-links" style="margin-bottom: 10px;">
                <a href="#" style="margin: 0 10px; color: #555;"><i class="fab fa-instagram"></i></a>
                <a href="#" style="margin: 0 10px; color: #555;"><i class="fab fa-facebook"></i></a>
                <a href="#" style="margin: 0 10px; color: #555;"><i class="fab fa-twitter"></i></a>
            </div>

            <div style="margin-bottom: 4px;">If you have any questions about this invoice, please contact:</div>
            <div style="margin-bottom: 10px;">
                <strong>support@clothify.com</strong> | <strong>(+91) 95 1234 5678</strong>
            </div>

            <div class="footer-links" style="font-size: 13px; color: #888;">
                © 2025 <strong>Clothify</strong>. All rights reserved.
                | <a href="#" style="color: #888;">Privacy Policy</a>
                | <a href="#" style="color: #888;">Terms of Service</a>
            </div>
        </div>
    </div>


    <br><br>
    <br><br>

    <script>
        function downloadPDF() {
            const element = document.getElementById('invoice-content');
            const opt = {
                margin: [15, 10, 15, 10], // top, right, bottom, left
                filename: `Clothify_Invoice_${document.querySelector('.invoice-id').textContent.replace('#', '')}.pdf`,
                image: {
                    type: 'jpeg',
                    quality: 1
                },
                html2canvas: {
                    scale: 2,
                    logging: false,
                    useCORS: true,
                    letterRendering: true,
                    allowTaint: true
                },
                jsPDF: {
                    unit: 'mm',
                    format: 'a4',
                    orientation: 'portrait',
                    compressPDF: true
                }
            };

            // Show loading state
            const btn = document.querySelector('.btn-download');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Preparing Document...';
            btn.disabled = true;

            // Add temporary overlay
            const overlay = document.createElement('div');
            overlay.style.position = 'fixed';
            overlay.style.top = '0';
            overlay.style.left = '0';
            overlay.style.width = '100%';
            overlay.style.height = '100%';
            overlay.style.backgroundColor = 'rgba(0,0,0,0.1)';
            overlay.style.zIndex = '9999';
            overlay.style.display = 'flex';
            overlay.style.justifyContent = 'center';
            overlay.style.alignItems = 'center';
            overlay.innerHTML = '<div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 20px rgba(0,0,0,0.2);"><i class="fas fa-spinner fa-spin"></i> Generating PDF...</div>';
            document.body.appendChild(overlay);

            // Generate PDF
            html2pdf()
                .set(opt)
                .from(element)
                .save()
                .then(() => {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    document.body.removeChild(overlay);
                })
                .catch(err => {
                    console.error('PDF generation failed:', err);
                    btn.innerHTML = '<i class="fas fa-exclamation-circle"></i> Try Again';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }, 2000);
                    document.body.removeChild(overlay);
                });
        }
    </script>
</body>

</html>