<script src="/javascripts/user/productCard.js"></script>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/productCard.css">


<div class="animsition">


	<!-- =========================================================
             HERO SLIDER
        ========================================================= -->

	{{> user/slider}}



	<!-- =========================================================
             FEATURED PRODUCTS
        ========================================================= -->

	<section class="featured-section">

		<div class="container">

			<h2 class="section-title">
				Featured Products
			</h2>

			<div class="row">

				{{#each product}}

				<div class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-6 mb-4">

					{{> user/productCard this}}

				</div>

				{{/each}}

			</div>


			<!-- VIEW ALL -->
			<div class="text-center mt-5">

				<a href="/user/collections" class="btn-primary">

					View All Products

				</a>

			</div>

		</div>

	</section>

</div>