{{#section 'head'}}
<title>Wallet | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/wallet.css">
{{/section}}


<div class="container" style="margin-top:20px;">
    <div class="profile-header">
    </div>

    <div class="profile-container">
        <div class="profile-sidebar">
            <ul>
                <li onclick="location.href='/user/profile'">
                    <i class="fas fa-user"></i> Profile
                </li>
                <li onclick="location.href='/user/security'">
                    <i class="fas fa-lock"></i> Security & Password
                </li>
                <li class="active" onclick="location.href='/user/wallet'">
                    <i class="fas fa-wallet"></i> Wallet
                </li>
                <li onclick="location.href='/user/orders'">
                    <i class="fas fa-shopping-bag"></i> Orders
                </li>
                <li onclick="location.href='/user/orders?retryPendingOrder=true'">
                    <i class="fas fa-shopping-bag"></i> Pending Orders
                </li>
                <li onclick="location.href='/user/address'">
                    <i class="fas fa-map-marker-alt"></i> Addresses
                </li>
                <li onclick="location.href='/user/deleteuser'">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </li>
            </ul>
        </div>

        <div class="profile-content">
            <div class="wallet-header">
                <h2 class="wallet-title">
                    <i class="fas fa-wallet"></i> Wallet Summary
                </h2>
            </div>

            <!-- Wallet Balance Card -->
            {{#if wallet.balance}}
            <div class="wallet-balance-card">
                <div class="wallet-balance-label">Available Balance</div>
                <div class="wallet-balance-amount">₹{{wallet.balance}}</div>
                <div class="wallet-balance-details">
                    <div class="wallet-balance-detail">
                        <i class="fas fa-arrow-down" style="margin-right: 5px;"></i>
                        ₹{{#if credit}}{{credit}}{{else}}0{{/if}} Total Credits
                    </div>
                    <div class="wallet-balance-detail">
                        <i class="fas fa-arrow-up" style="margin-right: 5px;"></i>
                        ₹{{#if debit}}{{debit}}{{else}}0{{/if}} Total Debits
                    </div>
                </div>
            </div>
            {{else}}
            <div class="wallet-balance-card"
                style="background: linear-gradient(135deg, #e74c3c, #c0392b); text-align: center;">
                <div style="font-size: 24px; margin-bottom: 15px;">
                    <i class="fas fa-wallet" style="margin-right: 10px;"></i>
                    Your wallet is empty
                </div>
                <div
                    style="margin-bottom: 20px; background-color: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px;">
                    Add money to your wallet for faster and easier payments
                </div>
                <button class="btn btn-primary btn-add-funds" style="margin: 0 auto;">
                    <i class="fas fa-plus-circle"></i> Add Funds Now
                </button>
            </div>
            {{/if}}

            <!-- Wallet Actions -->
            {{#if wallet.balance}}
            <div class="wallet-actions">
                <button class="btn btn-primary btn-add-funds">
                    <i class="fas fa-plus-circle"></i> Add Funds
                </button>
            </div>
            {{/if}}

            <!-- Recent Transactions -->
            <h3 class="wallet-section-title">
                <i class="fas fa-exchange-alt"></i> Recent Transactions
            </h3>

            <div class="transaction-history">
                {{#if wallet.transactions.length}}
                <table class="transaction-table">
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each wallet.transactions}}
                        <tr>
                            <td>
                                <div class="transaction-type">
                                    <div class="transaction-icon">
                                        {{#ifeq this.type 'credit'}}
                                        <i class="fas fa-arrow-down"></i>
                                        {{else}}
                                        <i class="fas fa-arrow-up"></i>
                                        {{/ifeq}}
                                    </div>
                                    <div>
                                        <div style="text-transform: capitalize;">{{this.type}}</div>
                                        <div class="transaction-date">{{formatDate this.createdAt "MMM D, YYYY"}}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>{{formatDate this.createdAt "h:mm A"}}</td>
                            <td
                                class="{{#ifeq this.type 'credit'}}transaction-credit{{else}}transaction-debit{{/ifeq}}">
                                {{#ifeq this.type 'credit'}}+{{else}}-{{/ifeq}}₹{{this.amount}}
                            </td>
                            <td class="transaction-description" title="{{this.description}}">
                                {{this.description}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{else}}
                <div class="no-transactions">
                    <i class="fas fa-exchange-alt" style="font-size: 24px; margin-bottom: 10px;"></i>
                    <p>No recent transactions found</p>
                </div>
                {{/if}}
            </div>



            {{#if wallet.transactions.length}}
            <!-- Pagination Controls -->
            <div style="display: flex; justify-content: center; margin-top: 20px; padding: 15px 0;">
                {{#if pagination.hasPrevPage}}
                <a href="/user/wallet?page={{pagination.prevPage}}"
                    style="padding: 8px 16px; margin: 0 5px; background-color: #3498db; color: white; text-decoration: none; border-radius: 4px;">
                    <i class="fas fa-chevron-left"></i> Previous
                </a>
                {{/if}}

                <span style="padding: 8px 16px; margin: 0 5px;">
                    Page {{pagination.page}} of {{pagination.totalPages}}
                </span>

                {{#if pagination.hasNextPage}}
                <a href="/user/wallet?page={{pagination.nextPage}}"
                    style="padding: 8px 16px; margin: 0 5px; background-color: #3498db; color: white; text-decoration: none; border-radius: 4px;">
                    Next <i class="fas fa-chevron-right"></i>
                </a>
                {{/if}}
            </div>
            {{/if}}


        </div>
    </div>
</div>



<!-- Add Funds Modal -->
<div id="addFundsModal"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
    <div
        style="background-color: white; padding: 30px; border-radius: 8px; width: 100%; max-width: 500px; box-shadow: 0 5px 15px rgba(0,0,0,0.3);">
        <h2 style="margin-top: 0; display: flex; justify-content: space-between; align-items: center;">
            <span><i class="fas fa-plus-circle" style="margin-right: 10px;"></i> Add Funds</span>
            <span class="close-funds-modal" style="cursor: pointer;">&times;</span>
        </h2>
        <div style="margin: 20px 0;">
            <label style="display: block; margin-bottom: 8px; font-weight: 500;">Amount</label>
            <div style="position: relative;">
                <span
                    style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-weight: bold;">₹</span>
                <input type="number" id="fundsAmount"
                    style="width: 100%; padding: 12px 12px 12px 30px; border: 1px solid #ddd; border-radius: 6px; font-size: 16px;"
                    placeholder="Enter amount" min="1">
            </div>
            <div style="margin-top: 15px; display: flex; flex-wrap: wrap; gap: 10px;">
                <button class="preset-amount-btn" data-amount="10"
                    style="padding: 8px 15px; background-color: #f0f0f0; border: none; border-radius: 4px; cursor: pointer;">
                    ₹10
                </button>
                <button class="preset-amount-btn" data-amount="20"
                    style="padding: 8px 15px; background-color: #f0f0f0; border: none; border-radius: 4px; cursor: pointer;">
                    ₹20
                </button>
                <button class="preset-amount-btn" data-amount="50"
                    style="padding: 8px 15px; background-color: #f0f0f0; border: none; border-radius: 4px; cursor: pointer;">
                    ₹50
                </button>
                <button class="preset-amount-btn" data-amount="100"
                    style="padding: 8px 15px; background-color: #f0f0f0; border: none; border-radius: 4px; cursor: pointer;">
                    ₹100
                </button>
            </div>

        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <button class="close-funds-modal"
                style="padding: 10px 20px; background-color: #f0f0f0; border: none; border-radius: 6px; cursor: pointer;">
                Cancel
            </button>
            <button id="confirm-add-funds"
                style="padding: 10px 20px; background-color: #3498db; color: white; border: none; border-radius: 6px; cursor: pointer;">
                Add Funds
            </button>

        </div>
    </div>
</div>


{{#section 'scripts'}}
<script src="/javascripts/user/wallet.js" defer></script>
{{/section}}