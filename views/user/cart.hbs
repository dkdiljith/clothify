<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Shopping Cart</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="styles.css">
  <style>
    /* General Styles */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      color: #333;
      background-color: #f9f9f9;
    }

    .cart-container {
      /* Wrapping container for the box */
      max-width: 1200px;
      margin: 20px auto;
      padding: 20px;
      background-color: #fff;
      border: 1px solid #ddd;
      border-radius: 10px;
      display: flex;
    }

    /* Cart Items Section */
    .cart-items-section {
      flex: 2;
      padding-right: 20px;
    }

    h1 {
      font-size: 28px;
      margin-bottom: 20px;
    }

    .cart-items {
      margin-bottom: 30px;
    }

    .cart-item {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 15px;
      border: 1px solid #eee;
      border-radius: 5px;
      margin-bottom: 15px;
    }

    .item-image img {
      width: 100px;
      border-radius: 5px;
    }

    .item-details {
      flex: 1;
    }

    .item-details h3 {
      margin: 0 0 10px;
      font-size: 18px;
    }

    .item-details .price {
      font-size: 16px;
      color: #e74c3c;
    }

    .quantity-selector {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 10px 0;
    }

    .quantity-selector input {
      width: 50px;
      padding: 5px;
      text-align: center;
      border: 1px solid #ddd;
      border-radius: 5px;
    }

    .btn-quantity {
      padding: 5px 10px;
      background-color: #3498db;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    .btn-quantity:hover {
      background-color: #2980b9;
    }

    .total-price {
      font-size: 16px;
      font-weight: bold;
    }

    .btn-remove {
      background-color: #e74c3c;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
    }

    .btn-remove:hover {
      background-color: #c0392b;
    }

    /* Price Summary Section */
    .cart-summary-section {
      flex: 1;
      position: sticky;
      top: 80px;
      height: fit-content;
    }

    .price-summary {
      padding: 20px;
      border: 1px solid #eee;
      border-radius: 5px;
      margin-bottom: 20px;
    }

    .price-summary h2 {
      margin: 0 0 15px;
      font-size: 24px;
    }

    .summary-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 16px;
    }

    .summary-item.total {
      font-weight: bold;
      font-size: 18px;
      border-top: 1px solid #ddd;
      padding-top: 10px;
    }

    .btn-checkout {
      width: 100%;
      padding: 15px 30px;
      font-size: 16px;
      border: none;
      border-radius: 5px;
      background-color: #2ecc71;
      color: white;
      cursor: pointer;
    }

    .btn-checkout:hover {
      background-color: #27ae60;
    }

    .btn-continue-shopping {
      display: none;
    }

 .popup-message {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #4caf50;
    color: white;
    padding: 10px 15px;
    border-radius: 5px;
    font-size: 14px;
    z-index: 1000;
    transition: opacity 0.5s ease-in-out;
}

.popup-message.error {
    background: #f44336;
}

.popup-message.fade-out {
    opacity: 0;
}

  </style>
</head>

<br><br>
<br><br>
<br><br>

<body>
  <div class="cart-container">
    <div class="cart-items-section">
      <h1>Your Shopping Cart</h1>
      <div class="cart-items">
        {{#if cart.items}}
        {{#each cart.items}}
        <div class="cart-item">
          <div class="item-image">
            <img src="{{this.productId.images.[0].path}}" alt="{{this.productId.name}}">
          </div>
          <div class="item-details">
            <h3>
              {{this.productId.name}}
              {{#if (getDetail this.productId.details this.variationIndex "size")}}
              ({{getDetail this.productId.details this.variationIndex "size"}})
              {{else}}
              (Size Not Found)
              {{/if}}
            </h3>
            <p class="price">
              ₹{{#if (getDetail this.productId.details this.variationIndex "price")}}
              {{getDetail this.productId.details this.variationIndex "price"}}
              {{else}}
              Price not found
              {{/if}} per unit
            </p>
            <p>
              Quantity: {{this.quantity}}
            </p>
            <div class="quantity-selector">
              <button class="btn-quantity decrement-quantity" data-product-id="{{this.productId._id}}"
                data-variation-index="{{this.variationIndex}}">-</button>
              <input type="number" value="{{this.quantity}}" min="1" class="quantity-input"
                data-product-id="{{this.productId._id}}" data-variation-index="{{this.variationIndex}} readonly">
              <button class="btn-quantity increment-quantity" data-product-id="{{this.productId._id}}"
                data-variation-index="{{this.variationIndex}}">+</button>
            </div>
            <p class="total-price">
              Total: ₹{{multiply this.quantity (getDetail this.productId.details this.variationIndex "price")}}
            </p>
          </div>
          <button class="btn-remove remove-item" data-product-id="{{this.productId._id}}"
            data-variation-index="{{this.variationIndex}}">
            <i class="fas fa-trash"></i> Remove
          </button>
        </div>
        {{/each}}
        {{else}}
        <p>Your cart is empty.</p>
        {{/if}}
      </div>
    </div>

    <div class="cart-summary-section">
      <div class="price-summary cart-summary">
        <h2>Order Summary</h2>
        <div class="summary-item">
          <span>Subtotal</span>
          <span>₹{{subtotal}}</span>
        </div>
        <div class="summary-item">
          <span>Shipping</span>
          <span>₹{{shippingFee}}</span>
        </div>
        <div class="summary-item total">
          <span>Total</span>
          <span>₹{{totalAmount}}</span>
        </div>
      </div>
      <button onclick="location.href='/user/addressInCart'"  class="btn-checkout">Proceed to Checkout</button>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
   document.addEventListener("DOMContentLoaded", function () {
    function showPopupMessage(message, type = "success") {
        const popup = document.createElement("div");
        popup.className = `popup-message ${type}`;
        popup.textContent = message;
        document.body.appendChild(popup);

        setTimeout(() => {
            popup.classList.add("fade-out");
            setTimeout(() => popup.remove(), 500);
        }, 3000);
    }

    document.querySelectorAll(".btn-quantity").forEach((button) => {
        button.addEventListener("click", async function () {
            const productId = this.getAttribute("data-product-id");
            const variationIndex = this.getAttribute("data-variation-index");
            const isIncrement = this.classList.contains("increment-quantity");

            const quantityChange = isIncrement ? 1 : -1;
            console.log(`Button clicked! Product ID: ${productId}, Variation: ${variationIndex}, Change: ${quantityChange}`);

            try {
                const response = await fetch(`/user/cart/${productId}/${variationIndex}/quantity`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ quantity: quantityChange }),
                });

                const data = await response.json();
                console.log("Server Response:", data);

                if (data.success) {
                    if (quantityChange > 0) {
                        showPopupMessage("Quantity increased!", "success");
                    } else {
                        showPopupMessage("Quantity decreased!", "success");
                    }
                    location.reload();
                } else {
                    showPopupMessage(data.message, "error");
                }
            } catch (error) {
                console.error("Request failed:", error);
                showPopupMessage("Something went wrong!", "error");
            }
        });
    });

    document.querySelectorAll(".btn-remove").forEach((button) => {
        button.addEventListener("click", async function () {
            const productId = this.getAttribute("data-product-id");
            const variationIndex = this.getAttribute("data-variation-index");

            console.log(`Remove button clicked! Product ID: ${productId}, Variation: ${variationIndex}`);

            try {
                const response = await fetch(`/user/cart/${productId}/${variationIndex}`, { method: "DELETE" });

                const data = await response.json();
                console.log("Server Response:", data);

                if (data.success) {
                    showPopupMessage("Item removed from cart!", "success");
                    location.reload();
                } else {
                    showPopupMessage(data.message, "error");
                }
            } catch (error) {
                console.error("Request failed:", error);
                showPopupMessage("Something went wrong!", "error");
            }
        });
    });
});


</script>


</body>

<br><br>
<br><br>


</html>