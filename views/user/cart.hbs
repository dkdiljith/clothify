{{#section 'head'}}
<title>Your Shopping Cart</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/cart.css">
{{/section}}


<div class="cart-page">
  <div class="container">
    <div class="cart-container">

      {{#if coupons.length}}
      <div class="coupons-available">
        <h3><i class="fas fa-tag"></i> Available Coupons</h3>
        {{#each coupons}}
        <div class="coupon-card {{#if (eq this._id ../cart.couponId)}}applied-coupon{{/if}}">
          {{#if (eq this._id ../cart.couponId)}}
          <div class="applied-coupon-badge" title="Currently Applied">
            <i class="fas fa-check"></i>
          </div>
          {{/if}}
          <div class="coupon-header">
            <span class="coupon-code">{{this.couponCode}}</span>
            <span class="coupon-discount">
              {{#if (eq this.discountType 'percentage')}}
              {{this.discountValue}}% OFF
              {{else}}
              ₹{{this.discountValue}} OFF
              {{/if}}
            </span>
          </div>
          <div class="coupon-details">
            {{#if (eq this.discountType 'percentage')}}
            Get {{this.discountValue}}% discount on your order
            {{else}}
            Get flat ₹{{this.discountValue}} discount on your order
            {{/if}}
          </div>
          <div class="coupon-min-purchase">
            Min. purchase: ₹{{this.minimumPurchaseAmount}}
          </div>
          {{#if (eq this._id ../cart.couponId)}}
          <button class="btn-apply-coupon" onclick="removeCoupon()">
            <i class="fas fa-times"></i> Remove Coupon
          </button>
          {{else}}
          <button class="btn-apply-coupon" onclick="applyCoupon('{{this._id}}')">
            <i class="fas fa-tag"></i> Apply Coupon
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}


      <div class="cart-items-section">
        <div class="cart-page-header">

          <h1 class="cart-page-title">
            Your Shopping Cart
          </h1>

          <p class="cart-page-subtitle">
            Review your selected products and proceed to secure checkout.
          </p>

        </div>
        <div class="cart-items">
          {{#if cart.items}}
          {{#each cart.items}}
          <div class="cart-item">
            <div class="item-image">
              <img src="{{this.productId.images.[0].path}}" alt="{{this.productId.name}}">
            </div>
            <div class="item-details">
              <h3>{{this.productId.name}}</h3>
              <p class="item-variation">
                {{#if (getDetail this.productId.details this.variationIndex "size")}}
                Size: {{getDetail this.productId.details this.variationIndex "size"}}
                {{else}}
                Size: Not Specified
                {{/if}}
              </p>
              <p class="price">
                ₹{{#if (getDetail this.productId.details this.variationIndex "price")}}
                {{getDetail this.productId.details this.variationIndex "price"}}
                {{else}}
                Price not available
                {{/if}} per unit
              </p>
              <div class="quantity-selector">
                <button class="btn-quantity decrement-quantity" data-product-id="{{this.productId._id}}"
                  data-variation-index="{{this.variationIndex}}" {{#if (lte this.quantity 1)}}disabled{{/if}}>
                  <i class="fas fa-minus"></i>
                </button>
                <input type="number" value="{{this.quantity}}" min="1" class="quantity-input"
                  data-product-id="{{this.productId._id}}" data-variation-index="{{this.variationIndex}}" readonly>
                <button class="btn-quantity increment-quantity" data-product-id="{{this.productId._id}}"
                  data-variation-index="{{this.variationIndex}}">
                  <i class="fas fa-plus"></i>
                </button>
              </div>
              <p class="total-price">
                Total: ₹{{multiply this.quantity (getDetail this.productId.details this.variationIndex "price")}}
              </p>
            </div>
            <button class="btn-remove remove-item" data-product-id="{{this.productId._id}}"
              data-variation-index="{{this.variationIndex}}">
              <i class="fas fa-trash"></i> Remove
            </button>
          </div>
          {{/each}}
          {{else}}
          <div class="empty-cart-message">
            <i class="fas fa-shopping-cart"></i>
            <h3>Your Cart is Empty</h3>
            <p>Looks like you haven't added anything to your cart yet</p>
            <a href="/user/home" class="btn-shop">
              <i class="fas fa-arrow-left"></i> Continue Shopping
            </a>
          </div>
          {{/if}}
        </div>
      </div>

      {{#if cart.items}}
      <div class="cart-summary-section">
        <div class="price-summary cart-summary">
          <h2>Order Summary</h2>
          <div class="summary-item">
            <span>Subtotal ({{cart.totalItems}} items)</span>
            <span>₹{{subtotal}}</span>
          </div>
          <div class="summary-item">
            <span>Shipping</span>
            {{#ifEquals shippingFee 0}}
            <span style="color: var(--success-color);">Free</span>
            {{else}}
            <span>₹{{shippingFee}}</span>
            {{/ifEquals}}
          </div>
          <div class="summary-item">
            <span>Tax</span>
            <span>₹{{tax}}</span>
          </div>



          {{#if cart.couponId}}
          <div class="summary-item">
            <span>Coupon Discount</span>
            <span style="color: var(--success-color);">-₹{{cart.couponDiscount}}</span>
          </div>
          {{/if}}

          {{#if cart.offerDiscount}}
          <div class="summary-item">
            <span>Discount For You</span>
            <span style="color: var(--success-color);">-₹{{cart.offerDiscount}}</span>
          </div>
          {{/if}}

          <div class="summary-item total">
            <span>Total Amount</span>
            <span>₹{{totalAmount}}</span>
          </div>
        </div>
        <button onclick="location.href='/user/addressInCart'" class="btn-checkout">
          <i class="fas fa-lock"></i> Proceed to Checkout
        </button>
      </div>
      {{else}}
      <div class="cart-summary-section">
        <div class="price-summary cart-summary">
          <h2>Order Summary</h2>
          <div class="summary-item">
            <span>Subtotal (0 items)</span>
            <span>₹0.00</span>
          </div>
          <div class="summary-item">
            <span>Shipping</span>
            <span>₹0.00</span>
          </div>
          <div class="summary-item">
            <span>Tax</span>
            <span>₹0.00</span>
          </div>
          <div class="summary-item total">
            <span>Total Amount</span>
            <span>₹0.00</span>
          </div>
        </div>
        <button class="btn-checkout" disabled>
          <i class="fas fa-lock"></i> Proceed to Checkout
        </button>
      </div>
      {{/if}}
    </div>
  </div>
</div>


{{#section 'scripts'}}
<script>
  document.addEventListener("DOMContentLoaded", function () {

    // Quantity adjustment buttons
    document.querySelectorAll(".btn-quantity").forEach((button) => {
      button.addEventListener("click", async function () {
        const productId = this.getAttribute("data-product-id");
        const variationIndex = this.getAttribute("data-variation-index");
        const isIncrement = this.classList.contains("increment-quantity");

        const quantityChange = isIncrement ? 1 : -1;

        try {
          const response = await fetch(`/user/cart/${productId}/${variationIndex}/${quantityChange}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ quantity: quantityChange }),
          });

          const data = await response.json();

          if (data.success) {
            location.reload();
          } else {
            showPopupMessage(data.message || "Operation failed", "error");
          }
        } catch (error) {
          console.error("Request failed:", error);
          showPopupMessage("Something went wrong. Please try again.", "error");
        }
      });
    });

    // Remove item buttons
    document.querySelectorAll(".btn-remove").forEach((button) => {
      button.addEventListener("click", async function () {
        const productId = this.getAttribute("data-product-id");
        const variationIndex = this.getAttribute("data-variation-index");

        try {
          const response = await fetch(`/user/cart/${productId}/${variationIndex}`, {
            method: "DELETE"
          });

          const data = await response.json();

          if (data.success) {
            location.reload();
          } else {
            showPopupMessage(data.message || "Failed to remove item", "error");
          }
        } catch (error) {
          console.error("Request failed:", error);
          showPopupMessage("Failed to remove item. Please try again.", "error");
        }
      });
    });
  });

  async function applyCoupon(couponId) {
    const couponCard = document.querySelector(`.coupon-card button[onclick="applyCoupon('${couponId}')"]`).closest('.coupon-card');
    const minPurchase = parseFloat(couponCard.querySelector('.coupon-min-purchase').textContent.replace('Min. purchase: ₹', ''));
    const currentSubtotal = parseFloat('{{subtotal}}');

    if (currentSubtotal < minPurchase) {
      showPopupMessage(`This coupon requires a minimum purchase of ₹${minPurchase}`, "error");
      return;
    }

    const confirmation = await Swal.fire({
      title: 'Apply Coupon?',
      html: `Are you sure you want to apply this coupon?<br><br>
              <strong>${couponCard.querySelector('.coupon-code').textContent}</strong><br>
              ${couponCard.querySelector('.coupon-discount').textContent}<br><br>
              Current discount will be replaced.`,
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Yes, apply it!',
      cancelButtonText: 'Cancel'
    });

    if (!confirmation.isConfirmed) return;

    try {
      const response = await fetch('/user/cart/apply-coupon', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          couponId: couponId,
        })
      });

      const data = await response.json();
      if (data.success) {
        location.reload();
      } else {
        showPopupMessage(data.message || 'Failed to apply coupon', 'error');
      }
    } catch (error) {
      console.error('Error applying coupon:', error);
      showPopupMessage('Failed to apply coupon. Please try again.', 'error');
    }
  }

  async function removeCoupon() {
    const confirmation = await Swal.fire({
      title: 'Remove Coupon?',
      text: 'Are you sure you want to remove the applied coupon?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Yes, remove it!',
      cancelButtonText: 'Cancel'
    });

    if (!confirmation.isConfirmed) return;

    try {
      const response = await fetch('/user/cart/remove-coupon', {
        method: 'DELETE'
      });

      const data = await response.json();
      if (data.success) {
        location.reload();
      } else {
        showPopupMessage(data.message || 'Failed to remove coupon', 'error');
      }
    } catch (error) {
      console.error('Error removing coupon:', error);
      showPopupMessage('Failed to remove coupon. Please try again.', 'error');
    }
  }

</script>

{{/section}}
