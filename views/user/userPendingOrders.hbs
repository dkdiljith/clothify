{{#section 'head'}}
<title>My Orders | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/userPendingOrders.css">
{{/section}}


<div class="orders-header">
    <h2 class="orders-title">
        <i class="fas fa-clipboard-list"></i> Order History
    </h2>
</div>

<div class="order-list">
    {{#if orders.length}}
    {{#each orders}}
    <div class="order-card {{#ifeq this.paymentStatus 'Failed'}}order-failed{{/ifeq}}">
        <div class="order-header">
            <div class="order-meta">
                <div class="order-meta-item">
                    <i class="far fa-calendar-alt"></i>
                    <span>Ordered on {{formatDate this.createdAt "MMM D, YYYY"}}</span>
                </div>
                <div class="order-meta-item">
                    <i class="fas fa-tag"></i>
                    <span>Order #{{this.orderId}}</span>
                </div>
                <div class="order-meta-item">
                    <i class="fas fa-wallet"></i>
                    <span>Total: ₹{{ this.totalAmount}}</span>
                </div>

                {{#ifeq this.paymentStatus "Failed"}}
                <div class="order-meta-item payment-failed-text">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Payment Failed</span>
                </div>

                <!-- FIX APPLIED: Changed ID attribute to be uniquely bound to the specific order loop index -->
                <button id="retryPayment-{{this.orderId}}" class="btn-retry-payment" data-order-id="{{this.orderId}}"
                    data-expires-at="{{this.paymentRetryExpiresAt}}"
                    data-attempts-count="{{this.paymentAttemptsCount}}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
                    </svg>
                    Retry Payment
                </button>
                {{/ifeq}}
            </div>
            <div class="order-status status-{{toLowerCase this.status}}">
                {{this.status}}
            </div>
        </div>

        <div class="order-items">
            {{#each this.items}}
            <div class="order-item">
                <div class="order-item-image">
                    <img src="{{this.productImg}}" alt="{{this.productName}}">
                </div>
                <div class="order-item-details">
                    <div class="order-item-name">{{this.productName}}</div>
                    <div class="order-item-attributes">
                        <span>Size: {{this.productSize}}</span>
                        <span>Qty: {{this.quantity}}</span>
                        <span>Price: ₹{{ this.productPrice}}</span>
                    </div>
                    <div class="order-item-price">
                        Total: ₹{{ multiply this.productPrice this.quantity}}
                    </div>
                </div>
                <div class="order-item-actions">
                    <a href="/user/orderDetails/{{../this._id}}/{{this._id}}?from=pending" class="view-details">
                        View Details <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{/each}}

    {{else}}
    <div class="no-orders">
        <div class="no-orders-icon">
            <i class="far fa-clipboard"></i>
        </div>
        <h3>No Pending Orders Currently Available</h3>
        <p>You don't have any orders waiting for payment verification right now.</p>
        <a href="/user/orders" class="shop-button">
            <i class="fas fa-shopping-bag"></i> Return to Orders
        </a>
    </div>

    {{/if}}
</div>

{{#if orders.length}}
<div style="display: flex; justify-content: center; margin-top: 20px; padding: 15px 0;">
    {{#if pagination.hasPrevPage}}
    <a href="/user/orders?page={{pagination.prevPage}}"
        style="padding: 8px 16px; margin: 0 5px; background-color: #3498db; color: white; text-decoration: none; border-radius: 4px;">
        <i class="fas fa-chevron-left"></i> Previous
    </a>
    {{/if}}

    <span style="padding: 8px 16px; margin: 0 5px;">
        Page {{pagination.page}} of {{pagination.totalPages}}
    </span>

    {{#if pagination.hasNextPage}}
    <a href="/user/orders?page={{pagination.nextPage}}"
        style="padding: 8px 16px; margin: 0 5px; background-color: #3498db; color: white; text-decoration: none; border-radius: 4px;">
        Next <i class="fas fa-chevron-right"></i>
    </a>
    {{/if}}
</div>
{{/if}}


{{#section 'scripts'}}
<script src="/javascripts/user/userPendingOrders.js" defer></script>
{{/section}}