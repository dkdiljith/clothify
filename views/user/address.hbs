<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Addresses | Clothify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --success-color: #2ecc71;
            --light-gray: #f8f9fa;
            --medium-gray: #e0e0e0;
            --dark-gray: #333;
            --white: #ffffff;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            color: var(--dark-gray);
            background-color: var(--light-gray);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .profile-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
        }

        .profile-container {
            display: flex;
            gap: 30px;
            background-color: var(--white);
            border-radius: 8px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .profile-sidebar {
            width: 250px;
            background-color: #f8f9fa;
            padding: 25px 0;
        }

        .profile-sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .profile-sidebar li {
            padding: 12px 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
        }

        .profile-sidebar li:hover {
            background-color: rgba(52, 152, 219, 0.1);
            color: var(--secondary-color);
        }

        .profile-sidebar li.active {
            background-color: rgba(52, 152, 219, 0.1);
            border-left: 3px solid var(--secondary-color);
            color: var(--secondary-color);
            font-weight: 500;
        }

        .profile-sidebar li i {
            width: 20px;
            text-align: center;
        }

        .profile-content {
            flex: 1;
            padding: 30px;
        }

        /* Addresses Content Styles */
        .addresses-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .addresses-title {
            font-size: 22px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            gap: 8px;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #2980b9;
        }

        .address-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .address-card {
            background-color: var(--white);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 25px;
            position: relative;
            border: 1px solid var(--medium-gray);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .address-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        }

        .address-card.default {
            border-left: 4px solid var(--secondary-color);
            background-color: rgba(52, 152, 219, 0.05);
        }

        .address-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .address-name {
            font-size: 18px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
        }

        .default-badge {
            background-color: var(--secondary-color);
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .address-details {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .address-field {
            display: flex;
            flex-direction: column;
        }

        .address-label {
            font-size: 13px;
            color: #666;
            margin-bottom: 3px;
        }

        .address-value {
            font-size: 15px;
            color: var(--dark-gray);
            word-break: break-word;
        }

        .address-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .btn-sm {
            padding: 8px 16px;
            font-size: 14px;
        }

        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--medium-gray);
            color: var(--dark-gray);
        }

        .btn-outline:hover {
            background-color: var(--light-gray);
        }

        .btn-danger {
            background-color: var(--accent-color);
            color: white;
        }

        .btn-danger:hover {
            background-color: #c0392b;
        }

        .no-addresses {
            text-align: center;
            padding: 40px 20px;
            color: #666;
        }

        .no-addresses-icon {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--medium-gray);
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .profile-container {
                flex-direction: column;
            }

            .profile-sidebar {
                width: 100%;
                padding: 15px 0;
            }

            .profile-sidebar ul {
                display: flex;
                overflow-x: auto;
                padding: 0 15px;
            }

            .profile-sidebar li {
                white-space: nowrap;
                border-left: none;
                border-bottom: 3px solid transparent;
                padding: 10px 15px;
            }

            .profile-sidebar li.active {
                border-left: none;
                border-bottom: 3px solid var(--secondary-color);
            }

            .address-details {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .addresses-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .address-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="container" style="margin-top:20px;">
        <div class="profile-header">
        </div>

        <div class="profile-container">
            <div class="profile-sidebar">
                <ul>
                    <li onclick="location.href='/user/profile'">
                        <i class="fas fa-user"></i> Profile
                    </li>
                    <li onclick="location.href='/user/security'">
                        <i class="fas fa-lock"></i> Security & Password
                    </li>
                    <li onclick="location.href='/user/wallet'">
                        <i class="fas fa-wallet"></i> Wallet
                    </li>
                    <li onclick="location.href='/user/orders'">
                        <i class="fas fa-shopping-bag"></i> Orders
                    </li>
                    <li class="active" onclick="location.href='/user/address'">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </li>
                    <li onclick="location.href='/user/deleteuser'">
                        <i class="fas fa-trash-alt"></i> Delete Account
                    </li>
                </ul>
            </div>

            <div class="profile-content">
                <div class="addresses-header">
                    <h2 class="addresses-title">
                        <i class="fas fa-map-marker-alt"></i> Saved Addresses
                    </h2>
                    <button onclick="location.href='/user/addaddress'" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add New Address
                    </button>
                </div>

                <div class="address-list">
                    {{#if addresses.length}}
                        {{#each addresses}}
                        <div class="address-card {{#if this.isDefault}}default{{/if}}">
                            <div class="address-header">
                                <h3 class="address-name">{{this.name}}</h3>
                                {{#if this.isDefault}}
                                <span class="default-badge">
                                    <i class="fas fa-check-circle"></i> Default
                                </span>
                                {{/if}}
                            </div>
                            
                            <div class="address-details">
                                <div class="address-field">
                                    <span class="address-label">Street Address</span>
                                    <span class="address-value">{{this.streetAddress}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">Landmark</span>
                                    <span class="address-value">{{#if this.landmark}}{{this.landmark}}{{else}}—{{/if}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">City</span>
                                    <span class="address-value">{{this.city}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">State</span>
                                    <span class="address-value">{{this.state}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">ZIP Code</span>
                                    <span class="address-value">{{this.zip}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">Country</span>
                                    <span class="address-value">{{this.country}}</span>
                                </div>
                                
                                <div class="address-field">
                                    <span class="address-label">Phone Number</span>
                                    <span class="address-value">{{this.phone}}</span>
                                </div>
                            </div>
                            
                            <div class="address-actions">
                                {{#unless this.isDefault}}
                                <button onclick="location.href='/user/setdefaultaddress/{{this._id}}'" class="btn btn-sm btn-primary">
                                    <i class="fas fa-check"></i> Set Default
                                </button>
                                {{/unless}}
                                
                                <button onclick="location.href='/user/editaddress/{{this._id}}'" class="btn btn-sm btn-outline">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                
                                <button onclick="confirmDelete('{{this._id}}')" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </div>
                        </div>
                        {{/each}}
                    {{else}}
                        <div class="no-addresses">
                            <div class="no-addresses-icon">
                                <i class="fas fa-map-marked-alt"></i>
                            </div>
                            <h3>No Saved Addresses</h3>
                            <p>You haven't saved any addresses yet. Add an address for faster checkout.</p>
                            <button onclick="location.href='/user/addaddress'" class="btn btn-primary" style="margin-top: 15px;">
                                <i class="fas fa-plus"></i> Add Address
                            </button>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete(addressId) {
            if (confirm('Are you sure you want to delete this address?')) {
                window.location.href = `/user/deleteaddress/${addressId}`;
            }
        }
    </script>
</body>
</html>