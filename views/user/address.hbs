{{#section 'head'}}
<title>My Addresses | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/address.css">
{{/section}}


<div class="container" style="margin-top:20px;">
    <div class="profile-header">
    </div>

    <div class="profile-container">
        <div class="profile-sidebar">
            <ul>
                <li onclick="location.href='/user/profile'">
                    <i class="fas fa-user"></i> Profile
                </li>
                <li onclick="location.href='/user/security'">
                    <i class="fas fa-lock"></i> Security & Password
                </li>
                <li onclick="location.href='/user/wallet'">
                    <i class="fas fa-wallet"></i> Wallet
                </li>
                <li onclick="location.href='/user/orders'">
                    <i class="fas fa-shopping-bag"></i> Orders
                </li>
                <li class="active" onclick="location.href='/user/address'">
                    <i class="fas fa-map-marker-alt"></i> Addresses
                </li>
                <li onclick="location.href='/user/deleteuser'">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </li>
            </ul>
        </div>

        <div class="profile-content">
            <div class="addresses-header">
                <h2 class="addresses-title">
                    <i class="fas fa-map-marker-alt"></i> Saved Addresses
                </h2>
                <button onclick="location.href='/user/addaddress'" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add New Address
                </button>
            </div>

            <div class="address-list">
                {{#if addresses.length}}
                {{#each addresses}}
                <div class="address-card {{#if this.isDefault}}default{{/if}}">
                    <div class="address-header">
                        <h3 class="address-name">{{this.name}}</h3>
                        {{#if this.isDefault}}
                        <span class="default-badge">
                            <i class="fas fa-check-circle"></i> Default
                        </span>
                        {{/if}}
                    </div>

                    <div class="address-details">
                        <div class="address-field">
                            <span class="address-label">Street Address</span>
                            <span class="address-value">{{this.streetAddress}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">Landmark</span>
                            <span class="address-value">{{#if
                                this.landmark}}{{this.landmark}}{{else}}—{{/if}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">City</span>
                            <span class="address-value">{{this.city}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">State</span>
                            <span class="address-value">{{this.state}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">ZIP Code</span>
                            <span class="address-value">{{this.zip}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">Country</span>
                            <span class="address-value">{{this.country}}</span>
                        </div>

                        <div class="address-field">
                            <span class="address-label">Phone Number</span>
                            <span class="address-value">{{this.phone}}</span>
                        </div>
                    </div>

                    <div class="address-actions">
                        {{#unless this.isDefault}}
                        <button onclick="location.href='/user/setdefaultaddress/{{this._id}}'"
                            class="btn btn-sm btn-primary">
                            <i class="fas fa-check"></i> Set Default
                        </button>
                        {{/unless}}

                        <button onclick="location.href='/user/editaddress/{{this._id}}'" class="btn btn-sm btn-outline">
                            <i class="fas fa-edit"></i> Edit
                        </button>

                      <button class="btn btn-sm btn-danger delete-btn" data-id="{{this._id}}">
    <i class="fas fa-trash-alt"></i> Delete
</button>

                    </div>
                </div>
                {{/each}}
                {{else}}
                <div class="no-addresses">
                    <div class="no-addresses-icon">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h3>No Saved Addresses</h3>
                    <p>You haven't saved any addresses yet. Add an address for faster checkout.</p>
                    <button onclick="location.href='/user/addaddress'" class="btn btn-primary"
                        style="margin-top: 15px;">
                        <i class="fas fa-plus"></i> Add Address
                    </button>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>


{{#section 'scripts'}}
<script src="/javascripts/user/address.js" defer></script>
{{/section}}