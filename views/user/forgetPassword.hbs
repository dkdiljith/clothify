<head>
  <link rel="stylesheet" type="text/css" href="/stylesheets/user/css/forgetPassword.css">
</head>

<body style="background: url('https://i.postimg.cc/T193YGg5/pexels-pavel-danilyuk-6461400.jpg') no-repeat center center fixed; background-size: cover; position: relative;">
  <img src="https://i.postimg.cc/Njc59RgL/Clothify-logo-white.png" alt="Clothify Logo" class="website-logo">

  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="login-card">
            <form id="forgotPasswordForm" action="/user/forgetpassword" method="post" novalidate>
              <input type="hidden" name="_csrf" value="{{csrfToken}}">
              {{#if resetTimer}}
              <input type="hidden" id="serverResetTimer" value="{{resetTimer}}">
              {{/if}}

              <h3 class="text-center">Forgot Password</h3>
              <p class="text-muted">Enter your email address below and we'll send you a link to reset your password.</p>
              
              <div class="form-group">
                <i class="fas fa-envelope"></i>
                <input type="email" name="email" id="email" class="form-control" placeholder="Enter Your Email Address" required>
                <div class="error-message" id="emailError"></div>
              </div>

              <div class="text-center text-lg-start mt-4 pt-2">
                <button id="sendButton" type="submit" class="btn btn-primary btn-lg w-100">
                  Send Email
                </button>
              </div>

              <div class="custom-links">
                <a href="/user/login">Back to Login <i class="fas fa-sign-in-alt"></i></a>
                <span>|</span>
                <a href="/user/register">Create Account</a>
              </div>
            </form>

            <div id="sentMessage" class="text-center mt-4" style="display: none;">
              <p>A password reset link has been sent to your email address.</p>
              <p>
                Resend Email: 
                <span id="resendText" style="color: #595959;">60</span> seconds
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/javascripts/user/js/forgetPassword.js"></script>
</body>


