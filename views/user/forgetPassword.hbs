{{#section 'head'}}
<link rel="stylesheet" href="/stylesheets/user/forgetPassword.css">
{{/section}}



<div class="forgot-password-background"
  style="background: url('https://i.postimg.cc/T193YGg5/pexels-pavel-danilyuk-6461400.jpg') no-repeat center center fixed; background-size: cover;">
  <!-- Logo -->
  <img src="https://i.postimg.cc/Njc59RgL/Clothify-logo-white.png" alt="Clothify Logo" class="website-logo">
  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="forgot-card">
            <form id="forgotPasswordForm" method="POST" novalidate>
              <h3 class="text-center mb-2">
                Reset Password
              </h3>
              <p class="text-muted text-center mb-4">
                Enter the email address associated with your account.
                We'll send you a verification code to reset your password.
              </p>
              <input type="hidden" id="errorCode" value="{{error}}">
              <!-- Email -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-envelope"></i>
                  <input type="email" id="email" name="email" class="form-control"
                    placeholder="Enter Your Email Address" value="{{email}}" autocomplete="email" maxlength="50" required>
                </div>
                <small id="emailError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Submit -->
              <button id="sendButton" type="submit" class="btn btn-primary-red btn-lg w-100">
                Send Verification Code
              </button>
              <div class="custom-links">
                <a href="/user/login">
                  <i class="fas fa-arrow-left me-2"></i>
                  Back to Login
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>




{{#section 'scripts'}}
<script src="/javascripts/user/forgetPassword.js" defer></script>
{{/section}}