<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Clothify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="/stylesheets/user/css/profileView.css">
  <link rel="stylesheet" type="text/css" href="/stylesheets/user/css/generalStyles.css">
</head>

<body>

    <div class="container" style="margin-top:20px;">
        <div class="profile-header">
        </div>

        <div class="profile-container">
            <div class="profile-sidebar">
                <ul>
                    <li class="active" onclick="location.href='/user/profile'">
                        <i class="fas fa-user"></i> Profile
                    </li>
                    <li onclick="location.href='/user/security'">
                        <i class="fas fa-lock"></i> Security & Password
                    </li>
                    <li onclick="location.href='/user/wallet'">
                        <i class="fas fa-wallet"></i> Wallet
                    </li>
                    <li onclick="location.href='/user/orders'">
                        <i class="fas fa-shopping-bag"></i> Orders
                    </li>
                    <li onclick="location.href='/user/address'">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </li>
                    <li onclick="location.href='/user/deleteuser'">
                        <i class="fas fa-trash-alt"></i> Delete Account
                    </li>
                </ul>
            </div>

            <div class="profile-content">
                <!-- Profile Header Section -->
                <div class="profile-header-section">
                    <div class="profile-picture-container">
                        <img src="{{#if userData.profileImage}}{{userData.profileImage}}{{else}}https://i.postimg.cc/2S8QdqmM/blue-circle-with-white-user-78370-4707.jpg{{/if}}"
                            alt="Profile Picture" class="profile-picture">
                        {{!-- <div class="profile-picture-upload" title="Change Photo">
                            <i class="fas fa-camera"></i>
                        </div> --}}
                    </div>
                    <div class="profile-info">
                        <h2 class="profile-name">{{#if userData.name}}{{userData.name}}{{else}}Your Name{{/if}}</h2>
                        <div class="profile-email">{{userData.email}}</div>
                        <div class="profile-stats">
                            <a href="/user/orders">
                                <div class="stat-item">
                                    <div class="stat-number">{{orderCount}}</div>
                                    <div class="stat-label">Orders</div>
                                </div>
                            </a>

                            <a href="/user/wishlist">
                                <div class="stat-item">
                                    <div class="stat-number">{{wishlistCount}}</div>
                                    <div class="stat-label">Wishlist</div>
                                </div>
                            </a>

                            <a href="/user/address">
                                <div class="stat-item">
                                    <div class="stat-number">{{addressCount}}</div>
                                    <div class="stat-label">Addresses</div>
                                </div>
                            </a>

                        </div>
                    </div>
                </div>

                <!-- Personal Information Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-user-circle"></i> Personal Information
                    </h2>

                    <div class="profile-details-grid">
                        <div class="detail-label">Full Name:</div>
                        <div class="detail-value" id="full-name">
                            {{#if userData.name}}
                            {{userData.name}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Mobile Number:</div>
                        <div class="detail-value" id="mobile-number">
                            {{#if userData.phone}}
                            {{userData.phone}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Email ID:</div>
                        <div class="detail-value" id="email">{{userData.email}}</div>

                        <div class="detail-label">Gender:</div>
                        <div class="detail-value" id="gender">
                            {{#if userData.gender}}
                            {{userData.gender}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Date of Birth:</div>
                        <div class="detail-value" id="dob">
                            {{#if userData.dateOfBirth}}
                            {{formatDate userData.dateOfBirth "YYYY-MM-DD"}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- Default Address Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-map-marker-alt"></i> Default Address
                    </h2>

                    <div class="profile-details-grid">
                        <div class="detail-label">Address:</div>
                        <div class="detail-value" id="location">
                            {{#if address}}
                            <div class="address-details">
                                <div class="address-line"><strong>Address Name:</strong> {{address.name}}</div>
                                <div class="address-line"><strong>Street Address:</strong> {{address.streetAddress}}
                                </div>
                                {{#if address.landmark}}
                                <div class="address-line"><strong>Landmark:</strong> {{address.landmark}}</div>
                                {{/if}}
                                <div class="address-line"><strong>City:</strong> {{address.city}}</div>
                                <div class="address-line"><strong>State:</strong> {{address.state}}</div>
                                <div class="address-line"><strong>Zip Code:</strong> {{address.zip}}</div>
                                <div class="address-line"><strong>Phone:</strong> {{address.phone}}</div>
                            </div>
                            {{else}}
                            <div class="empty-state">
                                <i class="fas fa-map-marked-alt"></i>
                                <p>No default address set</p>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                </div>

                {{#if showActivity}}
                <!-- Recent Activity Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-clock"></i> Recent Activity
                    </h2>
                    <div class="activity-list">
                        {{#if recentActivity.length}}
                        {{#each recentActivity}}
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="fas fa-{{this.icon}}"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">{{this.title}}</div>
                                <div class="activity-date">{{formatDate this.date "MMMM D, YYYY [at] h:mm A"}}</div>
                            </div>
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="empty-state">
                            <i class="fas fa-clock"></i>
                            <p>No recent activity found</p>
                        </div>
                        {{/if}}
                    </div>
                </div>
                {{/if}}

                <!-- Profile Actions -->
                <div class="profile-actions">
                    <button onclick="location.href='/user/profileedit'" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Edit Profile
                    </button>
                    <button onclick="location.href='/user/address'" class="btn btn-secondary">
                        <i class="fas fa-map-marker-alt"></i> Manage Addresses
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script>
        // Profile picture upload functionality
        document.querySelector('.profile-picture-upload').addEventListener('click', function () {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';

            input.onchange = async (e) => {
                const file = e.target.files[0];
                if (file) {
                    const formData = new FormData();
                    formData.append('profileImage', file);

                    try {
                        const response = await fetch('/user/upload-profile-image', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (data.success) {
                            document.querySelector('.profile-picture').src = data.imageUrl;
                            showPopupMessage('Profile picture updated successfully', 'success');
                        } else {
                            showPopupMessage(data.message || 'Failed to upload image', 'error');
                        }
                    } catch (error) {
                        console.error('Error uploading image:', error);
                       showPopupMessage('An error occurred. Please try again.', 'error');
                    }
                }
            };

            input.click();
        });

    </script>
</body>

</html>