<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Clothify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --success-color: #2ecc71;
            --light-gray: #f8f9fa;
            --medium-gray: #e0e0e0;
            --dark-gray: #333;
            --white: #ffffff;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            color: var(--dark-gray);
            background-color: var(--light-gray);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .profile-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0;
        }

        .profile-container {
            display: flex;
            gap: 30px;
            background-color: var(--white);
            border-radius: 8px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .profile-sidebar {
            width: 250px;
            background-color: #f8f9fa;
            padding: 25px 0;
        }

        .profile-sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .profile-sidebar li {
            padding: 12px 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 3px solid transparent;
        }

        .profile-sidebar li:hover {
            background-color: rgba(52, 152, 219, 0.1);
            color: var(--secondary-color);
        }

        .profile-sidebar li.active {
            background-color: rgba(52, 152, 219, 0.1);
            border-left: 3px solid var(--secondary-color);
            color: var(--secondary-color);
            font-weight: 500;
        }

        .profile-sidebar li i {
            width: 20px;
            text-align: center;
        }

        .profile-content {
            flex: 1;
            padding: 30px;
        }

        /* Profile Header Section */
        .profile-header-section {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--medium-gray);
        }

        .profile-picture-container {
            position: relative;
            width: 150px;
            height: 150px;
        }

        .profile-picture {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--secondary-color);
            box-shadow: var(--shadow);
        }

        .profile-picture-upload {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: var(--secondary-color);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--shadow);
        }

        .profile-picture-upload:hover {
            background-color: #2980b9;
            transform: scale(1.1);
        }

        .profile-info {
            flex: 1;
        }

        .profile-name {
            font-size: 28px;
            font-weight: 600;
            color: var(--primary-color);
            margin: 0 0 8px 0;
        }

        .profile-email {
            color: #666;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .profile-stats {
            display: flex;
            gap: 20px;
        }

        .stat-item {
            text-align: center;
            padding: 12px 20px;
            background-color: var(--light-gray);
            border-radius: 8px;
            min-width: 90px;
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow);
        }

        .stat-number {
            font-size: 20px;
            font-weight: 600;
            color: var(--primary-color);
        }

        .stat-label {
            font-size: 13px;
            color: #666;
            text-transform: uppercase;
            margin-top: 5px;
            letter-spacing: 0.5px;
        }

        /* Profile Details Section */
        .profile-section-title {
            color: var(--primary-color);
            font-size: 22px;
            margin-bottom: 20px;
            font-weight: 600;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--medium-gray);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile-section-title i {
            color: var(--secondary-color);
        }

        .profile-details-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .detail-card {
            background-color: var(--white);
            border-radius: 10px;
            padding: 25px;
            box-shadow: var(--shadow);
            margin-bottom: 25px;
        }

        .detail-label {
            font-weight: 500;
            color: var(--primary-color);
            padding: 10px 0;
            font-size: 15px;
        }

        .detail-value {
            padding: 10px 0;
            color: var(--dark-gray);
            word-break: break-word;
            font-size: 16px;
        }

        .detail-value.empty {
            color: #999;
            font-style: italic;
        }

        .address-details {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-top: 10px;
            border: 1px solid var(--medium-gray);
        }

        .address-line {
            margin-bottom: 8px;
            line-height: 1.5;
        }

        .address-line strong {
            color: var(--primary-color);
            min-width: 100px;
            display: inline-block;
        }

        /* Recent Activity */
        .activity-list {
            margin-top: 20px;
        }

        .activity-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid var(--medium-gray);
            transition: all 0.3s ease;
        }

        .activity-item:hover {
            background-color: rgba(52, 152, 219, 0.05);
            padding-left: 10px;
        }

        .activity-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background-color: rgba(52, 152, 219, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary-color);
            font-size: 18px;
        }

        .activity-content {
            flex: 1;
        }

        .activity-title {
            font-weight: 500;
            margin-bottom: 5px;
            color: var(--primary-color);
        }

        .activity-date {
            font-size: 13px;
            color: #666;
        }

        /* Profile Actions */
        .profile-actions {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            gap: 8px;
            font-size: 15px;
        }

        .btn-primary {
            background-color: var(--secondary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .btn-secondary {
            background-color: var(--medium-gray);
            color: var(--dark-gray);
        }

        .btn-secondary:hover {
            background-color: #bdc3c7;
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 30px;
            color: #666;
        }

        .empty-state i {
            font-size: 40px;
            color: var(--medium-gray);
            margin-bottom: 15px;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .toast {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            border-radius: 6px;
            box-shadow: var(--shadow);
            margin-bottom: 10px;
            color: white;
            transform: translateX(100%);
            opacity: 0;
            transition: all 0.3s ease;
            max-width: 350px;
        }

        .toast.show {
            transform: translateX(0);
            opacity: 1;
        }

        .toast-success {
            background-color: var(--success-color);
        }

        .toast-error {
            background-color: var(--accent-color);
        }

        .toast-icon {
            margin-right: 12px;
            font-size: 20px;
        }

        .toast-message {
            flex: 1;
        }

        .toast-close {
            margin-left: 12px;
            cursor: pointer;
            opacity: 0.8;
        }

        .toast-close:hover {
            opacity: 1;
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .profile-container {
                flex-direction: column;
            }

            .profile-sidebar {
                width: 100%;
                padding: 15px 0;
            }

            .profile-sidebar ul {
                display: flex;
                overflow-x: auto;
                padding: 0 15px;
            }

            .profile-sidebar li {
                white-space: nowrap;
                border-left: none;
                border-bottom: 3px solid transparent;
                padding: 10px 15px;
            }

            .profile-sidebar li.active {
                border-left: none;
                border-bottom: 3px solid var(--secondary-color);
            }

            .profile-header-section {
                flex-direction: column;
                text-align: center;
            }

            .profile-stats {
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            .profile-details-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .detail-label {
                padding-bottom: 0;
            }

            .profile-actions {
                flex-direction: column;
            }

            .profile-picture-container {
                width: 120px;
                height: 120px;
                margin: 0 auto;
            }
        }

        @media (max-width: 576px) {
            .profile-stats {
                flex-wrap: wrap;
                justify-content: center;
            }

            .stat-item {
                min-width: 80px;
                padding: 10px 15px;
            }
        }
    </style>
</head>

<body>
    
    <div class="container" style="margin-top:20px;">
        <div class="profile-header">
        </div>

        <div class="profile-container">
            <div class="profile-sidebar">
                <ul>
                    <li class="active" onclick="location.href='/user/profile'">
                        <i class="fas fa-user"></i> Profile
                    </li>
                    <li onclick="location.href='/user/security'">
                        <i class="fas fa-lock"></i> Security & Password
                    </li>
                    <li onclick="location.href='/user/wallet'">
                        <i class="fas fa-wallet"></i> Wallet
                    </li>
                    <li onclick="location.href='/user/orders'">
                        <i class="fas fa-shopping-bag"></i> Orders
                    </li>
                    <li onclick="location.href='/user/address'">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </li>
                    <li onclick="location.href='/user/deleteuser'">
                        <i class="fas fa-trash-alt"></i> Delete Account
                    </li>
                </ul>
            </div>

            <div class="profile-content">
                <!-- Profile Header Section -->
                <div class="profile-header-section">
                    <div class="profile-picture-container">
                        <img src="{{#if userData.profileImage}}{{userData.profileImage}}{{else}}https://i.postimg.cc/2S8QdqmM/blue-circle-with-white-user-78370-4707.jpg{{/if}}"
                            alt="Profile Picture" class="profile-picture">
                        <div class="profile-picture-upload" title="Change Photo">
                            <i class="fas fa-camera"></i>
                        </div>
                    </div>
                    <div class="profile-info">
                        <h2 class="profile-name">{{#if userData.name}}{{userData.name}}{{else}}Your Name{{/if}}</h2>
                        <div class="profile-email">{{userData.email}}</div>
                        <div class="profile-stats">
                            <div class="stat-item">
                                <div class="stat-number">{{orderCount}}</div>
                                <div class="stat-label">Orders</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-number">{{wishlistCount}}</div>
                                <div class="stat-label">Wishlist</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-number">{{addressCount}}</div>
                                <div class="stat-label">Addresses</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personal Information Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-user-circle"></i> Personal Information
                    </h2>

                    <div class="profile-details-grid">
                        <div class="detail-label">Full Name:</div>
                        <div class="detail-value" id="full-name">
                            {{#if userData.name}}
                            {{userData.name}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Mobile Number:</div>
                        <div class="detail-value" id="mobile-number">
                            {{#if userData.phone}}
                            {{userData.phone}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Email ID:</div>
                        <div class="detail-value" id="email">{{userData.email}}</div>

                        <div class="detail-label">Gender:</div>
                        <div class="detail-value" id="gender">
                            {{#if userData.gender}}
                            {{userData.gender}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>

                        <div class="detail-label">Date of Birth:</div>
                        <div class="detail-value" id="dob">
                            {{#if userData.dateOfBirth}}
                            {{formatDate userData.dateOfBirth "YYYY-MM-DD"}}
                            {{else}}
                            <span class="empty">Not added</span>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- Default Address Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-map-marker-alt"></i> Default Address
                    </h2>

                    <div class="profile-details-grid">
                        <div class="detail-label">Address:</div>
                        <div class="detail-value" id="location">
                            {{#if address}}
                            <div class="address-details">
                                <div class="address-line"><strong>Address Name:</strong> {{address.name}}</div>
                                <div class="address-line"><strong>Street Address:</strong> {{address.streetAddress}}</div>
                                {{#if address.landmark}}
                                <div class="address-line"><strong>Landmark:</strong> {{address.landmark}}</div>
                                {{/if}}
                                <div class="address-line"><strong>City:</strong> {{address.city}}</div>
                                <div class="address-line"><strong>State:</strong> {{address.state}}</div>
                                <div class="address-line"><strong>Zip Code:</strong> {{address.zip}}</div>
                                <div class="address-line"><strong>Phone:</strong> {{address.phone}}</div>
                            </div>
                            {{else}}
                            <div class="empty-state">
                                <i class="fas fa-map-marked-alt"></i>
                                <p>No default address set</p>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                </div>

                {{#if showActivity}}
                <!-- Recent Activity Section -->
                <div class="detail-card">
                    <h2 class="profile-section-title">
                        <i class="fas fa-clock"></i> Recent Activity
                    </h2>
                    <div class="activity-list">
                        {{#if recentActivity.length}}
                        {{#each recentActivity}}
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="fas fa-{{this.icon}}"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-title">{{this.title}}</div>
                                <div class="activity-date">{{formatDate this.date "MMMM D, YYYY [at] h:mm A"}}</div>
                            </div>
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="empty-state">
                            <i class="fas fa-clock"></i>
                            <p>No recent activity found</p>
                        </div>
                        {{/if}}
                    </div>
                </div>
                {{/if}}

                <!-- Profile Actions -->
                <div class="profile-actions">
                    <button onclick="location.href='/user/profileedit'" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Edit Profile
                    </button>
                    <button onclick="location.href='/user/address'" class="btn btn-secondary">
                        <i class="fas fa-map-marker-alt"></i> Manage Addresses
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script>
        // Profile picture upload functionality
        document.querySelector('.profile-picture-upload').addEventListener('click', function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';

            input.onchange = async (e) => {
                const file = e.target.files[0];
                if (file) {
                    const formData = new FormData();
                    formData.append('profileImage', file);

                    try {
                        const response = await fetch('/user/upload-profile-image', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (data.success) {
                            document.querySelector('.profile-picture').src = data.imageUrl;
                            showToast('Profile picture updated successfully', 'success');
                        } else {
                            showToast(data.message || 'Failed to upload image', 'error');
                        }
                    } catch (error) {
                        console.error('Error uploading image:', error);
                        showToast('An error occurred. Please try again.', 'error');
                    }
                }
            };

            input.click();
        });

        // Show toast notification
        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} toast-icon"></i>
                <div class="toast-message">${message}</div>
                <i class="fas fa-times toast-close" onclick="this.parentElement.remove()"></i>
            `;
            
            const toastContainer = document.getElementById('toastContainer');
            toastContainer.appendChild(toast);
            
            // Show toast
            setTimeout(() => toast.classList.add('show'), 10);
            
            // Auto-remove after 5 seconds
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 5000);
        }
    </script>
</body>
</html>