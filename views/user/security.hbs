{{#section 'head'}}
<title>Security & Password | Clothify</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/user/security.css">
{{/section}}


<div class="container" style="margin-top:20px;">
    <div class="profile-header">

    </div>

    <div class="profile-container">
        <div class="profile-sidebar">
            <ul>
                <li onclick="location.href='/user/profile'">
                    <i class="fas fa-user"></i> Profile
                </li>
                <li class="active" onclick="location.href='/user/security'">
                    <i class="fas fa-lock"></i> Security & Password
                </li>
                <li onclick="location.href='/user/wallet'">
                    <i class="fas fa-wallet"></i> Wallet
                </li>
                <li onclick="location.href='/user/orders'">
                    <i class="fas fa-shopping-bag"></i> Orders
                </li>
                <li onclick="location.href='/user/orders?retryPendingOrder=true'">
                    <i class="fas fa-shopping-bag"></i> Pending Orders
                </li>
                <li onclick="location.href='/user/address'">
                    <i class="fas fa-map-marker-alt"></i> Addresses
                </li>
                <li onclick="location.href='/user/deleteuser'">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </li>
            </ul>
        </div>

        <div class="profile-content">
            <!-- Security Status -->
            <div class="security-status">
                <i class="fas fa-shield-alt"></i>
                <div>
                    <h3 style="margin: 0 0 5px 0;">Your account security is strong</h3>
                    {{!-- <p style="margin: 0; color: #666;">Last updated: {{formatDate user.updatedAt}}</p> --}}
                </div>
            </div>

            <!-- Password Reset Card -->
            <div class="security-card">
                <h2 class="security-section-title">
                    <i class="fas fa-key" style="margin-right: 10px;"></i>Change Password
                </h2>

                <form id="resetPasswordForm" novalidate>
                    <input type="hidden" id="token" name="token" value="{{token}}">

                    <div class="form-group">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <div class="input-group">
                            <input type="password" id="currentPassword" name="currentPassword" class="form-control"
                                required>
                            <i class="fas fa-eye password-toggle"></i>
                        </div>
                        <div id="currentPasswordError" class="error-message"></div>
                    </div>

                    <div class="form-group">
                        <label for="newPassword" class="form-label">New Password</label>
                        <div class="input-group">
                            <input type="password" id="newPassword" name="newPassword" class="form-control" required>
                            <i class="fas fa-eye password-toggle"></i>
                        </div>
                        <div class="password-strength">
                            <div class="password-strength-bar" id="passwordStrengthBar"></div>
                        </div>
                        <div id="passwordStrengthText" style="font-size: 12px; margin-top: 5px; color: #666;"></div>
                        <div class="password-requirements">
                            <p>Password must contain:</p>
                            <ul>
                                <li id="req-length">At least 8 characters</li>
                                <li id="req-uppercase">One uppercase letter</li>
                                <li id="req-number">One number</li>
                                <li id="req-special">One special character</li>
                            </ul>
                        </div>
                        <div id="newPasswordError" class="error-message"></div>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <div class="input-group">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control"
                                required>
                            <i class="fas fa-eye password-toggle"></i>
                        </div>
                        <div id="confirmPasswordError" class="error-message"></div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
                        <span class="spinner" id="submitSpinner"></span>
                        <i class="fas fa-sync-alt" id="submitIcon"></i>
                        Update Password
                    </button>
                    <div id="formMessage" class="success-message"></div>
                </form>
            </div>
        </div>
    </div>
</div>


{{#section 'scripts'}}
<script src="/javascripts/user/security.js" defer></script>
{{/section}}