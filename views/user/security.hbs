{{#section 'head'}}
<title>Privacy & Security | Clothify</title>
<link rel="stylesheet" href="/stylesheets/user/security.css">
{{/section}}



<div class="security-page">
    <!-- ==========================================
                    HEADER
    =========================================== -->
    <div class="security-header">
        <div class="security-header-icon">
            <i class="fas fa-shield-alt"></i>
        </div>
        <div class="security-header-content">
            <h2>Security Center</h2>
            <p>
                Manage your account security and keep your Clothify account protected.
            </p>
        </div>
    </div>
    <!-- ==========================================
                PASSWORD FEATURE CARD
    =========================================== -->
    <div class="security-feature-card">
        <div class="feature-top">
            <div class="feature-icon">
                {{#if hasPassword}}
                <i class="fas fa-lock"></i>
                {{else}}
                <i class="fab fa-google"></i>
                {{/if}}
            </div>
            <div class="feature-content">
                {{#if hasPassword}}
                <span class="status-badge success">
                    <i class="fas fa-circle"></i>
                    Active
                </span>
                <h3>Password Protection</h3>
                <p>
                    Your Clothify account is protected with a password.
                    To change it, we'll first verify your identity using your registered email address.
                </p>
                {{else}}
                <span class="status-badge warning">
                    <i class="fas fa-circle"></i>
                    Google Sign-In
                </span>
                <h3>No Password Created</h3>
                <p>
                    Your account was created using Google Sign-In.
                    Create a password to sign in using either Google or your email and password.
                </p>
                {{/if}}
            </div>
        </div>
        <!-- ==========================================
                    FEATURES
        =========================================== -->
        <div class="security-features">
            <div class="security-item">
                <i class="fas fa-envelope-open-text"></i>
                <span>Email verification before password reset</span>
            </div>
            <div class="security-item">
                <i class="fas fa-lock"></i>
                <span>Passwords are securely encrypted</span>
            </div>
            <div class="security-item">
                <i class="fas fa-user-shield"></i>
                <span>Single-use secure verification link</span>
            </div>
        </div>
        <!-- ==========================================
                    ACTION BUTTON
        =========================================== -->
        <button id="changePasswordButton" class="change-password-btn">
            <i class="fas fa-key"></i>
            {{#if hasPassword}}
            Change Password
            {{else}}
            Create Password
            {{/if}}
        </button>
    </div>
</div>



{{#section 'scripts'}}
<script src="/javascripts/user/security.js" defer></script>
{{/section}}