{{#section "head"}}
<link rel="stylesheet" href="/stylesheets/user/register.css" />
{{/section}}
<div class="register-background"
  style="background: url('https://i.postimg.cc/GptyXvpN/pexels-badun-17097094.jpg') no-repeat center center fixed; background-size: cover; position: relative;">
  <!-- Website Logo -->
  <img src="https://i.postimg.cc/Njc59RgL/Clothify-logo-white.png" alt="Clothify Logo" class="website-logo" />
  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="registration-card">
            <form id="registrationForm" action="/user/register" method="POST" novalidate autocomplete="on">
              <h3 class="text-center mb-4">
                Create Your Account
              </h3>
              {{#if message}}
              <div class="userController-error-message">
                {{message}}
              </div>
              {{/if}}
              <!-- Full Name -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-user"></i>
                  <input type="text" id="name" name="name" class="form-control" placeholder="Full Name"
                    autocomplete="name" minlength="5" maxlength="20" required />
                </div>
                <small id="nameError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Email -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-envelope"></i>
                  <input type="email" id="email" name="email" class="form-control" placeholder="Email Address"
                    autocomplete="email" spellcheck="false" maxlength="50" required />
                </div>
                <small id="emailError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Password -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-lock"></i>
                  <input type="password" id="password" name="password" class="form-control"
                    placeholder="Create Password" autocomplete="new-password" minlength="8" maxlength="20" required />
                  <i id="togglePassword" class="fas fa-eye password-toggle" aria-label="Show password" role="button"
                    tabindex="0">
                  </i>
                </div>
                <small id="passwordError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Confirm Password -->
              <div class="form-group">
                <div class="input-wrapper">
                  <i class="fas fa-lock"></i>
                  <input type="password" id="confirmPassword" name="confirmPassword" class="form-control"
                    placeholder="Confirm Password" autocomplete="new-password" minlength="8" maxlength="20" required />
                  {{!-- <i id="toggleConfirmPassword" class="fas fa-eye password-toggle" aria-label="Show confirm password"
                    role="button" tabindex="0">
                  </i> --}}
                </div>
                <small id="confirmPasswordError" class="error-message hidden" aria-live="polite">
                </small>
              </div>
              <!-- Register Button -->
              <button type="submit" class="btn btn-primary-red btn-lg w-100">
                Sign Up
              </button>
              <!-- Login Link -->
              <div class="custom-links">
                <a href="/user/login">
                  <i class="fas fa-arrow-left me-2"></i>
                  Back to Login
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{{#section "scripts"}}
<script src="/javascripts/user/register.js" defer></script>
{{/section}}