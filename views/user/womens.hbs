<h1 style="margin-left:180px;">Womens</h1>
<br><br>
<section>
  <div class="container">  <!-- Ensures spacing on both sides -->
    <div class="row isotope-grid justify-content-center">  <!-- Centers content -->
      {{#each product}}
        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item women">
          <div class="card">
            <div class="block2-pic hov-img0">
              <img src="{{this.images.[0].path}}" alt="{{this.name}}" class="card-img-top fixed-image"> 

              <a href="#" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-show-modal1">
                Quick View
              </a>
            </div>

            <div class="card-body">
              <h5 class="card-title">
                <a href="/user/singleproduct/{{this._id}}" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2">
                  {{this.name}}
                </a>
              </h5>

              <p class="card-text stext-105 cl3">
                ${{this.details.[0].price}}
              </p>

              <div class="block2-txt-child2 flex-r p-t-3">
                <a href="#" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2">
                  <img class="icon-heart1 dis-block trans-04" src="/images/user/images/icons/icon-heart-01.png" alt="ICON">
                  <img class="icon-heart2 dis-block trans-04 ab-t-l" src="/images/user/images/icons/icon-heart-02.png" alt="ICON">
                </a>
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</section>
<br><br>
