<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/activity-log.css" />
    <script src="/javascripts/admin/admin-sidebar.js" defer></script>
</head>
<!-- Activity Log Section -->
<div class="section-container">
    <div class="section-header">
        <h2 class="page-title">Activity Log</h2>
        <div class="action-controls">
            <div class="search-filter">
                {{!-- <input type="text" placeholder="Search activities..." class="search-input"> --}}
                <form method="GET" action='/user/collections' role="search">
                    <div class="search-container">
                        <input type="search" name="query" class="search-input" id="search-input"
                            placeholder="Search activities..." {{#if query}} value={{query}} {{/if}}>
                    </div>
                </form>

                <select class="filter-select">
                    <option value="all">All Actions</option>
                    <option value="product">Product Changes</option>
                    <option value="order">Order Updates</option>
                    <option value="user">User Modifications</option>
                </select>
                <button class="filter-btn">Apply</button>
            </div>
        </div>
    </div>

    <div class="activity-log-container">
        <table class="activity-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action Type</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Changes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>2023-11-15 14:30</td>
                    <td><span class="status-badge badge-product">Product Update</span></td>
                    <td>Nike Air Max (ID: 65a3b...)</td>
                    <td>Price changed from $120 to $110</td>
                    <td><button class="view-details-btn">View Details</button></td>
                </tr>
                <tr>
                    <td>2023-11-15 14:25</td>
                    <td><span class="status-badge badge-order">Order Update</span></td>
                    <td>Order #12345</td>
                    <td>Status changed to "Shipped"</td>
                    <td><button class="view-details-btn">View Details</button></td>
                </tr>
                <tr>
                    <td>2023-11-15 14:20</td>
                    <td><span class="status-badge badge-user">User Modified</span></td>
                    <td>john.doe@email.com</td>
                    <td>Password reset initiated</td>
                    <td><button class="view-details-btn">View Details</button></td>
                </tr>
                <tr>
                    <td>2023-11-15 13:45</td>
                    <td><span class="status-badge badge-product">New Product</span></td>
                    <td>Adidas Ultraboost</td>
                    <td>New product added to inventory</td>
                    <td><button class="view-details-btn">View Details</button></td>
                </tr>
                <tr>
                    <td>2023-11-15 12:30</td>
                    <td><span class="status-badge badge-promo">Promotion</span></td>
                    <td>Black Friday Sale</td>
                    <td>Discount set to 30%</td>
                    <td><button class="view-details-btn">View Details</button></td>
                </tr>
            </tbody>
        </table>

        <div class="pagination-controls">
            <button class="pagination-btn" disabled>Previous</button>
            <span class="page-info">Page 1 of 5</span>
            <button class="pagination-btn">Next</button>
        </div>
    </div>
</div>