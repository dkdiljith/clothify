{{#section 'head'}}
<title>Order #{{order.orderId}} | Admin Dashboard</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/orderDetails.css">
{{/section}}
<main class="dashboard-container" style="background:#F2F2F2;">
    <div class="container-fluid py-4">
        <!-- Order Header -->
        <div class="order-header d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <div class="d-flex align-items-center gap-3">
                    <h1 class="h4 mb-0 fw-bold text-gray-800">Order #{{order.orderId}}</h1>
                    <span class="badge bg-primary">Total Items: {{order.items.length}}</span>
                </div>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    <span class="text-muted"><i class="far fa-calendar-alt me-1"></i> Placed on {{formatDate
                        order.createdAt}}</span>
                    <span class="text-muted"><svg class="admin-icon me-1" xmlns="http://w3.org" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                            stroke-linejoin="round">
                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                        </svg>
                        Last updated: {{formatDate
                        order.updatedAt}}</span>
                </div>
            </div>
            <div>
                <button id="download-invoice-button" class="btn btn-secondary" data-order-id="{{order._id}}">
                    Download Invoice
                </button>
                <a href="/admin/orders" class="btn btn-outline-secondary">
                    <svg class="admin-icon me-2" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                        </path>
                        <path d="M2 10h20"></path>
                    </svg>
                    Back to Orders
                </a>
            </div>
        </div>
        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-8">
                <!-- Order Items Card -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><svg class="admin-icon me-2" xmlns="http://w3.org" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Order Items</h5>
                        <span class="badge bg-primary">{{order.items.length}} items</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr class="{{#if (eq order.paymentStatus 'Failed')}}bg-danger text-white{{/if}}">
                                        <th style="width: 100px;">Item</th>
                                        <th>Product Details</th>
                                        <th style="width: 200px;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each order.items}}
                                    <tr class="{{#if (eq this.status 'Return Requested')}}alert-row{{/if}}">
                                        <td data-label="Item">
                                            <div class="product-img-container">
                                                <img src="{{this.productImg}}" alt="{{this.productName}}"
                                                    class="product-img">
                                                {{#if (eq this.status 'Return Requested')}}
                                                <div class="attention-required"
                                                    title="Return Request - Requires Action">
                                                    <svg class="admin-icon" xmlns="http://w3.org" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2.5"
                                                        stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="10"></circle>
                                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                    </svg>
                                                </div>
                                                {{/if}}
                                            </div>
                                        </td>
                                        <td data-label="Product Details">
                                            <div class="d-flex flex-column">
                                                <strong>
                                                    {{this.productName}}
                                                </strong>
                                                <small class="text-muted mb-1">
                                                    ₹{{this.productPrice}}
                                                    ×
                                                    {{this.quantity}}
                                                    |
                                                    Size:
                                                    {{this.productSize}}
                                                </small>
                                                {{#if this.refundDetails.refundType}}
                                                <div class="mt-2 small">
                                                    <div>
                                                        {{#ifEquals this.refundDetails.refundType "Returned"}}
                                                        <span class="text-success">
                                                            ↩ Returned
                                                        </span>
                                                        {{else}}
                                                        <span class="text-danger">
                                                            ✖ Cancelled
                                                        </span>
                                                        {{/ifEquals}}
                                                    </div>
                                                    <div class="text-muted">
                                                        {{#ifEquals this.refundDetails.refundAmountStatus "Refunded"}}
                                                        Refunded :
                                                        <strong>
                                                            ₹{{this.refundDetails.refundAmount}}
                                                        </strong>
                                                        {{else}}
                                                        No Refund Required
                                                        {{/ifEquals}}
                                                    </div>
                                                </div>
                                                {{/if}}
                                                {{#if this.returnReason.length}}
                                                <div class="return-reason-box">
                                                    <strong class="d-block mb-1">
                                                        Return Reason
                                                    </strong>
                                                    <p class="mb-0 small">
                                                        {{this.returnReason.[0].reason}}
                                                    </p>
                                                </div>
                                                {{/if}}
                                            </div>
                                        </td>
                                        <td data-label="Status">
                                            <div class="d-flex flex-column">
                                                {{#if (eq ../order.paymentStatus "Failed")}}
                                                <select class="form-select form-select-sm mb-2" disabled>
                                                    <option selected>Cancelled</option>
                                                </select>
                                                <span class="status-badge bg-danger text-white align-self-start">
                                                    Payment Failed </span>
                                                {{else}}
                                                {{#if (or (eq this.status "Return Requested") (eq this.status "Return
                                                Accepted") (eq this.status "Return Rejected") (eq this.status
                                                "Returned") )}}
                                                <!-- First Dropdown: Return Processing Workflow -->
                                                <select class="form-select form-select-sm mb-2 status-dropdown"
                                                    data-item-id="{{this._id}}" data-order-id="{{../order._id}}" {{#if
                                                    (or (eq this.status "Returned" ) (eq this.status "Cancelled" ) (eq
                                                    this.status "Return Rejected" ) ) }} disabled {{/if}}>
                                                    <!-- FIX: Only show/select the empty placeholder if the status is NOT "Returned" or "Return Rejected" -->
                                                    {{#if (and (not (eq this.status "Returned")) (not (eq this.status
                                                    "Return Rejected")))}}
                                                    <option value="" disabled selected>Accept or Reject Return</option>
                                                    {{/if}}
                                                    <option value="Return Rejected" {{#ifEquals
                                                        this.status "Return Rejected" }} selected {{/ifEquals}}>Reject
                                                        Return</option>
                                                    <option value="Returned" {{#ifEquals this.status "Returned" }}
                                                        selected {{/ifEquals}}>Accept Return</option>
                                                </select>
                                                {{else}}
                                                <!-- Second Dropdown: Standard Delivery Workflow -->
                                                <select class="form-select form-select-sm mb-2 status-dropdown"
                                                    data-item-id="{{this._id}}" data-order-id="{{../order._id}}" {{#if
                                                    (or (eq this.status "Completed" ) (eq this.status "Returned" ) (eq
                                                    this.status "Cancelled" ) (eq this.status "Return Rejected" ) ) }}
                                                    disabled {{/if}}>
                                                    <!-- Pending Option -->
                                                    {{#ifEquals this.status "Pending"}}
                                                    <option value="Pending" selected>Pending</option>
                                                    {{/ifEquals}}
                                                    <!-- Shipped Option -->
                                                    {{#if (or (eq this.status "Pending") (eq this.status "Shipped"))}}
                                                    <option value="Shipped" {{#ifEquals this.status "Shipped" }}
                                                        selected {{/ifEquals}}>Shipped</option>
                                                    {{/if}}
                                                    <!-- Completed Option -->
                                                    {{#if (eq this.status "Shipped")}}
                                                    <option value="Completed">Completed</option>
                                                    {{/if}}
                                                    {{#ifEquals this.status "Completed"}}
                                                    <option value="Completed" selected>Completed</option>
                                                    {{/ifEquals}}
                                                    <!-- Cancelled Option -->
                                                    {{#if (eq this.status "Pending")}}
                                                    <option value="Cancelled">Cancelled</option>
                                                    {{/if}}
                                                    {{#ifEquals this.status "Cancelled"}}
                                                    <option value="Cancelled" selected>Cancelled</option>
                                                    {{/ifEquals}}
                                                </select>
                                                {{/if}}
                                                <span
                                                    class="status-badge status-{{toLowerCase (replaceSpaceWithHyphen this.status)}} align-self-start">
                                                    {{this.status}} </span>
                                                {{/if}}
                                            </div>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Delivery Information Card -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><svg class="admin-icon me-2" xmlns="http://w3.org" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <rect x="1" y="3" width="15" height="13"></rect>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                <circle cx="18.5" cy="18.5" r="2.5"></circle>
                            </svg>
                            Delivery Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-3 mb-md-0">
                                <h6 class="text-uppercase text-muted mb-3">Shipping Address</h6>
                                <div class="address-container">
                                    <h6 class="fw-bold mb-2">{{order.deliveryAddress.name}}</h6>
                                    <p class="mb-1">{{order.deliveryAddress.streetAddress}}</p>
                                    {{#if order.deliveryAddress.landmark}}
                                    <p class="mb-1">Landmark: {{order.deliveryAddress.landmark}}</p>
                                    {{/if}}
                                    <p class="mb-1">{{order.deliveryAddress.city}}, {{order.deliveryAddress.state}}
                                        {{order.deliveryAddress.zip}}</p>
                                    <p class="mb-1">{{order.deliveryAddress.country}}</p>
                                    <p class="mb-0"><svg class="admin-icon me-1" xmlns="http://w3.org"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path
                                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                            </path>
                                        </svg>
                                        {{order.deliveryAddress.phone}}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right Column -->
            <div class="col-lg-4">
                <!-- Order Summary Card -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <svg class="admin-icon me-2" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z">
                                </path>
                                <path d="M6 8h12M6 12h12M6 16h8"></path>
                            </svg>
                            Order Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="summary-item">
                            <span>Subtotal ({{order.items.length}} items)</span>
                            <span>₹{{order.subtotal}}</span>
                        </div>
                        <div class="summary-item">
                            <span>Shipping Fee</span>
                            <span>₹{{order.shippingFee}}</span>
                        </div>
                        <div class="summary-item">
                            <span>Tax</span>
                            <span>₹{{order.tax}}</span>
                        </div>
                        {{#if order.couponDiscount}}
                        <div class="summary-item text-danger">
                            <span>Coupon Discount</span>
                            <span>-₹{{order.couponDiscount}}</span>
                        </div>
                        {{/if}}
                        {{#if order.offerDiscount}}
                        <div class="summary-item text-danger">
                            <span>Offer Discount</span>
                            <span>-₹{{order.offerDiscount}}</span>
                        </div>
                        {{/if}}
                        <hr>
                        <div class="summary-item">
                            <span><strong>Checkout Total</strong></span>
                            <span><strong>₹{{order.checkoutTotal}}</strong></span>
                        </div>
                        {{#if order.totalRefundAmount}}
                        <div class="summary-item text-danger">
                            <span><strong>Cancelled Amount</strong></span>
                            <span>-₹{{order.totalRefundAmount}}</span>
                        </div>
                        {{/if}}
                        <div class="summary-item pt-2 mt-2 summary-total">
                            <span>
                                {{#ifEquals order.paymentMethod "cod"}}
                                Amount Payable
                                {{else}}
                                Final Amount Paid
                                {{/ifEquals}}
                            </span>
                            <span>₹{{order.totalAmount}}</span>
                        </div>
                    </div>
                </div>
                <!-- Payment Information Card -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <svg class="admin-icon me-2" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            Payment Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <h6 class="text-uppercase text-muted mb-2">
                                Payment Method
                            </h6>
                            <div class="payment-method">
                                <div class="payment-icon">
                                    {{#ifEquals order.paymentMethod "wallet"}}
                                    <svg class="admin-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2">
                                        <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path>
                                        <path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path>
                                        <path d="M18 12a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h4v-6z"></path>
                                    </svg>
                                    {{else ifEquals order.paymentMethod "cod"}}
                                    <svg class="admin-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                                        <circle cx="12" cy="12" r="2"></circle>
                                    </svg>
                                    {{else}}
                                    <svg class="admin-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                        <line x1="2" y1="10" x2="22" y2="10"></line>
                                    </svg>
                                    {{/ifEquals}}
                                </div>
                                <div>
                                    <p class="mb-1">
                                        {{#ifEquals order.paymentMethod "wallet"}}
                                        Wallet
                                        {{else ifEquals order.paymentMethod "cod"}}
                                        Cash On Delivery
                                        {{else}}
                                        Online Payment (Razorpay)
                                        {{/ifEquals}}
                                    </p>
                                    <span class="badge
                        {{#ifEquals order.paymentStatus " Completed"}} bg-success {{else ifEquals
                                        order.paymentStatus "Refunded" }} bg-info {{else ifEquals
                                        order.paymentStatus "Failed" }} bg-danger {{else}} bg-warning {{/ifEquals}}">
                                        {{order.paymentStatus}}
                                    </span>
                                </div>
                            </div>
                        </div>
                        {{#if item.refundDetails.refundType}}
                        <div>
                            <h6 class="text-uppercase text-muted mb-2">
                                Financial Status
                            </h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Adjustment Type</span>
                                <strong>{{item.refundDetails.refundType}}</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Status</span>
                                <strong>{{item.refundDetails.refundAmountStatus}}</strong>
                            </div>
                            {{#ifEquals item.refundDetails.refundAmountStatus "Refunded"}}
                            <div class="d-flex justify-content-between">
                                <span>Refund Amount</span>
                                <strong>₹{{item.refundDetails.refundAmount}}</strong>
                            </div>
                            {{else}}
                            <div class="d-flex justify-content-between">
                                <span>Cancelled Amount</span>
                                <strong>₹{{item.refundDetails.refundAmount}}</strong>
                            </div>
                            {{/ifEquals}}
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{{#section 'scripts'}}
<script src="/javascripts/admin/orderDetails.js" defer></script>
{{/section}}