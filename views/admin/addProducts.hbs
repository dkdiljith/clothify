<head>
    <title>Add Product</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/addProducts.css">
</head>
<body>
    <div class="container-fluid vh-100 d-flex align-items-center justify-content-center">
        <div class="card fixed-width-card" style="width:600px;">
            <div class="card-body">
                <h1>Add Product</h1>
                <form id="addProductForm" method="post" action="/admin/addproducts" novalidate>
                    <div id="step-1" class="step active">
                        <h2>Basic Details</h2>
                        {{!-- <div class="alert alert-success alert-dismissible fade show">{{Message}}</div> --}}
                        <div class="form-group">
                            <label for="name">Name <span class="required">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" required oninput="validateInput(this)" placeholder="Product Name" />
                            <div class="invalid-feedback">Name is required</div>
                        </div>
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="5" placeholder="Product Description"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="category">Category <span class="required">*</span></label>
                            <select class="form-control select2" id="category" name="category" required>
                                <option value="">Select</option>
                                <option value="Topwear">Topwear</option>
                                <option value="Bottomwear">Bottomwear</option>
                            </select>
                            <div class="invalid-feedback">Please select a category</div>
                        </div>
                    </div>

                    <div id="step-2" class="step" style="display: none">
                        <h2>Pricing & Stock</h2>
                        <div class="form-group">
                            <label for="price">Price <span class="required">*</span></label>
                            <input type="number" class="form-control" id="price" name="price" required min="100" oninput="validateInput(this)" placeholder="Product Price" />
                            <div class="invalid-feedback">Price is required and must be greater than 100</div>
                        </div>
                        <div class="form-group">
    <label for="product_type">Product Type <span class="required">*</span></label>
    <div class="btn-group btn-group-toggle" data-toggle="buttons">
        <label class="btn btn-outline-primary active">
            <input type="radio" name="product_type" id="adult_male" autocomplete="off" value="adult_male" required />
            Men's
        </label>
        <label class="btn btn-outline-primary">
            <input type="radio" name="product_type" id="adult_female" autocomplete="off" value="adult_female" />
            Women's
        </label>
        <label class="btn btn-outline-primary">
            <input type="radio" name="product_type" id="boy" autocomplete="off" value="boy" />
            Boy
        </label>
        <label class="btn btn-outline-primary">
            <input type="radio" name="product_type" id="girl" autocomplete="off" value="girl" />
            Girl
        </label>
    </div>
    <div class="invalid-feedback">Product Type is required</div>
</div>
                    </div>

                    <div id="step-3" class="step" style="display: none;">
                        <h2>Images & Additional Info</h2>
                        <div class="form-group">
                            <label for="images">Images (Max 5):</label>
                            <input type="file" id="image-upload" name="images" multiple accept="image/*" onchange="validateImages()" required />
                            <div class="invalid-feedback">You must upload at least one image (max 5)</div>
                        </div>
                        <div class="form-group">
                            <label>Available Sizes and Quantities:</label>
                            <div id="size-quantity-inputs">
    <div class="row mb-2">
        <div class="col-md-4">
            <input type="text" class="form-control size-input" name="size[0][size]" placeholder="Size (e.g., S, M, L)" required>
        </div>
        <div class="col-md-4">
            <input type="number" class="form-control quantity-input" name="size[0][quantity]" placeholder="Quantity" min="1" required>
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-success add-size-btn">Add Size</button>
        </div>
    </div>
</div>
                            <div class="invalid-feedback">Please enter at least one valid size and quantity</div>
                        </div>
                    </div>

                    <div class="form-navigation">
                        <button type="button" class="btn btn-secondary" id="prev-step" style="display: none">Previous</button>
                        <button type="button" class="btn btn-primary" id="next-step">Next</button>
                        <button type="submit" class="btn btn-primary btn-lg" id="submit-btn" style="display: none">
                            <i class="fas fa-save"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>