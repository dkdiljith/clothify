<head>
  <link
    rel="stylesheet"
    type="text/css"
    href="/stylesheets/admin/products.css"
  />
</head>
<body>
    <div class="dashboard-container">
        <!-- Header -->
        <div class="header">
            <h1 class="page-title">Product Management</h1>
            <button onclick="location.href='/admin/addProducts'" class="add-product-btn">+ Add Product</button>
        </div>

        <!-- Controls -->
        {{!-- <div class="controls">
            <input type="text" class="search-input" placeholder="Search products...">
            <select class="filter-select">
                <option>All Categories</option>
                <option>Electronics</option>
                <option>Apparel</option>
            </select>
            <select class="filter-select">
                <option>All Statuses</option>
                <option>Active</option>
                <option>Draft</option>
            </select>
        </div> --}}

        <!-- Product Grid Header -->
        <div class="product-grid grid-header">
            <div></div>
            <div>Product Name</div>
            <div>Category</div>
            <gender>Gender</gender>
            <div>Price</div>
            <div>Stock</div>
            {{!-- <div>Status</div> --}}
            <div>Actions</div>
        </div>

        {{#if products.length}}
        <!-- Product Items -->
        {{#each products}}
        <div class="product-grid product-item">
            {{#if this.images.length}}
            <img src="{{this.images.[0].path}}" class="product-thumbnail" alt="{{this.name}}">
            {{else}}
            <div class="no-image">📦</div>
            {{/if}}
            <div>{{this.name}}</div>
            <div>{{getCategoryName this.categoryId ../categories}}</div>
            <div>{{this.gender}}</div>
            {{#if this.details.length}}
            <div>₹{{this.details.[0].price}}</div>
            <div>{{this.details.[0].quantity}}</div>
            {{/if}}
            {{!-- <div><span class="status-badge {{#ifEquals this.status 'Active'}}status-active{{else}}status-inactive{{/ifEquals}}">{{this.status}}</span></div> --}}
            <div>
                

                <span onclick="location.href='/admin/editproducts/{{this._id}}'" class="action-icon">✏️</span>
                <span onclick="location.href='/admin/delete-product/{{this._id}}'" class="action-icon">🗑️</span>
                {{!-- <span class="action-icon">👁️</span> --}}
          
            </div>
        </div>
        {{/each}}
        
        <!-- Pagination -->
        <div class="pagination-wrapper">
            <nav>
                <ul class="pagination">
                    {{#if prevPage}}
                    <li><a href="/admin/products?page={{prevPage}}&searchQuery={{searchQuery}}">⬅️</a></li>
                    {{/if}}
                    {{#each pages}}
                    <li class="{{#ifEquals this ../currentPage}}active{{/ifEquals}}">
                        <a href="/admin/products?page={{this}}">{{this}}</a>
                    </li>
                    {{/each}}
                    {{#if nextPage}}
                    <li><a href="/admin/products?page={{nextPage}}&searchQuery={{searchQuery}}">➡️</a></li>
                    {{/if}}
                </ul>
            </nav>
        </div>
        
        {{else}}
        <!-- No Products Found -->
        <div class="no-products-content text-center">
            <h4>No Products Found</h4>
            <p>Try adjusting your search or add a new product</p>
            <button onclick="window.location.href='/admin/addProducts'" class="add-product-btn">Add Your First Product</button>
        </div>
        {{/if}}
    </div>
</body>
