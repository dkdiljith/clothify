<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/products.css" />
</head>

<body>
    <div class="dashboard-container">
        <div class="header">
            <h1 class="page-title">Product Management</h1>

            <div style="display:flex;">
                <form method="GET" action="/admin/products" role="search" style="margin-right:15px;">
                    <div class="search-container">
                        <input type="search" name="query" class="search-input" id="search-input"
                            placeholder="Search products..." {{#if query}}value="{{query}}" {{/if}}>
                    </div>
                </form>

                <button onclick="location.href='/admin/addProducts'" class="add-product-btn">
                    + Add Product
                </button>
            </div>
        </div>

        {{#if products.length}}

        <div class="orders-table">
            <table>
                <thead>
                    <tr style="text-align: center; vertical-align: middle;">
                        <th style="width: 50px;"></th>
                        <th>Product Image</th>
                        <th>Item Name</th>
                        <th>Unit Price</th>
                        <th>Product Category</th>
                        <th>Inventory</th>
                        <th>Offer Code</th>
                        <th>Offer Applied</th>
                        <th style="text-align: center;">Management</th>
                    </tr>

                </thead>

                <tbody>
                    {{#each products}}
                    <tr>

                        <td> {{serialNumber ../pagination.serialNumberStart @index}}</td>

                        <td>
                            {{#if this.images.length}}
                            <img src="{{this.images.[0].path}}" class="product-thumbnail">
                            {{else}}
                            <div class="no-image">📦</div>
                            {{/if}}
                        </td>

                        <td>{{this.name}}</td>

                        {{#if this.details.length}}

                        <td>
                            {{#if this.details.[0].offerPrice}}
                            <div>
                                <span style="text-decoration:line-through; opacity:.65;">
                                    ₹{{this.details.[0].price}}
                                </span>
                            </div>

                            <div style="font-weight:700; color:#16a34a;">
                                ₹{{this.details.[0].offerPrice}}
                            </div>
                            {{else}}
                            ₹{{this.details.[0].price}}
                            {{/if}}
                        </td>

                        <td>{{getCategoryName this.categoryId ../categories}}</td>

                        <td>{{this.details.[0].quantity}}</td>

                        <td>
                            {{#if this.currentOfferCode}}
                            {{this.currentOfferCode}}
                            {{else}}
                            <span style="font-size:12px; color:#9ca3af;">None</span>
                            {{/if}}
                        </td>

                        <td>
                            {{#if this.details.[0].offerId}}

                            {{#if this.details.[0].offerLocked}}
                            <span style="font-size:12px; font-weight:600; color:#ea580c;">
                                Manual
                            </span>
                            {{else}}
                            <span style="font-size:12px; font-weight:600; color:#2563eb;">
                                Automated
                            </span>
                            {{/if}}

                            {{else}}
                            <span style="font-size:12px; color:#9ca3af;">None</span>
                            {{/if}}
                        </td>

                        {{else}}

                        <td>N/A</td>
                        <td>N/A</td>
                        <td>N/A</td>
                        <td>N/A</td>
                        <td><span style="color:#9ca3af;">None</span></td>
                        <td><span style="color:#9ca3af;">None</span></td>
                        {{/if}}



                        <td style="display: flex; gap: 8px; align-items: center; white-space: nowrap;">

                            <button type="button" class="btn btn-apply-offer" data-product-id="{{this._id}}" {{#unless
                                this.isActive}}disabled title="Cannot apply offers to an inactive product" {{/unless}}
                                style="font-size:12px; border:none; border-radius:4px; background:#dbe87c; color:#333; 
                                width: 85px; height: 27px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
                                {{#unless this.isActive}}opacity: 0.5; cursor: not-allowed; background:#e5e7eb; color:#9ca3af; pointer-events: none;{{/unless}}">
                                <i class="bi bi-tag"></i>
                                Apply 🏷️
                            </button>

                            <button type="button" {{#if
                                this.isActive}}onclick="location.href='/admin/editproducts/{{this._id}}'"
                                {{else}}disabled title="Cannot edit an inactive product" {{/if}}
                                style="font-size:12px; border:none; border-radius:4px; background:#5b70d7; color:#fff; 
                                width: 85px; height: 27px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
                                {{#unless this.isActive}}opacity: 0.5; cursor: not-allowed; background:#e5e7eb; color:#9ca3af; pointer-events: none;{{/unless}}">
                                <i class="bi bi-pencil"></i>
                                Edit ✏️
                            </button>

                            {{#if this.isActive}}
                            <button type="button" onclick="handleBlock('{{this._id}}')"
                                style="font-size:12px; border:none; border-radius:4px; background:#86b381; color:#333; 
                                width: 85px; height: 27px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;">
                                <i class="bi bi-slash-circle"></i>
                                Block 🍃
                            </button>
                            {{else}}
                            <button type="button" onclick="handleBlock('{{this._id}}')"
                                style="font-size:12px; border:none; border-radius:4px; background:#d56251; color:#fff; 
                                width: 85px; height: 27px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;">
                                <i class="bi bi-unlock"></i>
                                Unblock 🍂
                            </button>
                            {{/if}}

                        </td>

                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{#if (gt pagination.totalPages 1)}}
        <div class="pagination">

            {{#if pagination.hasPrevPage}}
            <a href="/admin/products?page={{pagination.prevPage}}{{#if query}}&query={{query}}{{/if}}"
                class="pagination-button">
                <i class="fas fa-chevron-left"></i> Previous
            </a>
            {{/if}}

            <span class="pagination-info">
                Page {{pagination.page}} of {{pagination.totalPages}}
            </span>

            {{#if pagination.hasNextPage}}
            <a href="/admin/products?page={{pagination.nextPage}}{{#if query}}&query={{query}}{{/if}}"
                class="pagination-button">
                Next <i class="fas fa-chevron-right"></i>
            </a>
            {{/if}}

        </div>
        {{/if}}

        {{else}}

        <div class="empty-state">
            <svg class="empty-state-image" xmlns="http://www.w3.org/2000/svg" width="150" height="150" fill="none"
                viewBox="0 0 24 24" stroke="currentColor">

                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M3 3h18v2H3V3zm2 4h14l-1.5 9H6.5L5 7zm2.75 11a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zm8.5 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5z" />
            </svg>

            <h2>No Products Found</h2>

            {{#unless query}}
            <p>
                There are currently no products in your store.
                Add your first product to get started!
            </p>
            {{/unless}}

            <button onclick="window.location.href='/admin/products'" class="add-product-btn empty-state-btn">
                Refresh
            </button>
        </div>

        {{/if}}
    </div>

    <div id="mainOverlay" class="app-overlay">
        <div class="modal-card">

            <div class="form-header">
                <h1 class="page-title" id="formModalTitle">Apply Offer</h1>

                <button id="closeFormBtn" class="btn btn-icon" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form id="mainForm" method="post" novalidate
                style="display:flex; flex-direction:column; flex-grow:1; overflow:hidden;">

                <div style="font-size:13px; opacity:.75; margin-bottom:10px;">
                    Choose a product offer or return product to automatic pricing.
                </div>

                <input type="text" id="offerSearch" class="form-control mb-3" placeholder="Search active offers..."
                    onkeyup="filterOffers()">

                <div id="offerListContainer"></div>

                <input type="hidden" id="selectedOfferIdInput" name="selectedOfferId">
                <input type="hidden" id="selectedProductIdInput" name="selectedProductId">

                <div class="form-actions">

                    <button type="submit" class="btnForm btn-primary">
                        <span class="icon">
                            <i class="fas fa-check"></i>
                        </span>
                        Apply Offer
                    </button>

                    <button type="button" id="autoPricingBtn" class="btnForm"
                        style="background:#e5e7eb; color:#111827;">
                        Use Automatic Pricing
                    </button>

                </div>
            </form>
        </div>
    </div>

    <script>
        async function handleBlock(productId) {
            const response = await fetch(`/admin/blockProduct/${productId}`);
            const data = await response.json();

            if (data.success) {
                window.location.reload();
            } else {
                showPopupMessage(data.message, `error`)
            }
        }
    </script>

    <script src="/javascripts/admin/product.js" defer></script>
</body>