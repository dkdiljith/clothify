{{#section 'head'}}
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/category.css" />
{{/section}}

<div class="dashboard-container">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2 class="page-title">Edit Category: {{parentCategory.name}}</h2>

        <button type="button" onclick="location.href='/admin/category'" class="btn btn-secondary">
            ← Back
        </button>
    </div>

    <div class="category-management-layout">

        <!-- left side -->
        <div class="categories-list-container">

            {{#if subcategories.length}}

            <div class="categories-table-header">
                <h3>Subcategories</h3>
                <span>{{subcategories.length}} Items</span>
            </div>

            <div class="categories-table-wrapper">
                <table class="categories-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Subcategory</th>
                            <th>Products</th>
                            <th>Offer Code</th>
                            <th>Offer Applied</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {{#each subcategories}}

                        <tr>

                            <td data-label="Sl No">
                                {{incrementedIndex @index}}
                            </td>

                            <td data-label="Subcategory">

                                <div class="category-name">

                                    <span class="subcategory-icon">📄</span>

                                    {{this.name}}

                                </div>

                            </td>

                            <td data-label="Products">
                                {{this.productCount}}
                            </td>

                            <td data-label="Offer Code">

                                {{#if this.offerId}}

                                {{this.offerCode}}

                                {{else}}

                                <span style="color:#9ca3af;">

                                    None

                                </span>

                                {{/if}}

                            </td>

                            <td data-label="Offer Applied">

                                {{#if this.offerId}}

                                {{#if this.offerLocked}}

                                <div style="font-size:12px; font-weight:700; color:#ea580c;">

                                    Manual

                                </div>

                                {{else}}

                                <div style="font-size:12px; font-weight:700; color:#2563eb;">

                                    Automated

                                </div>

                                {{/if}}

                                <div style="font-size:11px; opacity:.8; margin-top:2px;">

                                    {{#each ../offers}}

                                    {{#ifCond this._id "==" ../this.offerId}}

                                    {{this.offerCode}}

                                    {{/ifCond}}

                                    {{/each}}

                                </div>

                                {{else}}

                                <span style="font-size:12px; color:#9ca3af;">

                                    None

                                </span>

                                {{/if}}

                            </td>

                            <td data-label="Actions">

                                <div class="action-buttons">

                                    <button class="btn btn-danger btn-sm btn-delete" data-id="{{this._id}}">

                                        Delete

                                    </button>

                                    <button type="button" class="btn btn-apply-offer" data-category-id="{{this._id}}"
                                        style="font-size:12px; padding:6px 10px; border:none; border-radius:4px; background:#f4f4f4; color:#333;">

                                        <i class="bi bi-check2"></i>

                                        Apply 🏷️

                                    </button>

                                </div>

                            </td>

                        </tr>

                        {{/each}}

                    </tbody>

                </table>
            </div>

            {{else}}

            <div class="empty-state">
                <h3>No Subcategories Found</h3>
            </div>

            {{/if}}

        </div>

        <!-- right side -->
        <div class="add-category-container">

            <div class="add-category-card">

                <h3>Add Subcategory</h3>

                <form class="form">

                    <div class="form-group">
                        <label class="form-label">Parent Category</label>

                        <input type="text" class="form-control" value="{{parentCategory.name}}" id="categoryName"
                            disabled>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Subcategory Name</label>

                        <input type="text" class="form-control" id="newSubcategory"
                            placeholder="Enter subcategory name">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>


<!-- modal -->
<div id="mainOverlay" class="app-overlay">

    <div class="modal-card">

        <div class="form-header">
            <h1 class="page-title" id="formModalTitle">Apply Offer</h1>

            <button id="closeFormBtn" class="btn btn-icon" type="button">
                ✕
            </button>
        </div>

        <form id="mainForm">

            <input type="text" id="offerSearch" class="form-control mb-3" placeholder="Search offers..."
                onkeyup="filterOffers()">

            <div id="offerListContainer"></div>

            <input type="hidden" id="selectedOfferIdInput">
            <input type="hidden" id="selectedCategoryIdInput">

            <div class="form-actions">

                <button type="submit" class="btnForm btn-primary">
                    Apply Offer
                </button>

                <button type="button" id="autoPricingBtn" class="btnForm" style="background:#e5e7eb; color:#111827;">
                    Use Automatic Pricing
                </button>

            </div>

        </form>

    </div>

</div>



{{#section 'scripts'}}
<script src="/javascripts/admin/editCategory.js" defer></script>
{{/section}}