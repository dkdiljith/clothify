<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/category.css" />
    <script src="/javascripts/admin/admin-sidebar.js" defer></script>
</head>

<body>
    <div class="dashboard-container">
        <div style="display:flex; justify-content:space-between">
            <h2 class="page-title">Edit Category: {{parentCategory.name}}</h2>
            <button type="button" onclick="location.href='/admin/category'" class="btn btn-secondary">
                <span class="icon">←</span> Back to Categories
            </button>
        </div>


        <div class="category-management-layout">
            <!-- Left Column - Subcategories List -->
            <div class="categories-list-container">
                {{#if subcategories.length}}
                <div class="categories-table-header">
                    <h3>Subcategories</h3>
                    <div class="table-actions">
                        <span>{{subcategories.length}} {{#if (eq subcategories.length
                            1)}}subcategory{{else}}subcategories{{/if}}</span>
                    </div>
                </div>

                <div class="categories-table-wrapper">
                    <table class="categories-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Subcategory Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each subcategories}}
                            <tr>
                                <td>{{incrementedIndex @index}}</td>
                                <td>
                                    <div class="category-name">
                                        <span class="subcategory-icon">📄</span>
                                        {{this.name}}
                                    </div>
                                </td>
                                <td class="action-buttons">
                                    <button class="btn btn-sm btn-delete" data-id="{{this._id}}">
                                        <span class="icon">🗑️</span> Delete
                                    </button>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="empty-state">
                    <div class="empty-state-icon">📂</div>
                    <h3>No Subcategories Found</h3>
                    <p>Add subcategories to {{parentCategory.name}}</p>
                </div>
                {{/if}}
            </div>

            <!-- Right Column - Edit Category Form -->
            <div class="add-category-container">
                <div class="add-category-card">
                    <h3>Edit Category</h3>
                    <form class="form">
                        <input type="hidden" name="_method" value="PUT">
                        <div class="form-group">
                            <label for="categoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" id="categoryName" name="name"
                                value="{{parentCategory.name}}" required>
                        </div>

                        <h4 class="form-subheader">Add New Subcategory</h4>
                        <div class="form-group">
                            <label for="newSubcategory" class="form-label">Subcategory Name</label>
                            <input type="text" class="form-control" id="newSubcategory" name="newSubcategory"
                                placeholder="e.g. T-Shirts, Pants">
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                <span class="icon">💾</span> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <script src="/javascripts/admin/editCategory.js" defer></script>
</body>