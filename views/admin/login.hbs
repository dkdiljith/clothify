{{#section 'head'}}
<title>Admin Login | Clothify</title>
<link rel="stylesheet" href="/stylesheets/admin/login.css">
{{/section}}



<div class="login-page" style="
        background:url('https://i.postimg.cc/rFVLgXBH/balancing-1868051-1920-fotor-2025013112343.png')
        center center / cover no-repeat;
    ">
  <!-- Logos -->
  <img src="https://i.postimg.cc/VNqRKTHy/Clothify-logo-black.png" alt="Clothify" class="website-logo">
  <img src="https://i.postimg.cc/Vkc0K6y6/output-onlinepngtools-1.png" alt="Admin" class="admin-logo">
  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="login-card">
            <div class="login-header">
              <h2>
                Welcome Back
              </h2>
              <p>
                Sign in to continue to the
                Clothify Admin Dashboard.
              </p>
            </div>
            {{#if error}}
            <input type="hidden" id="pageError" value="{{error}}">
            {{/if}}
            <form id="loginForm" action="/admin/login" method="POST" novalidate>
              <!-- EMAIL -->
              <div class="form-group">
                <label for="email">
                  Email Address
                </label>
                <div class="input-wrapper">
                  <svg class="form-field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                    </path>
                    <polyline points="22,6 12,13 2,6">
                    </polyline>
                  </svg>
                  <input type="email" id="email" name="email" class="form-control" autocomplete="email"
                    spellcheck="false" placeholder="Enter your email address" required>
                </div>
                <small class="error-message" id="emailError">
                </small>
              </div>
              <!-- PASSWORD -->
              <div class="form-group">
                <label for="password">
                  Password
                </label>
                <div class="input-wrapper">
                  <svg class="form-field-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2">
                    </rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4">
                    </path>
                  </svg>
                  <input type="password" id="password" name="password" class="form-control"
                    autocomplete="current-password" placeholder="Enter your password" required>
                  <i class="fas fa-eye password-toggle" id="togglePassword">
                  </i>
                </div>
                <small class="error-message" id="passwordError">
                </small>
              </div>
              <div class="text-center mt-4">
                <button type="submit" id="loginButton" class="btn btn-primary">
                  <span id="loginSpinner" class="spinner-border d-none"></span>
                  <span id="loginButtonText">Sign In</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>



{{#section 'scripts'}}
<script src="/javascripts/admin/login.js" defer></script>
{{/section}}