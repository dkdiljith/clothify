<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/category.css" />

</head>

<body>
    <div class="container">
        <h2>Manage Categories</h2>

        <form id="addCategoryForm" action="/admin/addCategory" method="POST" novalidate>
            <div class="mb-3">
                <label for="categoryName" class="form-label">Category Name</label>
                <input type="text" class="form-control" id="categoryName" name="name" required>
            </div>
            <div class="mb-3">
                <label for="parentCategory" class="form-label">Parent Category (Optional)</label>
                <select class="form-control" id="parentCategory" name="parentCategory">
                    <option value="">None</option>
                    {{#each categories}}
                    <option value="{{this._id}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <button type="submit" class="btn btn-success">Add Category</button>
        </form>

        {{#if categories.length}}
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Category</th>
                    <th>Subcategories</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="categoriesTable">
                {{#each categories}}
                <tr>
                    <td></td>
                    <td>{{this.name}}</td>
                    <td>{{#each this.subcategories}}
                        <li>{{this.name}}</li>
                        {{else}}
                        <li>No subcategories</li>
                        {{/each}}
                    </td>
                    <td class="action-buttons">
                        <button onclick="location.href='/admin/editcategory/{{this._id}}'"  class="btn btn-sm btn-primary edit-button2" data-category-id="{{this.id}}">Edit</button>
                        <button onclick="location.href='/admin//deleteCategory/{{this._id}}'"
                            class="btn btn-sm btn-danger delete-button">Delete</button>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <p>No categories found. Add a new category below:</p>
        {{/if}}


         <div id="myModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <div id="modal-content-inner">
        </div>
    </div>
  </div>





