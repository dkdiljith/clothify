<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Management</title>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/category.css" />
    <script src="/javascripts/admin/admin-sidebar.js" defer></script>

     <style>
        /* Add these styles for validation messages */
        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
        }
        .form-control.error {
            border-color: #dc3545;
        }
    </style>
    
</head>

<body>
    <div class="category-management-layout">
        <!-- Left Column - Categories List -->
        <div class="categories-list-container">
            {{#if categories.length}}
            <div class="categories-table-header">
                <h2 class="page-title">Category Management</h2>
                <div class="table-actions">
                    <span>{{categories.length}} {{#if (eq categories.length 1)}}category{{else}}categories{{/if}}</span>
                </div>
            </div>

            <div class="categories-table-wrapper">
                <table class="categories-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category</th>
                            <th>Subcategories</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each categories}}
                        <tr>
                            <td>{{incrementedIndex @index}}</td>
                            <td>
                                <div class="category-name">
                                    <span class="category-icon">📁</span>
                                    {{this.name}}
                                </div>
                            </td>
                            <td>
                                {{#if this.subcategories.length}}
                                <ul class="subcategories-list">
                                    {{#each this.subcategories}}
                                    <li>
                                        <span class="subcategory-icon">📄</span>
                                        {{this.name}}
                                    </li>
                                    {{/each}}
                                </ul>
                                {{else}}
                                <span class="no-subcategories">No subcategories</span>
                                {{/if}}
                            </td>
                            <td class="action-buttons">
                                <button onclick="location.href='/admin/category/{{this._id}}'"
                                    class="btn btn-sm btn-edit" data-category-id="{{this.id}}">
                                    <span class="icon">✏️</span> Edit
                                </button>
                                <button class="btn btn-sm btn-delete" data-id="{{this._id}}">
                                    <span class="icon">🗑️</span> Delete
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="empty-state">
                <div class="empty-state-icon">📂</div>
                <h3>No Categories Found</h3>
                <p>Get started by adding your first category</p>
            </div>
            {{/if}}

            {{#if (gt pagination.totalPages 1)}}
            <div class="pagination">
                {{#if pagination.hasPrevPage}}
                <a href="/admin/category?page={{pagination.prevPage}}" class="pagination-button">
                    <i class="fas fa-chevron-left"></i> Previous
                </a>
                {{/if}}

                <span class="pagination-info">
                    Page {{pagination.page}} of {{pagination.totalPages}}
                </span>

                {{#if pagination.hasNextPage}}
                <a href="/admin/category?page={{pagination.nextPage}}" class="pagination-button">
                    Next <i class="fas fa-chevron-right"></i>
                </a>
                {{/if}}
            </div>
            {{/if}}
        </div>

        <!-- Right Column - Add Category Form -->
        <div class="add-category-container">
            <div class="add-category-card">
                <h3 class="page-title">Add New Category</h3>
                <form id="addCategoryForm" action="/admin/category" method="POST" novalidate>
                    <div class="form-group">
                        <label for="categoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="categoryName" name="name"
                            placeholder="e.g. Electronics, Clothing" required minlength="6">
                        <div id="categoryNameError" class="error-message">
                            Category name must be at least 6 characters long
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="parentCategory" class="form-label">Parent Category (Optional)</label>
                        <select class="form-control" id="parentCategory" name="parentCategory">
                            <option value="">-- Select parent category --</option>
                            {{#each categories}}
                            <option value="{{this._id}}">{{this.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <span class="icon">➕</span> Add Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

     <script src="/javascripts/admin/category.js"></script>
</body>
</html>