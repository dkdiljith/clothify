{{#section 'head'}}
<title>Sales Report</title>
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/salesReport.css">
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/usersList.css">
{{/section}}


<main class="dashboard-container">
    <div class="users-header">
        <h1 class="page-title">
            Sales Report
        </h1>
        <div class="export-buttons">

            <button class="export-btn pdf-btn" id="exportPdf">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path
                        d="M5.523 10.424q.21-.124.459-.238a8 8 0 0 1-.45.606c-.28.337-.498.516-.635.572l-.082.022a1 1 0 0 1-.304-.063 1 1 0 0 1-.196-.288q-.085-.218-.085-.436v-.21q0-.18.106-.353.106-.172.319-.323.213-.15.494-.233a4 4 0 0 1 1.082-.08l.018-.002zm4.974 0q-.21-.124-.459-.238a8 8 0 0 0 .45.606c.28.337.498.516.635.572l.082.022a1 1 0 0 0 .304-.063 1 1 0 0 0 .196-.288q.085-.218.085-.436v-.21q0-.18-.106-.353-.106-.172-.319-.323-.213-.15-.494-.233a4 4 0 0 0-1.082-.08l-.018-.002z" />
                    <path fill-rule="evenodd"
                        d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2m.165 11.668q.32.18.66.182c.434 0 .732-.28.732-.783 0-.442-.27-.72-.733-.72-.265 0-.506.11-.659.28l-.011.012c-.086.11-.158.27-.158.49v.33q0 .136.038.223h-.008a.7.7 0 0 0-.185.29.7.7 0 0 0-.012.302zm3.761-2.052q.32.18.66.182c.434 0 .732-.28.732-.783 0-.442-.27-.72-.733-.72-.265 0-.506.11-.659.28l-.012.012c-.086.11-.158.27-.158.49v.33q0 .136.038.223h-.008a.7.7 0 0 0-.185.29.7.7 0 0 0-.012.302z" />
                    <path d="M2 2a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z" />
                </svg>
                Export as PDF
            </button>

            <button class="export-btn excel-btn" id="exportExcel">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path
                        d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5" />
                    <path
                        d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1" />
                </svg>
                Export as Excel
            </button>

            <button class="export-btn csv-btn" id="exportCsv">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path
                        d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zM3 2v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1z" />
                </svg>

                Export as CSV
            </button>

        </div>

        <div class="filter-container">

            <input type="date" id="startDate" class="date-filter" value="{{startDate}}">

            <span>to</span>

            <input type="date" id="endDate" class="date-filter" value="{{endDate}}">

            <button id="applyFilter" class="btn-filter">
                Apply Filter
            </button>

        </div>

    </div>

    {{#if orders.length}}

    <div class="sales-table-wrapper">

        <div class="users-table">

            <table id="salesTable">

                <thead>

                    <tr>
                        <th></th>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Payment</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody id="ordersTableBody">

                    {{#each orders}}

                    <tr>

                        <td data-label="Sl No">
                            {{serialNumber ../pagination.serialNumberStart @index}}
                        </td>

                        <td>

                            <div class="order-id-cell">
                                <svg xmlns="http://w3.org" viewBox="0 0 96 96" width="64" height="64">
                                    <!-- Right Side -->
                                    <path d="M48 56 L81 40 L81 73 L48 88 Z" fill="#F4C47F" stroke="#2C3E50"
                                        stroke-width="5" stroke-linejoin="round" />

                                    <!-- Left Side -->
                                    <path d="M15 40 L48 56 L48 88 L15 73 Z" fill="#D2A460" stroke="#2C3E50"
                                        stroke-width="5" stroke-linejoin="round" />

                                    <!-- Top Lid (Closed) -->
                                    <path d="M48 22 L81 40 L48 56 L15 40 Z" fill="#E5B570" stroke="#2C3E50"
                                        stroke-width="5" stroke-linejoin="round" />

                                    <!-- Center Seam Tape -->
                                    <path d="M48 22 L48 56" stroke="#2C3E50" stroke-width="5" stroke-linecap="round" />

                                    <!-- Delivery Badge -->
                                    <circle cx="69" cy="69" r="15" fill="#2ECC71" stroke="#2C3E50" stroke-width="5" />
                                    <path d="M62 69 L66 73 L76 63" fill="none" stroke="#FFFFFF" stroke-width="4"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                </svg>



                                <div class="order-number-container">
                                    #{{this.orderId}}
                                </div>

                            </div>

                        </td>

                        <td data-label="Order Date">
                            {{formatDate this.createdAt}}
                        </td>

                        <td data-label="Customer">
                            {{this.deliveryAddress.name}}
                        </td>

                        <td data-label="Payment Method">
                            {{this.paymentMethod}}
                        </td>

                        <td data-label="Total Amount">
                            ₹{{this.totalAmount}}
                        </td>
                        <td data-label="Delivery Status">
                            <span class="status-badge status-{{toLowerCase this.deliveryStatus}}">
                                {{this.deliveryStatus}}
                            </span>
                        </td>

                    </tr>

                    {{/each}}

                </tbody>
            </table>

        </div>

    </div>

    {{#if (gt pagination.totalPages 1)}}

    <div class="pagination">

        {{#if pagination.hasPrevPage}}

        <a href="/admin/salesReport?page={{pagination.prevPage}}{{#if startDate}}&startDate={{startDate}}&endDate={{endDate}}{{/if}}"
            class="pagination-button">
            <svg class="pagination-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Previous
        </a>


        {{/if}}

        <span class="pagination-info">

            Page
            {{pagination.page}}
            of
            {{pagination.totalPages}}

        </span>

        {{#if pagination.hasNextPage}}

        <a href="/admin/salesReport?page={{pagination.nextPage}}{{#if startDate}}&startDate={{startDate}}&endDate={{endDate}}{{/if}}"
            class="pagination-button">
            Next
            <svg class="pagination-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>


        {{/if}}

    </div>

    {{/if}}

    </div>

    {{else}}

    <div class="empty-state">

        <svg class="empty-state-image" xmlns="http://www.w3.org/2000/svg" width="150" height="150" fill="none"
            viewBox="0 0 24 24" stroke="currentColor">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />

        </svg>

        <h2>
            No Sales Data Available
        </h2>

        <p>
            There are currently no sales records for the selected period.
        </p>

        <div class="empty-state-actions">

            <a href="/admin/salesReport" class="btn btn-primary">

                Refresh

            </a>

        </div>

    </div>

    {{/if}}

</main>



{{#section 'scripts'}}
<script src="/javascripts/admin/salesReport.js" defer></script>
{{/section}}