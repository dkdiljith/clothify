<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/coupon.css">
    <script src="/javascripts/admin/admin-sidebar.js" defer></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>

    <div class="coupon-management-layout">
        <!-- Coupons List -->
        <div class="coupons-list-container">

            <div class="coupons-table-header">
                <h1 class="page-title">Coupon Management</h1>

                <div style="display:flex;">

                    <form method="GET" action='/admin/coupons/search' role="search">
                        <div class="search-container">
                            <input type="search" name="query" class="search-input" id="search-input"
                                placeholder="Search by name or discount" {{#if query}} value={{query}} {{/if}}>
                        </div>
                    </form>
                    <button id="toggleCouponForm" class="btn btn-primary" style="margin-left:15px;">
                        + Add Coupon
                    </button>

                </div>
            </div>

            {{#if coupon.length}}
            <div class="coupons-table-wrapper">
                <table class="coupons-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Coupon Code</th>
                            <th>Discount</th>
                            <th>Validity</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each coupon}}
                        <tr>
                            <td>{{incrementedIndex @index}}</td>
                            <td>
                                <div class="coupon-code">
                                    <span class="coupon-icon">🎟️</span>
                                    {{this.couponCode}}
                                </div>
                            </td>
                            <td>
                                {{this.discountValue}}
                                {{#if (eq this.discountType "percentage")}}%{{else}}₹{{/if}}
                            </td>
                            <td>{{formatDate this.endDate}}</td>
                            <td>
                                <span class="status-badge {{#if this.isActive}}active{{else}}expired{{/if}}">
                                    {{#if this.isActive}}Active{{else}}Expired{{/if}}
                                </span>
                            </td>
                            <td class="action-buttons">
                                <button class="btn btn-sm btn-edit" data-coupon-id="{{this._id}}">
                                    <span class="icon">✏️</span> Edit
                                </button>
                                <button class="btn btn-sm btn-delete" data-coupon-id="{{this._id}}">
                                    <span class="icon">🗑️</span> Delete
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="empty-state">
    <!-- Shopping tag/ticket icon as SVG - matches the style from users/orders -->
    <svg class="empty-state-image" xmlns="http://www.w3.org/2000/svg" width="150" height="150" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
    </svg>
    <h2>No Coupons Found</h2>
    <p>There are currently no coupons in the system.</p>
    <a href="/admin/coupons" class="btn btn-primary">Refresh</a>
</div>
            {{/if}}

            {{#if (gt pagination.totalPages 1)}}
            <div class="pagination">
                {{#if pagination.hasPrevPage}}
                <a href="/admin/coupons/search?page={{pagination.prevPage}}{{#if query}}&query={{query}}{{/if}}"
                    class="pagination-button">
                    <i class="fas fa-chevron-left"></i> Previous
                </a>
                {{/if}}

                <span class="pagination-info">
                    Page {{pagination.page}} of {{pagination.totalPages}}
                </span>

                {{#if pagination.hasNextPage}}
                <a href="/admin/coupons/search?page={{pagination.nextPage}}{{#if query}}&query={{query}}{{/if}}"
                    class="pagination-button">
                    Next <i class="fas fa-chevron-right"></i>
                </a>
                {{/if}}
            </div>
            {{/if}}
        </div>

        <!-- Add Coupon Form (Initially hidden) -->
        <div id="addCouponOverlay" class="add-coupon-overlay">
            <div class="add-coupon-card">
                <div style="display:flex; justify-content:center" class="form-header">

                    <h1 class="page-title" id="couponModalTitle">Create New Coupon</h1>
                    <button id="closeFormBtn" class="btn btn-icon">
                        <i class="fas fa-times"></i>
                    </button>

                </div>
                <br><br>
                <form id="couponForm" method="post" action="/admin/coupon/addCoupon" novalidate>
                    <div class="form-columns">
                        <div class="form-group">
                            <label for="couponCode" class="form-label">Coupon Code</label>
                            <input type="text" name="couponCode" id="couponCode" maxlength="6" class="form-control"
                                placeholder="e.g. SUMMER20" required />
                            <div class="error-message" id="code-error"></div>
                        </div>

                        <div class="form-group">
                            <label for="discountType" class="form-label">Discount Type</label>
                            <select id="discountType" name="discountType" class="form-control" required>
                                <option value="" disabled selected>Select Type</option>
                                <option value="percentage">Percentage</option>
                                <option value="price">Fixed Amount</option>
                            </select>
                            <div class="error-message" id="type-error"></div>
                        </div>
                    </div>

                    <div class="form-columns">
                        <div class="form-group">
                            <label for="minimumPurchaseAmount" class="form-label">Minimum Purchase (₹)</label>
                            <input type="number" name="minimumPurchaseAmount" id="minimumPurchaseAmount"
                                class="form-control" placeholder="e.g. 500" required />
                            <div class="error-message" id="minPurchase-error"></div>
                        </div>

                        <div class="form-group">
                            <label for="discountValue" class="form-label">Discount Value</label>
                            <input type="number" name="discountValue" id="discountValue" class="form-control"
                                placeholder="e.g. 20" required />
                            <div class="error-message" id="value-error"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="endDate" class="form-label">Expiry Date</label>
                        <input type="date" name="endDate" id="endDate" class="form-control" required />
                        <div class="error-message" id="date-error"></div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btnForm btn-primary">
                            <span class="icon">💾</span>Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    {{!-- Edit Coupon Essential --}}
    <input type="hidden" id="editCouponId" value="">

    <!-- Notification Container -->
    <div id="notification-container"></div>

    <!-- Include jQuery and Select2 -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script src="/javascripts/admin/coupon.js" defer></script>
</body>