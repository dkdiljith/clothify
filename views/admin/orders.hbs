{{#section 'head'}}
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/orders.css" />
{{/section}}

<main class="dashboard-container">
    <div style="display:flex; justify-content:space-between;" class="orders-header">
        <h1 class="page-title">Order Management</h1>

        {{!-- serach --}}
        <form method="GET" action='/admin/orders' role="search">
            <div class="search-container">
                <input type="search" name="query" class="search-input" id="search-input" placeholder="Search orders..."
                    {{#if query}} value={{query}} {{/if}}>
            </div>
        </form>
    </div>

    {{#if order.length}}
    <div class="orders-table">
        <table>
            <thead>
                <tr>
                    <th></th>
                    <th>Order Number</th>
                    <th>Client</th>
                    <th>Order Date</th>
                    <th>Payment Status</th> {{!-- Added Column --}}
                    <th>Item Count</th>
                    <th>Total Amount</th>
                    <th>View Details</th>
                </tr>
            </thead>
            <tbody>

                {{#each order}}

                <tr class="{{#ifeq this.paymentStatus 'Failed'}}payment-failed-row{{/ifeq}}">

                    <td data-label="Sl No">
                        {{serialNumber ../pagination.serialNumberStart @index}}
                    </td>

                    <td>

                        <div class="order-info-cell">

                            <svg xmlns="http://w3.org" viewBox="0 0 512 512" width="100%" height="100%">
                                <!-- Definitions for clean strokes and reusable styles -->
                                <g fill="none" stroke="#2C3E50" stroke-width="16" stroke-linecap="round"
                                    stroke-linejoin="round">

                                    <!-- Inner Background / Box Depth -->
                                    <polygon points="170,180 256,135 342,180 256,225" fill="#A07845" />

                                    <!-- Back Flaps (Open) -->
                                    <!-- Left Back Flap -->
                                    <polygon points="170,180 90,140 180,110 256,135" fill="#F5C469" />
                                    <!-- Right Back Flap -->
                                    <polygon points="342,180 422,140 332,110 256,135" fill="#F5C469" />

                                    <!-- Main Box Body Front Faces -->
                                    <!-- Left Front Side -->
                                    <polygon points="120,240 256,310 256,430 120,360" fill="#F3B14E" />
                                    <!-- Right Front Side -->
                                    <polygon points="392,240 256,310 256,430 392,360" fill="#F3B14E" />

                                    <!-- Front Flaps (Dropped Open) -->
                                    <!-- Left Front Flap -->
                                    <polygon points="120,240 256,310 190,360 70,290" fill="#F5C469" />
                                    <!-- Right Front Flap -->
                                    <polygon points="392,240 256,310 322,360 442,290" fill="#F5C469" />

                                    <!-- Detail Line Accent on Left Side -->
                                    <line x1="150" y1="280" x2="150" y2="320" stroke="#2C3E50" stroke-width="14" />

                                </g>
                            </svg>


                            <div class="order-number-container">

                                #{{this.orderId}}

                                {{#if (hasReturnRequest this.items)}}

                                <span class="return-alert" title="Return Requested - Needs Attention">

                                    <svg class="action-icon warning-icon" xmlns="http://w3.org" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <line x1="12" y1="19" x2="12.01" y2="19"></line>
                                        <line x1="12" y1="5" x2="12" y2="14"></line>
                                    </svg>


                                </span>

                                {{/if}}

                                {{#ifeq this.paymentStatus 'Failed'}}

                                <span class="payment-alert" title="Payment Failed">

                                    <svg class="dashboard-icon finance-icon" xmlns="http://w3.org" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <!-- Hand Vector Structure -->
                                        <path d="M14 18H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"></path>
                                        <path d="M20 10l-4 4-2-2"></path>
                                        <!-- Currency / Dollar Symbol Structure -->
                                        <circle cx="12" cy="10" r="3"></circle>
                                        <path d="M12 8v4"></path>
                                    </svg>


                                </span>

                                {{/ifeq}}

                            </div>

                        </div>

                    </td>

                    <td data-label="Client">
                        {{this.deliveryAddress.name}}
                    </td>

                    <td data-label="Order Date">
                        {{formatDate this.createdAt}}
                    </td>

                    <td data-label="Payment Status">

                        <span class="status-badge status-{{toLowerCase this.paymentStatus}}">
                            {{this.paymentStatus}}
                        </span>

                    </td>

                    <td data-label="Item Count">

                        <span class="status status-success">
                            {{this.items.length}}
                        </span>

                    </td>

                    <td data-label="Total Amount">
                        ₹{{this.totalAmount}}
                    </td>

                    <td data-label="View Details">

                        <button onclick="location.href='/admin/orderDetails/{{this._id}}'" class="btn-primary">

                            View

                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>
        </table>
    </div>

    {{#if (gt pagination.totalPages 1)}}
    <div class="pagination">
        {{#if pagination.hasPrevPage}}
        <a href="/admin/orders?page={{pagination.prevPage}}{{#if query}}&query={{query}}{{/if}}"
            class="pagination-button">
            <svg class="pagination-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Previous
        </a>

        {{/if}}

        <span class="pagination-info">
            Page {{pagination.page}} of {{pagination.totalPages}}
        </span>

        {{#if pagination.hasNextPage}}
        <a href="/admin/orders?page={{pagination.nextPage}}{{#if query}}&query={{query}}{{/if}}"
            class="pagination-button">
            Next <svg class="pagination-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </a>
        {{/if}}
    </div>
    {{/if}}
    {{else}}
    <div class="empty-state">
        <!-- Inline SVG for "No orders found" -->
        <svg class="empty-state-image" xmlns="http://www.w3.org/2000/svg" width="150" height="150" fill="none"
            viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <h2>No Orders Found</h2>
        {{#unless query}} <p>There are currently no orders in the system.</p> {{/unless}}
        <a href="/admin/orders" class="btn btn-primary">Refresh</a>
    </div>
    {{/if}}
</main>

{{#section 'scripts'}}
<script src="/javascripts/admin/orders.js" defer></script>
{{/section}}