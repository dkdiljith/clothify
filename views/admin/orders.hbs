<head>
  <link
    rel="stylesheet"
    type="text/css"
    href="/stylesheets/admin/orders.css"
  />
</head>

<body>
   <main class="main-content">
        <div class="orders-header">
            <h1>Order Management</h1>
            {{!-- <button class="btn-primary">+ Add New Order</button> --}}
        </div>

        <div class="orders-table">
            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>No:Of Items</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each order}}
                    <tr>
                        <td>#{{this._id}}</td>
                        <td>{{this.deliveryAddress.name}}</td>
                        <td>{{formatDate this.createdAt}}</td>
                        <td><span class="status status-success">{{this.items.length}}</span></td>
                        <td>₹{{this.totalAmount}}</td>
                        <td><button onclick="location.href='/admin/orderDetails/{{this._id}}'" class="btn-primary">View</button></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </main>
  <script src="/javascripts/admin/orders.js" defer></script>
</body>