 <!-- Header -->
 <head>
  <link rel="stylesheet" type="text/css" href="/stylesheets/admin/dashboard.css">
  <script src="/javascripts/admin/admin-sidebar.js" defer></script>
</head>

            <!-- Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <h3 class="page-title " >Total Revenue</h3>
                    <div class="metric-value">$24,500</div>
                    <span class="text-success">↑ 12% from last month</span>
                </div>
                <div class="metric-card">
                    <h3 class="page-title " >Active Users</h3>
                    <div class="metric-value">1,234</div>
                    <span class="text-warning">↓ 3% from last week</span>
                </div>
                <div class="metric-card">
                    <h3 class="page-title " >Conversion Rate</h3>
                    <div class="metric-value">3.8%</div>
                    <span class="text-success">↑ 2.1% from yesterday</span>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="chart-container">
                <div class="chart-card">
                    <h3 class="page-title " >Sales Overview</h3>
                    <canvas id="salesChart"></canvas>
                </div>
                <div class="chart-card">
                    <h3 class="page-title " >Traffic Sources</h3>
                    <canvas id="trafficChart"></canvas>
                </div>
            </div>

          