<head>
    <link rel="stylesheet" type="text/css" href="/stylesheets/admin/offer.css">
    <script src="/javascripts/admin/admin-sidebar.js" defer></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .hidden {
            display: none !important;
        }
    </style>
</head>

<body>
    <div class="offer-management-layout">
        <!-- Offers List -->
        <div class="offers-list-container">

            <div class="offers-table-header">
                <h1 class="page-title">Offer Management</h1>

                <div style="display:flex;">
                    <form method="GET" action='/admin/offer/search' role="search">
                        <div class="search-container">
                            <input type="search" name="query" class="search-input" id="search-input"
                                placeholder="Search offers..." {{#if query}} value={{query}} {{/if}}>
                        </div>
                    </form>
                    <button id="toggleOfferForm" class="btn btn-primary" style="margin-left:15px;">
                        + Add Offer
                    </button>
                </div>
            </div>

            {{#if offer.length}}
            <div class="offers-table-wrapper">
                <table class="offers-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Offer Code</th>
                            <th>Offer Type</th>
                            <th>Discount</th>
                            <th>Discount Value</th>
                            <th>Validity</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each offer}}
                        <tr>
                            <td>{{incrementedIndex @index}}</td>
                            <td>
                                <div class="offer-code">
                                    <span class="offer-icon">🎁</span>
                                    {{this.offerCode}}
                                </div>
                            </td>
                            <td>{{capitalize this.offerType}}</td>
                            <td>{{capitalize this.discountType}}</td>
                            <td>
                                {{this.discountValue}}
                                {{#if (eq this.discountType "percentage")}}%{{else}}₹{{/if}}
                            </td>
                            <td>{{formatDate this.endDate}}</td>
                            <td>
                                <span class="status-badge {{#if this.isActive}}active{{else}}expired{{/if}}">
                                    {{#if this.isActive}}Active{{else}}Expired{{/if}}
                                </span>
                            </td>
                            <td class="action-buttons">
                                <button class="btn btn-sm btn-edit" onclick="location.href='/admin/offer/{{this._id}}'">
                                    <span class="icon">✏️</span> Edit
                                </button>
                                <button class="btn btn-sm btn-delete" data-offer-id="{{this._id}}">
                                    <span class="icon">🗑️</span> Delete
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{else}}
            <div class="empty-state">
                <!-- Offer/discount icon as SVG - consistent with your other pages -->
                <svg class="empty-state-image" xmlns="http://www.w3.org/2000/svg" width="150" height="150" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z" />
                </svg>
                <h2>No Offers Found</h2>
                <p>There are currently no active offers in the system.</p>
                <a href="/admin/offer" class="btn btn-primary">Refresh</a>
            </div>
            {{/if}}

             {{#if (gt pagination.totalPages 1)}}
            <div class="pagination">
                {{#if pagination.hasPrevPage}}
                <a href="/admin/offer/search?page={{pagination.prevPage}}{{#if query}}&query={{query}}{{/if}}"
                    class="pagination-button">
                    <i class="fas fa-chevron-left"></i> Previous
                </a>
                {{/if}}

                <span class="pagination-info">
                    Page {{pagination.page}} of {{pagination.totalPages}}
                </span>

                {{#if pagination.hasNextPage}}
                <a href="/admin/offer/search?page={{pagination.nextPage}}{{#if query}}&query={{query}}{{/if}}"
                    class="pagination-button">
                    Next <i class="fas fa-chevron-right"></i>
                </a>
                {{/if}}
            </div>
            {{/if}}

        </div>

        <!-- Add Offer Form (Initially hidden) -->
        <div id="addOfferOverlay" class="add-offer-overlay">
            <div class="add-offer-card">
                <div style="display:flex; justify-content:center" class="form-header">
                    <h1 class="page-title">Create New Offer</h1>
                    <button id="closeOfferFormBtn" class="btn btn-icon">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <br><br>
                <form id="offerForm" method="post" action="/admin/offer/addOffer" novalidate>
                    <div class="form-columns">
                        <div class="form-group">
                            <label for="offerCode" class="form-label">Offer Code</label>
                            <input type="text" name="offerCode" id="offerCode" maxlength="6" class="form-control"
                                placeholder="e.g. SUMMER20" required style="text-transform: uppercase;" />
                            <div class="error-message" id="code-error"></div>
                        </div>

                        <div class="form-group">
                            <label for="offerType" class="form-label">Offer Type</label>
                            <select id="offerType" name="offerType" class="form-control" required>
                                <option value="" disabled selected>Select Type</option>
                                <option value="category">Category wise</option>
                                <option value="subcategory">Subcategory wise</option>
                                <option value="product">Product wise</option>
                            </select>
                            <div class="error-message" id="type-error"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Target IDs</label>
                        <select id="categoryTargetIds" name="categoryTargetIds" class="form-control hidden" multiple
                            required>
                            <optgroup label="Categories">
                                {{#each categories}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </optgroup>
                        </select>

                        <select id="subcategoryTargetIds" name="subcategoryTargetIds" class="form-control hidden"
                            multiple required>
                            {{#each categories}}
                            <optgroup label="{{this.name}}">
                                {{#each this.subcategories}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                        </select>

                        <select id="productTargetIds" name="productTargetIds" class="form-control hidden" multiple
                            required>
                            <optgroup label="Products">
                                {{#each product}}
                                <option value="{{this._id}}">{{this.name}}</option>
                                {{/each}}
                            </optgroup>
                        </select>
                        <div class="error-message" id="target-error"></div>
                    </div>

                    <div class="form-columns">
                        <div class="form-group">
                            <label for="discountType" class="form-label">Discount Type</label>
                            <select id="discountType" name="discountType" class="form-control" required>
                                <option value="" disabled selected>Select Type</option>
                                <option value="percentage">Percentage</option>
                                <option value="price">Fixed Amount</option>
                            </select>
                            <div class="error-message" id="discount-type-error"></div>
                        </div>

                        <div class="form-group">
                            <label for="discountValue" class="form-label">Discount Value</label>
                            <input type="number" name="discountValue" id="discountValue" class="form-control"
                                placeholder="e.g. 20" required />
                            <div class="error-message" id="value-error"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="endDate" class="form-label">Expiry Date</label>
                        <input type="date" name="endDate" id="endDate" class="form-control" required />
                        <div class="error-message" id="date-error"></div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btnForm btn-primary">
                            <span class="icon">💾</span> Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Notification Container -->
    <div id="notification-container"></div>

    <!-- Include jQuery and Select2 -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script src="/javascripts/admin/offer.js"></script>
</body>