
  <link
    rel="stylesheet"
    type="text/css"
    href="/stylesheets/admin/register.css"
  />
</head>
 
 
  <body style="background-image: url('https://i.postimg.cc/vHqrfNP4/alesia-kazantceva-dh-D-Fi-Nkuzw-unsplash-photoutils-com.jpg'); background-size: cover;">
    
    <!-- Website logo in the top-left corner -->
    <img
      src="https://i.postimg.cc/VNqRKTHy/Clothify-logo-black.png"
      alt="Clothify Logo"
      class="website-logo"
    />
     <img
      src="https://i.postimg.cc/Vkc0K6y6/output-onlinepngtools-1.png"
      alt="Admin-logo"
      class="admin-logo"
    />
    <section class="d-flex justify-content-center align-items-center vh-100">
      <div class="container">
        <div class="row justify-content-end">
          <div class="col-md-6 col-lg-5">
            <div class="registration-card">
              <form id="registrationForm" method="post" action="/admin/register" novalidate>
                <h3 class="text-center">Add Admin</h3>
                <div class="form-group mb-4">
                  <i class="fas fa-user"></i>
                  <input
                    type="text"
                    name="name"
                    id="name"
                    class="form-control"
                    placeholder="Enter Your Full Name"
                    minlength="5"
                    maxlength="20"
                    data-required="true"
                  />
                  <small class="error-message" id="nameError"></small>
                </div>

                <!-- Phone -->
                <div class="form-group mb-4">
                  <i class="fas fa-phone"></i>
                  <input
                    type="tel"
                    name="phone"
                    id="phone"
                    class="form-control"
                    placeholder="Enter Your Phone Number"
                    minlength="10"
                    maxlength="13"
                    data-required="true"
                  />
                  <small class="error-message" id="phoneError"></small>
                </div>

                <!-- Email -->
                <div class="form-group mb-4">
                  <i class="fas fa-envelope"></i>
                  <input
                    name="email"
                    id="email"
                    class="form-control"
                    placeholder="Enter Your Email Address"
                    minlength="5"
                    maxlength="50"
                    data-required="true"
                  />
                  <small class="error-message" id="emailError"></small>
                </div>

                <!-- Password -->
                <div class="form-group mb-3">
                  <i class="fas fa-lock"></i>
                  <input
                    type="password"
                    name="password"
                    id="password"
                    class="form-control"
                    placeholder="Create Your Password"
                    minlength="8"
                    maxlength="20"
                    data-required="true"
                  />
                  <i
                    class="fas fa-eye-slash password-toggle"
                    id="togglePassword"
                  ></i>
                  <small class="error-message" id="passwordError"></small>
                </div>

                <div class="text-center text-lg-start mt-4 pt-2">
                  <button type="submit" class="btn btn-primary btn-lg w-100">
                    Sign up
                  </button>
                  <div class="custom-links d-flex justify-content-center mt-2">
                    <p class="small fw-bold mb-0">
                
                    </p>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </body>

