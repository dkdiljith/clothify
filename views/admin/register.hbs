{{#section 'head'}}
<link rel="stylesheet" type="text/css" href="/stylesheets/admin/register.css" />
{{/section}}


<div
  style="background-image: url('https://i.postimg.cc/vHqrfNP4/alesia-kazantceva-dh-D-Fi-Nkuzw-unsplash-photoutils-com.jpg'); background-size: cover;">

  <!-- Website logo in the top-left corner -->
  <img src="https://i.postimg.cc/VNqRKTHy/Clothify-logo-black.png" alt="Clothify Logo" class="website-logo" />
  <img src="https://i.postimg.cc/Vkc0K6y6/output-onlinepngtools-1.png" alt="Admin-logo" class="admin-logo" />
  <section class="d-flex justify-content-center align-items-center vh-100">
    <div class="container">
      <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5">
          <div class="registration-card">
            <form id="registrationForm" method="post" action="/admin/register" novalidate>
              <h3 class="text-center">Add Admin</h3>
              <div class="form-group mb-4">
                <svg class="form-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>

                <input type="text" name="name" id="name" class="form-control" placeholder="Enter Your Full Name"
                  minlength="5" maxlength="20" data-required="true" />
                <small class="error-message" id="nameError"></small>
              </div>

              <!-- Phone -->
              <div class="form-group mb-4">
                <svg class="form-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                  </path>
                </svg>

                <input type="tel" name="phone" id="phone" class="form-control" placeholder="Enter Your Phone Number"
                  minlength="10" maxlength="13" data-required="true" />
                <small class="error-message" id="phoneError"></small>
              </div>

              <!-- Email -->
              <div class="form-group mb-4">
                <svg class="form-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>

                <input name="email" id="email" class="form-control" placeholder="Enter Your Email Address" minlength="5"
                  maxlength="50" data-required="true" />
                <small class="error-message" id="emailError"></small>
              </div>

              <!-- Password -->
              <div class="form-group mb-3">
                <svg class="form-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>

                <input type="password" name="password" id="password" class="form-control"
                  placeholder="Create Your Password" minlength="8" maxlength="20" data-required="true" />
                <svg class="form-icon password-toggle" id="togglePassword" xmlns="http://w3.org" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24">
                  </path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>

                <small class="error-message" id="passwordError"></small>
              </div>

              <div class="text-center text-lg-start mt-4 pt-2">
                <button type="submit" class="btn btn-primary btn-lg w-100">
                  Sign up
                </button>
                <div class="custom-links d-flex justify-content-center mt-2">
                  <p class="small fw-bold mb-0">

                  </p>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>


  {{!-- {{#section 'scripts'}}
  <script src="/javascripts/admin/login.js" defer></script>
  {{/section}} --}}