<link rel="stylesheet" type="text/css" href="/stylesheets/admin/admin-sidebar.css" />

<div class="sidebar-container">
  <!-- Sidebar -->
  <aside class="sidebar">

    <div style="background-color: var(--background); border-radius: 15px; padding: 18px 0px 18px 10px; ">
      <h2 class="page-title" style="font-weight: 1000; margin-bottom:0.07em; padding-right:15px; ">CLOTHIFY</h2>
    </div>

    <nav>
      <div onclick="location.href='/admin/dashboard'" class="nav-item bar-title">📊 Dashboard</div>
      <div onclick="location.href='/admin/salesReport'" class="nav-item bar-title">📈 Sales Report</div>
      <div onclick="location.href='/admin/products'" class="nav-item bar-title">📦 Products</div>
      <div onclick="location.href='/admin/orders'" class="nav-item bar-title">💵 Orders</div>
      <div onclick="location.href='/admin/users'" class="nav-item bar-title">👥 Users</div>
      <div onclick="location.href='/admin/category'" class="nav-item bar-title">📂 Categories</div>
      <div onclick="location.href='/admin/coupons'" class="nav-item bar-title">🏷️ Coupons</div>
      <div onclick="location.href='/admin/offer'" class="nav-item bar-title">🛒 Offers</div>
      <div onclick="location.href='/admin/activity-log'" class="nav-item bar-title">💻 Activity-Log</div>
      <div onclick="location.href='/admin/settings'" class="nav-item bar-title">🛠️ Settings</div>
    </nav>
  </aside>


  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Main Content -->
  <main style="margin-top:-7px;" class="main-content">

    {{> admin-header}}

    <!-- Header -->
    <div class="dashboard-header">
      <h1 class="page-title" style="margin-bottom:3px; margin-left:10px;">
        Hi {{#if admin.name}}{{admin.name}}{{else}}Admin{{/if}}!
      </h1>
      <div class="header-controls">
        <button class="theme-btn theme-toggle-btn">
          🌓 Dark Mode
        </button>
        <button onclick="location.href='/admin/register'" class="theme-btn">👥
          Add New Admin</button>
        <button onclick="location.href='/admin/logout'" class="theme-btn">🚪 Logout</button>
      </div>
    </div>

    {{#if isSettings}}

    {{> admin-settings-sidebar}}

    {{else}}

    {{{body}}}

    {{/if}}

  </main>
</div>