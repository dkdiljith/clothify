<link rel="stylesheet" type="text/css" href="/stylesheets/user/user-sidebar.css">
<script src="/javascripts/user/user-sidebar.js"></script>



<div class="container" style="margin-top:20px;">
    <div class="profile-header"></div>
    <div class="profile-container">
        <div class="profile-sidebar">
            <ul id="user-sidebar-menu">
                <li data-match="profile" onclick="location.href='/user/profile'">
                    <i class="fas fa-user"></i> Profile
                </li>
                <li data-match="security" onclick="location.href='/user/security'">
                    <i class="fas fa-lock"></i> Security & Password
                </li>
                <li data-match="wallet" onclick="location.href='/user/wallet'">
                    <i class="fas fa-wallet"></i> Wallet
                </li>
                <!-- Fixed data-match attribute from "wallet" to "referral" below -->
                <li data-match="referral" onclick="location.href='/user/referral'">
                    <i class="fas fa-gift"></i> Referral
                </li>
                <li data-match="orders-regular" onclick="location.href='/user/orders'">
                    <i class="fas fa-shopping-bag"></i> Orders
                </li>
                <li data-match="orders-pending" onclick="location.href='/user/orders?retryPendingOrder=true'">
                    <i class="fas fa-shopping-bag"></i> Pending Orders
                </li>
                <li data-match="address" onclick="location.href='/user/address'">
                    <i class="fas fa-map-marker-alt"></i> Addresses
                </li>
                <li data-match="deleteuser" onclick="location.href='/user/deleteuser'">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </li>
            </ul>
        </div>
        <div class="profile-content">
            {{{body}}}
        </div>
    </div>
</div>