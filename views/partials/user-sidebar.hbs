<style>
    :root {
        --primary-color: #2c3e50;
        --secondary-color: #3498db;
        --accent-color: #e74c3c;
        --success-color: #2ecc71;
        --light-gray: #f8f9fa;
        --medium-gray: #e0e0e0;
        --dark-gray: #333;
        --white: #ffffff;
        --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
        color: var(--dark-gray);
        background-color: var(--light-gray);
        line-height: 1.6;
    }


    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--medium-gray);
    }

    .profile-title {
        font-size: 28px;
        font-weight: 600;
        color: var(--primary-color);
        margin: 0;
    }

    .profile-container {
        display: flex;
        gap: 30px;
        background-color: var(--white);
        border-radius: 8px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .profile-sidebar {
        width: 250px;
        background-color: #f8f9fa;
        padding: 25px 0;
    }

    .profile-sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .profile-sidebar li {
        padding: 12px 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        border-left: 3px solid transparent;
    }

    .profile-sidebar li:hover {
        background-color: rgba(52, 152, 219, 0.1);
        color: var(--secondary-color);
    }

    .profile-sidebar li.active {
        background-color: rgba(52, 152, 219, 0.1);
        border-left: 3px solid var(--secondary-color);
        color: var(--secondary-color);
        font-weight: 500;
    }

    .profile-sidebar li i {
        width: 20px;
        text-align: center;
    }

    .profile-content {
        flex: 1;
        padding: 30px;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .profile-container {
            flex-direction: column;
        }

        .profile-sidebar {
            width: 100%;
            padding: 15px 0;
        }

        .profile-sidebar ul {
            display: flex;
            overflow-x: auto;
            padding: 0 15px;
        }

        .profile-sidebar li {
            white-space: nowrap;
            border-left: none;
            border-bottom: 3px solid transparent;
            padding: 10px 15px;
        }

        .profile-sidebar li.active {
            border-left: none;
            border-bottom: 3px solid var(--secondary-color);
        }

        .profile-header-section {
            flex-direction: column;
            text-align: center;
        }

        .profile-stats {
            justify-content: center;
        }
    }

    @media (max-width: 768px) {
        .profile-details-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .detail-label {
            padding-bottom: 0;
        }

        .profile-actions {
            flex-direction: column;
        }
    }

    @media (max-width: 576px) {
        .profile-stats {
            flex-wrap: wrap;
            justify-content: flex-start;
        }
    }
</style>
</head>

<body>
    <div class="container">
        <div class="profile-header">
        </div>

        <div class="profile-container">
            <div class="profile-sidebar">
                <ul>
                    <li class="active" onclick="location.href='/user/profile'">
                        <i class="fas fa-user"></i> Profile
                    </li>
                    <li onclick="location.href='/user/security'">
                        <i class="fas fa-lock"></i> Security & Password
                    </li>
                    <li onclick="location.href='/user/wallet'">
                        <i class="fas fa-wallet"></i> Wallet
                    </li>
                    <li onclick="location.href='/user/orders'">
                        <i class="fas fa-shopping-bag"></i> Orders
                    </li>
                    <li onclick="location.href='/user/address'">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </li>
                    <li onclick="location.href='/user/deleteuser'">
                        <i class="fas fa-trash-alt"></i> Delete Account
                    </li>
                </ul>
            </div>

            <div class="profile-content">

                {{body}}

            </div>
        </div>
    </div>