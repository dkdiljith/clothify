<link rel="stylesheet" type="text/css" href="/stylesheets/user/user-header.css">


<!-- USER HEADER -->
<header class="user-header">
    <div class="user-header-desktop">
        <nav class="user-header-container container" role="navigation">
            <!-- LEFT -->
            <div style="
                    display: flex;
                    align-items: center;
                    gap: 14px;
                ">
                <!-- MOBILE TOGGLE -->
                <button type="button" class="user-header-mobile-toggle" id="userHeaderMobileToggle"
                    aria-label="Open Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <!-- LOGO -->
                <a href="/user/home" class="user-header-logo" aria-label="Go to homepage">
                    <img src="/images/icons/logo-01.png" alt="Website Logo">
                </a>
            </div>
            <!-- MENU -->
            <div class="user-header-menu-wrapper">
                <ul class="user-header-menu">
                    <li class="user-header-menu-item {{#if homeActive}}active-menu{{/if}}">
                        <a href="/user/home" class="user-header-menu-link">
                            Home
                        </a>
                    </li>
                    <li class="user-header-menu-item {{#if collectionsActive}}active-menu{{/if}}">
                        <a href="/user/collections" class="user-header-menu-link">
                            Collections
                        </a>
                    </li>
                </ul>
            </div>
            <!-- RIGHT SIDE -->
            <div class="user-header-right">
                <!-- SEARCH -->
                <form method="GET" action="/user/collections" role="search" class="user-header-search-form">
                    <div class="user-header-search">
                        <input type="search" name="query" class="user-header-search-input"
                            placeholder="Search products..." autocomplete="off" {{#if query}}value="{{query}}" {{/if}}>
                        <button type="submit" class="user-header-search-btn" aria-label="Search">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </form>
                <!-- ICONS -->
                <div class="user-header-icons">
                    {{#if user}}
                    {{#if user.blocked}}
                    <!-- ========================================== -->
                    <!--  LOGGED IN BUT BLOCKED USER      -->
                    <!-- ========================================== -->
                    <div class="user-header-login-wrapper">
                        <a href="/user/logout" class="user-header-login-btn" aria-label="Login">
                            <i class="fa fa-sign-in-alt"></i> <span>Login</span>
                        </a>
                    </div>
                    {{else}}
                    <!-- ========================================== -->
                    <!--  LOGGED IN AND ACTIVE USER      -->
                    <!-- ========================================== -->

                    <!-- WISHLIST -->
                    <a href="/user/wishlist" class="user-header-icon" aria-label="Wishlist">
                        <i class="fa fa-heart"></i>
                        <span class="user-header-badge wishlist-badge"
                            style="display: {{#if user.wishlistCount}}flex{{else}}none{{/if}};">
                            {{user.wishlistCount}}
                        </span>
                    </a>

                    <!-- CART -->
                    <a href="/user/cart" class="user-header-icon" aria-label="Shopping Cart">
                        <i class="fa fa-shopping-cart"></i>
                        <span class="user-header-badge cart-badge"
                            style="display: {{#if user.cartCount}}flex{{else}}none{{/if}};">
                            {{user.cartCount}}
                        </span>
                    </a>

                    <!-- PROFILE -->
                    <div class="user-header-profile">
                        <button type="button" class="user-header-icon" id="userHeaderDropdownButton"
                            aria-label="User Profile" aria-expanded="false">
                            <i class="fa fa-user"></i>
                        </button>
                        <!-- DROPDOWN -->
                        <div id="userHeaderDropdown" class="user-header-dropdown">
                            <a href="/user/profile" class="user-header-dropdown-link"> <i class="fa fa-user-circle"></i>
                                <span>Profile</span> </a>
                            <a href="/user/orders" class="user-header-dropdown-link"> <i class="fa fa-shopping-bag"></i>
                                <span>Orders</span> </a>
                            <a href="/user/wallet" class="user-header-dropdown-link"> <i class="fa fa-wallet"></i>
                                <span>Wallet</span> </a>
                            <a href="/user/logout" class="user-header-dropdown-link user-header-logout"> <i
                                    class="fa fa-sign-out"></i> <span>Logout</span> </a>
                        </div>
                    </div>
                    {{/if}}

                    {{else}}
                    <!-- ========================================== -->
                    <!--  PURE GUEST / LOGGED OUT VISITOR -->
                    <!-- ========================================== -->
                    <div class="user-header-login-wrapper">
                        <a href="/user/login" class="user-header-login-btn" aria-label="Login">
                            <i class="fa fa-sign-in-alt"></i> <span>Login</span>
                        </a>
                    </div>
                    {{/if}}
                </div>

            </div>
        </nav>
    </div>
</header>
<!-- MOBILE MENU -->
<div class="user-mobile-menu" id="userMobileMenu">
    <div class="user-mobile-menu-header">
        <img src="/images/icons/logo-01.png" alt="Logo">
        <button type="button" class="user-mobile-close" id="userMobileClose" aria-label="Close Menu">
            <i class="fa fa-times"></i>
        </button>
    </div>
    <div class="user-mobile-menu-links">
        <!-- MOBILE SEARCH -->
        <form method="GET" action="/user/collections" class="user-mobile-search-form">
            <div class="user-mobile-search">
                <input type="search" name="query" placeholder="Search products..." autocomplete="off">
                <button type="submit">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
        <a href="/user/home">
            Home
        </a>
        <a href="/user/collections">
            Collections
        </a>
        {{#if user}}
        {{#if user.blocked}}
        <!--  LOGGED IN BUT BLOCKED USER -->
        <a href="/user/logout" class="mobile-logout"> Login </a>
        {{else}}
        <!--  LOGGED IN AND ACTIVE USER -->
        <a href="/user/profile"> Profile </a>
        <a href="/user/orders"> Orders </a>
        <a href="/user/wallet"> Wallet </a>
        <a href="/user/wishlist"> Wishlist </a>
        <a href="/user/cart"> Cart </a>
        <a href="/user/logout" class="mobile-logout"> Logout </a>
        {{/if}}
        {{else}}
        <!--  PURE GUEST VISITOR -->
        <a href="/user/login" class="mobile-logout"> Login </a>
        {{/if}}
    </div>
</div>
<!-- MOBILE OVERLAY -->
<div class="user-mobile-overlay" id="userMobileOverlay"></div>



<script src="/javascripts/user/user-header.js" defer></script>