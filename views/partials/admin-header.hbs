<link rel="stylesheet" type="text/css" href="/stylesheets/admin/admin-header.css" />

<!-- ADMIN HEADER -->
<header class="admin-header">

    <!-- LEFT -->
    <div class="admin-header-left">

        <!-- MOBILE SIDEBAR TOGGLE -->
        <button type="button" class="admin-sidebar-toggle" id="adminSidebarToggle" aria-label="Open Sidebar">
            <!-- Lightweight Menu Bars Icon -->
            <svg class="header-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <!-- PAGE TITLE -->
        <div class="admin-header-title-wrapper">
            <h1 class="admin-header-title">
                Hi {{#if admin.name}}{{admin.name}}{{else}}Admin{{/if}}!
            </h1>
        </div>

    </div>

    <!-- RIGHT -->
    <div class="admin-header-controls">

        <!-- THEME -->
        <button class="admin-header-btn theme-toggle-btn">
            <!-- Lightweight Moon Icon -->
            <svg class="header-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span>Theme</span>
        </button>

        <!-- ADD ADMIN -->
        <button onclick="location.href='/admin/register'" class="admin-header-btn">
            <!-- Lightweight User Plus Icon -->
            <svg class="header-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="17" y1="11" x2="23" y2="11"></line>
            </svg>
            <span>Add Admin</span>
        </button>

        <!-- LOGOUT -->
        <button onclick="location.href='/admin/logout'" class="admin-header-btn admin-logout-btn">
            <!-- Lightweight Log Out Icon -->
            <svg class="header-icon" xmlns="http://w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Logout</span>
        </button>

    </div>

</header>
