<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <!-- Dark Mode Theme Initializer -->
    <script>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>

    {{!-- page individual headers --}}
    {{{_sections.head}}}

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Utilities -->
    <link rel="stylesheet" href="/stylesheets/utils/popUpMessage.css">
    <link rel="stylesheet" href="/stylesheets/utils/alert.css">

</head>

<body>

    {{#if plain_body}}

    {{{body}}}

    {{else}}

    {{> admin-sidebar isSettings=isSettings}}

    {{/if}}

    <!-- Utilities -->
    <script src="/javascripts/utils/constants.js" defer></script>
    <script src="/javascripts/utils/popUpMessage.js" defer></script>
    <script src="/javascripts/utils/alert.js" defer></script>

    <!-- Admin Theme Engine -->
    <script src="/javascripts/admin/admin-theme-toggle.js" defer></script>

    {{!-- page individual scripts --}}
    {{{_sections.scripts}}}

</body>

</html>