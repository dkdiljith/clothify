<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>

  {{!-- page individual headers --}}
  {{{_sections.head}}}

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Global Shared Stylesheets -->
  <link rel="stylesheet" href="/stylesheets/user/generalStyles.css">
  <link rel="stylesheet" href="/stylesheets/utils/popUpMessage.css">
  <link rel="stylesheet" href="/stylesheets/utils/alert.css">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

  {{#if plain_body}}
  {{{body}}}
  {{else}}
  {{> user-header}}

  {{#if user_sidebar}}
  {{> user-sidebar}}
  {{else}}
  {{{body}}}
  {{/if}}

  {{> user-footer}}
  {{/if}}


  <!-- Local Scripts -->
  <script src="/javascripts/utils/constants.js" defer></script>
  <script src="/javascripts/utils/popUpMessage.js" defer></script>
  <script src="/javascripts/utils/alert.js" defer></script>
  <script src="/javascripts/utils/dataIcon.js" defer></script>

  {{!-- page individual scripts --}}
  {{{_sections.scripts}}}

</body>

</html>