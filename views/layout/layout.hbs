<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>

  {{!-- page individual headers --}}
  {{{_sections.head}}}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">

  <!-- Google Font -->
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Global Shared Stylesheets -->
  <link rel="stylesheet" href="/stylesheets/user/generalStyles.css">
  <link rel="stylesheet" href="/stylesheets/user/productCard.css">
  <link rel="stylesheet" href="/stylesheets/utils/popUpMessage.css">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

  {{#if plain_body}}
  {{{body}}}
  {{else}}
  {{> user-header}}

  {{#if user_sidebar}}
  {{> user-sidebar}}
  {{else}}
  {{{body}}}
  {{/if}}

  {{> user-footer}}
  {{/if}}



  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- Razorpay -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


  <!-- coupon alert system -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Local Scripts -->
  <script src="/javascripts/utils/popUpMessage.js" defer></script>
  <script src="/javascripts/utils/constants.js" defer></script>


  {{!-- page individual scripts --}}
  {{{_sections.scripts}}}

</body>

</html>