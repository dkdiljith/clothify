<!DOCTYPE html>
<html lang="en">

<head>
  <title>Home</title>
  <meta charset="UTF-8">
  <title>{{title}}</title>

  {{!-- icons-mail,password,etc --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  {{! bootstrap }}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  
  {{!-- popupmessages --}}
  <link rel="stylesheet" type="text/css" href="/stylesheets/utils/popUpMessage.css">

</head>



<body>

  {{#unless isAdminLogin}}
  {{#if admin }}
  {{> admin-sidebar}}
  {{else}}
  {{#unless no_user_header}}
  {{> user-header}}
  {{/unless}}
  {{/if}}
  {{/unless}}

  {{#unless admin}}
  {{{body}}}
  {{/unless}}

  {{#unless isAdminLogin}}
  {{#if admin}}
  {{> admin-footer}}
  {{else}}
  {{> user-footer}}
  {{/if}}
  {{/unless}}



  {{!-- ==========BootStrap Modal========== --}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{!-- pop up message --}}
  <script src="/javascripts/utils/popUpMessage.js"></script>
  {{!-- message constants --}}
  <script src="/javascripts/utils/constants.js"></script>


</body>

</html>